	|		КОГДА Спр.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСФСГС)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФСГС)
	|		ИНАЧЕ 
	|			ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПустаяСсылка)
	|	КОНЕЦ КонтролирующийОрган
	|
	|ИЗ Справочник.ПерепискаСКонтролирующимиОрганами КАК Спр
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВложенияНеформализованныхДокументов КАК Регистр
	|		ПО (Спр.Ссылка = Регистр.НеформализованныйДокумент)
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦиклыОбмена КАК ЦО
	|		ПО (Спр.Ссылка = ЦО.Предмет)
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
	|			ПО 		(СостояниеОбъектов.Объект = Регистр.НеформализованныйДокумент)
	|				И	(СостояниеОбъектов.ИмяФайла = Регистр.ИмяФайла)
	|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ВложенияНеформализованныхДокументов))
	|
	|ГДЕ
	|	(&НачПериода = ДатаВремя(1,1,1) Или Спр.ДатаСообщения >= &НачПериода) И 
	|	(&КонПериода = ДатаВремя(1,1,1) Или Спр.ДатаСообщения <= &КонПериода) И
	|	(&НеИспользоватьОтборОрганизации Или Спр.Организация В (&ОтобратьОрганизации))
	|
	|	И (&НеИспользоватьОтборПоКонтролирующемуОргану Или 
	|	ВЫБОР
	|		КОГДА Спр.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСФНС)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)
	|		КОГДА Спр.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСПФР)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПФР)
	|		КОГДА Спр.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПерепискиСКонтролирующимиОрганами.ПерепискаСФСГС)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФСГС)
	|		ИНАЧЕ 
	|			ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПустаяСсылка)
	|	КОНЕЦ В (&ОтобратьКонтролирующиеОрганы))
	|
	|	И (&НеИспользоватьОтборПоВидамОбъектов Или (
	|		ВЫБОР
	|			КОГДА 
	|				ЦО.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыЦикловОбмена.Рассылка) Или ЦО.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыЦикловОбмена.РассылкаГрупповая)
	|				" + ?(ЕстьРассылкаПФР, "Или ЦО.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыЦикловОбмена.РассылкаПФР)", "") + "
	|			ТОГДА	""%%ID10""
	|		ИНАЧЕ
	|			""%%ID09""
	|		КОНЕЦ
	|	) В (&ОтобратьВидыОбъектов))
	|	И НЕ Регистр.НеформализованныйДокумент ЕСТЬ NULL
	|";
	
	Если ДляАрхивации Тогда 
		ТекстЗапроса = ТекстЗапроса + "	И (СостояниеОбъектов.Архивный ЕСТЬ NULL Или Не СостояниеОбъектов.Архивный)"; //Не Архивный
	Иначе
		ТекстЗапроса = ТекстЗапроса + "	И (Не (СостояниеОбъектов.Архивный ЕСТЬ NULL) И СостояниеОбъектов.Архивный)"; //Архивный
	КонецЕсли;
	
	ЗаменитьПодстановочныеСимволыВТекстеЗапроса(ТекстЗапроса);
	
	Возврат ТекстЗапроса;	
	
КонецФункции

