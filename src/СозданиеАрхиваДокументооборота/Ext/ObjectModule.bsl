//Для изменения группировки по виду необходимо указать ID и NAME существующей группы либо добавить новые ID и NAME и заменить их для нужных подстановочных символов
Функция ГруппировкиОбъектовДО()
		
	Группы = Новый Соответствие;
	
	Названия = Новый Массив;
	Названия.Добавить("Отправки отчетов");	// 0
	Названия.Добавить("Сверки, выписки");	// 1
	Названия.Добавить("Письма");			// 2
	Названия.Добавить("Рассылки");			// 3
	Названия.Добавить("Требования");		// 4
	
	//Справочник.ОтправкиРПН
	Группы.Вставить("%%ID00", 0);
	Группы.Вставить("%%NAME00", Названия[0]);
	
	//Справочник.ОтправкиФСРАР
	Группы.Вставить("%%ID01", 0);
	Группы.Вставить("%%NAME01", Названия[0]);
	
	//Справочник.ОтправкиФСС
	Группы.Вставить("%%ID02", 0);
	Группы.Вставить("%%NAME02", Названия[0]);
	
	//Справочник.ОтправкиФТС
	Группы.Вставить("%%ID03", 0);
	Группы.Вставить("%%NAME03", Названия[0]);
	
	//Справочник.ОтправкиБанкРоссии
	Группы.Вставить("%%ID04", 0);
	Группы.Вставить("%%NAME04", Названия[0]);
	
	//РегистрСведений.ОтветыНаЗапросыВыпискиИзЕГРЮЛ_ЕГРИП
	Группы.Вставить("%%ID05", 1);
	Группы.Вставить("%%NAME05", Названия[1]);
	
	//РегистрСведений.ОтветыНаЗапросыИОН
	Группы.Вставить("%%ID06", 1);
	Группы.Вставить("%%NAME06", Названия[1]);
	
	//РегистрСведений.ОтветыНаЗапросыИОС
	Группы.Вставить("%%ID07", 1);
	Группы.Вставить("%%NAME07", Названия[1]);
	
	//РегистрСведений.ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов
	Группы.Вставить("%%ID08", 0);
	Группы.Вставить("%%NAME08", Названия[0]);
	
	//РегистрСведений.ВложенияНеформализованныхДокументов > Справочник.ПерепискаСКонтролирующимиОрганами > Справочник.ЦиклыОбмена
	//ЦиклОбмена.Тип != Рассылка | РассылкаГрупповая	
	Группы.Вставить("%%ID09", 2);
	Группы.Вставить("%%NAME09", Названия[2]);
	
	//РегистрСведений.ВложенияНеформализованныхДокументов > Справочник.ПерепискаСКонтролирующимиОрганами > Справочник.ЦиклыОбмена
	//ЦиклОбмена.Тип = Рассылка | РассылкаГрупповая
	Группы.Вставить("%%ID10", 3);
	Группы.Вставить("%%NAME10", Названия[3]);
	
	//РегистрСведений.ФайлыДокументовРеализацииПолномочийНалоговыхОрганов
	Группы.Вставить("%%ID11", 4);
	Группы.Вставить("%%NAME11", Названия[4]);
	
	Группы.Вставить("%%ID12", 0);
	Группы.Вставить("%%NAME12", Названия[0]);
	
	//Должно быть последним вариантом. Группа для тех объектов, которые не удалось категоризировать
	Названия.Добавить("Прочее");	
	Группы.Вставить("%%ID99", 99);
	Группы.Вставить("%%NAME99", Названия[Названия.Количество()-1]);
	
	Названия.Очистить();
	Возврат Группы;
	
КонецФункции

Функция Тип2(ТипТекстом) Экспорт
	
	ВидОбъекта = Неопределено;
	Имя = Сред(ТипТекстом, Найти(ТипТекстом, ".") + 1);
	
	Если СтрНайти(ТипТекстом, "ДокументСсылка.") > 0 Тогда
		ВидОбъекта = Метаданные.Документы.Найти(Имя);
	ИначеЕсли СтрНайти(ТипТекстом, "СправочникСсылка.") > 0 Тогда 
		ВидОбъекта = Метаданные.Справочники.Найти(Имя);		
	КонецЕсли;
	
	Если ВидОбъекта = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйТип = Тип(ТипТекстом);
	
	Возврат НовыйТип;
	
КонецФункции

Функция ТипВЗапрос(ТипТекстом) Экспорт
	
	ВидОбъекта = Неопределено;
	Имя = Сред(ТипТекстом, Найти(ТипТекстом, ".") + 1);
	
	Если СтрНайти(ТипТекстом, "Документ.") > 0 Тогда
		ВидОбъекта = Метаданные.Документы.Найти(Имя);
	ИначеЕсли СтрНайти(ТипТекстом, "Справочник.") > 0 Тогда 
		ВидОбъекта = Метаданные.Справочники.Найти(Имя);		
	КонецЕсли;
	
	Если ВидОбъекта = Неопределено Тогда 
		Возврат "ТИПЗНАЧЕНИЯ(Неопределено)";
	КонецЕсли;
	
	Возврат "ТИП(" + ТипТекстом + ")";
	
КонецФункции

Процедура ЗаменитьПодстановочныеСимволыВТекстеЗапроса(ТекстЗапроса)
	
	Группы = ГруппировкиОбъектовДО();
	
	Для Сч = 0 по 99 Цикл 
		СчФмт = Формат(Сч, "ЧЦ=2; ЧДЦ=; ЧН=; ЧВН=");
		Если Группы.Получить("%%ID" + СчФмт) = Неопределено Тогда 
			Прервать;
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """%%ID" + СчФмт + """", Строка(Группы["%%ID" + СчФмт]) ); //IDшники как число
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ID" + СчФмт, Строка(Группы["%%ID" + СчФмт]) ); 
		//ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%NAME" + СчФмт, Группы["%%NAME" + СчФмт]);
	КонецЦикла;	
	
КонецПроцедуры

