//+++
Функция ТекстЗапроса_ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП(Знач ДляАрхивации = Истина) Экспорт
	
	ТекстЗапроса = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ	
	|	""%%ID05"" ИдентификаторГруппы,
	|	Док.Ссылка,
	|	Док.Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС) КонтролирующийОрган
	|ИЗ 
	|	Документ.ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП КАК Док
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветыНаЗапросыВыпискиИзЕГРЮЛ_ЕГРИП КАК Регистр
	|		ПО (Док.Ссылка = Регистр.Запрос)
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
	|			ПО 		(СостояниеОбъектов.Объект = Регистр.Запрос)
	|				И	(СостояниеОбъектов.ИмяФайла = Регистр.ИмяФайла)
	|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.ОтветыНаЗапросыВыпискиИзЕГРЮЛ_ЕГРИП))
	|
	|ГДЕ
	|	(&НачПериода = ДатаВремя(1,1,1) Или Док.Дата >= &НачПериода) И 
	|	(&КонПериода = ДатаВремя(1,1,1) Или Док.Дата <= &КонПериода) И
	|	(&НеИспользоватьОтборОрганизации Или Док.Организация В (&ОтобратьОрганизации))
	|	И (&НеИспользоватьОтборПоКонтролирующемуОргану Или ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС) В (&ОтобратьКонтролирующиеОрганы))
	|	И (&НеИспользоватьОтборПоВидамОбъектов Или ""%%ID05"" В (&ОтобратьВидыОбъектов))
	|	И НЕ Регистр.Запрос ЕСТЬ NULL
	|";
	
	Если ДляАрхивации Тогда 
		ТекстЗапроса = ТекстЗапроса + "	И (СостояниеОбъектов.Архивный ЕСТЬ NULL Или Не СостояниеОбъектов.Архивный)"; //Не Архивный
	Иначе
		ТекстЗапроса = ТекстЗапроса + "	И (Не (СостояниеОбъектов.Архивный ЕСТЬ NULL) И СостояниеОбъектов.Архивный)"; //Архивный
