	|			Или ТИПЗНАЧЕНИЯ(ЦО.Предмет) = " + ТипВЗапрос("Документ.УдалитьСведенияОЗастрахованныхЛицахСЗВ_М") + "
	|			Или ТИПЗНАЧЕНИЯ(ЦО.Предмет) = " + ТипВЗапрос("Документ.УдалитьСведенияОНачисленномЗаработкеСЗВ63") + "
	|			Или ТИПЗНАЧЕНИЯ(ЦО.Предмет) = " + ТипВЗапрос("Документ.УдалитьСведенияОСтраховомСтажеЗастрахованныхЛицСЗВ_СТАЖ") + "
	|			Или ТИПЗНАЧЕНИЯ(ЦО.Предмет) = " + ТипВЗапрос("Документ.УдалитьСправкаПоНДФЛВНалоговыйОрган") + "
	|			Или ТИПЗНАЧЕНИЯ(ЦО.Предмет) = " + ТипВЗапрос("Документ.УдалитьСправкаПоНДФЛВНалоговыйОрганС2015") + "
	|			Или ТИПЗНАЧЕНИЯ(ЦО.Предмет) = " + ТипВЗапрос("Документ.ВедомостьУплатыАДВ_11") + " ТОГДА ""%%ID12""
	|		ИНАЧЕ
	|			""%%ID99""
	|КОНЕЦ %%ANAME";
	
КонецФункции

//+++
Функция ТекстЗапроса_СодержимоеТранспортныхКонтейнеров(Знач ДляАрхивации = Истина) Экспорт
	
	ТекстЗапроса = 
	
	"//%%00
	|//////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	//%%02,
	|	Док.Ссылка
	|	,	ВЫБОР КОГДА ТипыТС.КонтролирующийОрган = ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПустаяСсылка) ТОГДА
	|			ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(ЦО.ВнешняяОрганизация) = ТИП(Справочник.НалоговыеОрганы) ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)
	|				КОГДА ТИПЗНАЧЕНИЯ(ЦО.ВнешняяОрганизация) = ТИП(Справочник.ОрганыПФР) ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПФР)
	|				КОГДА ТИПЗНАЧЕНИЯ(ЦО.ВнешняяОрганизация) = ТИП(Справочник.ОрганыФСГС) ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФСГС)
	|				ИНАЧЕ
	|					ТипыТС.КонтролирующийОрган
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ТипыТС.КонтролирующийОрган
	|		КОНЕЦ КонтролирующийОрган
	|	, ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Док.Отправитель) = ТИП(Справочник.Организации) ТОГДА Док.Отправитель
	|		КОГДА ТИПЗНАЧЕНИЯ(Док.Получатель) = ТИП(Справочник.Организации) ТОГДА Док.Получатель
	|	ИНАЧЕ
	|		ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	КОНЕЦ Организация
	|ИЗ
	|	Документ.ТранспортноеСообщение КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТипыТСиКонтролирующийОрган КАК ТипыТС
	|			ПО (Док.Тип = ТипыТС.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СодержимоеТранспортныхКонтейнеров КАК СодержимоеТК 
	|			ПО	Док.Ссылка = СодержимоеТК.ТранспортноеСообщение
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦиклыОбмена КАК ЦО
	|			ПО (Док.ЦиклОбмена = ЦО.Ссылка)
	|	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами КАК СостояниеОбъектов
	|			ПО 		(СостояниеОбъектов.Объект = СодержимоеТК.ТранспортноеСообщение)
	|				И	(СостояниеОбъектов.ИмяФайла = СодержимоеТК.ИмяФайла)
	|				И	(СостояниеОбъектов.Владелец = Значение(Перечисление.ВидыАрхивируемыхМетаданныхДО.СодержимоеТранспортныхКонтейнеров))
	|
	|ГДЕ
	|	(&НачПериода = ДатаВремя(1,1,1) Или Док.Дата >= &НачПериода) И 
	|	(&КонПериода = ДатаВремя(1,1,1) Или Док.Дата <= &КонПериода)
	|	И (&НеИспользоватьОтборОрганизации Или Док.Отправитель В (&ОтобратьОрганизации) Или Док.Получатель В (&ОтобратьОрганизации))
	|	И (&НеИспользоватьОтборПоКонтролирующемуОргану Или 	
	|		ВЫБОР КОГДА ТипыТС.КонтролирующийОрган = ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПустаяСсылка) ТОГДА
	|			ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(ЦО.ВнешняяОрганизация) = ТИП(Справочник.НалоговыеОрганы) ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)
	|				КОГДА ТИПЗНАЧЕНИЯ(ЦО.ВнешняяОрганизация) = ТИП(Справочник.ОрганыПФР) ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПФР)
	|				КОГДА ТИПЗНАЧЕНИЯ(ЦО.ВнешняяОрганизация) = ТИП(Справочник.ОрганыФСГС) ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФСГС)
	|				ИНАЧЕ
	|					ТипыТС.КонтролирующийОрган
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ТипыТС.КонтролирующийОрган
	|		КОНЕЦ В (&ОтобратьКонтролирующиеОрганы))
	|	И (&НеИспользоватьОтборПоВидамОбъектов Или (""%%03"") В (&ОтобратьВидыОбъектов))
	|	И НЕ СодержимоеТК.ТранспортноеСообщение ЕСТЬ NULL
	|";
	
	Если ДляАрхивации Тогда 
		ТекстЗапроса = ТекстЗапроса + "	И (СостояниеОбъектов.Архивный ЕСТЬ NULL Или Не СостояниеОбъектов.Архивный)";
	Иначе
		ТекстЗапроса = ТекстЗапроса + "	И (Не (СостояниеОбъектов.Архивный ЕСТЬ NULL) И СостояниеОбъектов.Архивный)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//%%00", ТекстЗапроса_БлокТипыТранспортныхСообщений());
	
	БлокИдентификаторы = ТекстЗапроса_БлокОпределенияВидаОбъектаПоПредметуЦиклаОбмена();	
	БлокИдентификаторы = СтрЗаменить(БлокИдентификаторы, "%NAME", "%ID");
	БлокИдентификаторы2 = СтрЗаменить(БлокИдентификаторы, "%%ANAME", "ИдентификаторГруппы");
	БлокИдентификаторы = СтрЗаменить(БлокИдентификаторы, "%%ANAME", "");	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """%%03""", БлокИдентификаторы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//%%02", БлокИдентификаторы2);
	
	ЗаменитьПодстановочныеСимволыВТекстеЗапроса(ТекстЗапроса);
	
	Группы = ГруппировкиОбъектовДО();	
	СчФмт = Формат(99, "ЧЦ=2; ЧДЦ=; ЧН=; ЧВН=");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """%%ID" + СчФмт + """", Строка(Группы["%%ID" + СчФмт]) ); 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ID" + СчФмт, Строка(Группы["%%ID" + СчФмт]) ); 
	
	Возврат ТекстЗапроса;	
	
КонецФункции

