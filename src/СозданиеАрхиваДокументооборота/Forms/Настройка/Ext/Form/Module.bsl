
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкиФильтра = Параметры.НастройкиФильтра;
	НастройкиФильтраПредметов = Параметры.НастройкиФильтраПредметов;
	ВходящиеНастройки = Параметры.ВходящиеНастройки;
	
	Организации.Очистить();
	КонтролирующиеОрганы.Очистить();
	ВидыОбъектов.Очистить();
	Интервалы.Очистить();
	
	мИнтервалы = Новый Массив;
	Начало = Неопределено;
	Окончание = Неопределено;
	
	Для Каждого ЗаписьИстории из НастройкиФильтра Цикл
		Начало = Мин(ЗаписьИстории.Значение.Начало, ?(Начало = Неопределено, '21990101', Начало));
		КонецИнтервала = ?(ЗаписьИстории.Значение.Окончание = '00010101', КонецГода(ТекущаяДата()), ЗаписьИстории.Значение.Окончание);
		Окончание = Макс(КонецИнтервала, ?(Окончание = Неопределено, '00010101', Окончание));
		
		Интервал = Новый Структура("Начало, Окончание", ЗаписьИстории.Значение.Начало, ЗаписьИстории.Значение.Окончание);		
		ПредставлениеИнтервала = Формат(Интервал.Начало, "yyyyMMdd")+Формат(Интервал.Окончание, "yyyyMMdd");
		
		Если мИнтервалы.Найти(ПредставлениеИнтервала) = Неопределено Тогда 
			КонецИнтервалаДляПредставления = ?(Интервал.Окончание = '00010101', Интервал.Окончание, КонецДня(Интервал.Окончание));
			Представление = ПредставлениеПериода(Интервал.Начало, КонецИнтервалаДляПредставления, "Л=ru_RU; ФП=Ложь");
			Если Представление = "" Тогда 
				Представление = "Без ограничения периода";
			ИначеЕсли Интервал.Начало = НачалоГода(Интервал.Начало) И (КонецИнтервалаДляПредставления = '00010101') Тогда 
				Представление = "С начала " + Представление;
			КонецЕсли;
			Представление = СтрЗаменить(Представление, "... -", "С даты первого обмена -");
			Представление = СтрЗаменить(Представление, "- ...", " по дату последнего обмена");
			мИнтервалы.Добавить(ПредставлениеИнтервала);
			Интервалы.Добавить(Интервал, Представление);
		КонецЕсли;
			
		Для Каждого СтрОрганизация Из ЗаписьИстории.Значение.Организации Цикл 
			Если СтрОрганизация.КоличествоОбъектов = 0 Тогда 
				Продолжить;
			КонецЕсли;
			Если Организации.НайтиПоЗначению(СтрОрганизация.Организация) = Неопределено Тогда 
				Если ОбщегоНазначения.СсылкаСуществует(СтрОрганизация.Организация) Тогда 
					Организации.Добавить(СтрОрганизация.Организация, СтрОрганизация.Название, Истина);
				КонецЕсли;				
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрКонтролирующийОрган Из ЗаписьИстории.Значение.КонтролирующиеОрганы Цикл 
			Если СтрКонтролирующийОрган.КоличествоОбъектов = 0 Тогда 
				Продолжить;
			КонецЕсли;
			Если КонтролирующиеОрганы.НайтиПоЗначению(СтрКонтролирующийОрган.Орган) = Неопределено Тогда 
				КонтролирующиеОрганы.Добавить(СтрКонтролирующийОрган.Орган, Строка(СтрКонтролирующийОрган.Орган), Истина);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрВидОбъекта Из ЗаписьИстории.Значение.ВидыОбъектов Цикл 
			Если СтрВидОбъекта.КоличествоОбъектов = 0 Тогда 
				Продолжить;
			КонецЕсли;
			Если ВидыОбъектов.НайтиПоЗначению(СтрВидОбъекта.Идентификатор) = Неопределено Тогда 
				ВидыОбъектов.Добавить(СтрВидОбъекта.Идентификатор, СтрВидОбъекта.Каталог, Истина);
			КонецЕсли;
		КонецЦикла;		
	КонецЦикла;
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Пометка");
	Дерево.Колонки.Добавить("Идентификатор");
	Дерево.Колонки.Добавить("Предмет");
		
	Родители = Новый Соответствие;
	
	Для Каждого ЗаписьИстории из НастройкиФильтраПредметов Цикл
			
		Код = ЗаписьИстории.Значение.Код;
		Если СтрНайти("GEN;", Лев(Код, 3)) > 0 Тогда //Если не код элемента из Справочники.ВидыОтправляемыхДокументов
			Код = ЗаписьИстории.Значение.Родитель;
			Если Код = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Родитель = Родители.Получить(Код);
		Если Родитель <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;
			
		Стр = Дерево.Строки.Добавить();	
		Стр.Пометка = Истина;
		Стр.Идентификатор = Код;
		
		Если СтрНайти("CUS;P00;", Лев(Код, 3)) > 0 Тогда //Полное представление произвольного предмета или сгенерированное на основе названия отчета
			Стр.Предмет = ЗаписьИстории.Представление;
		Иначе //Код элемента из Справочники.ВидыОтправляемыхДокументов
			Эл = Справочники.ВидыОтправляемыхДокументов.НайтиПоКоду(Код);
			Стр.Предмет = СтрЗаменить(Эл.Наименование, "(не используется) ", "");
		КонецЕсли;
		
		Родители.Вставить(Код, Стр);
		
	КонецЦикла;
	
	Для Каждого ЗаписьИстории из НастройкиФильтраПредметов Цикл
		
		Код = ЗаписьИстории.Значение.Код;
		Если СтрНайти("GEN;", Лев(Код, 3)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗаписьИстории.Значение.Родитель <> Неопределено Тогда
			Ветка = Родители.Получить(ЗаписьИстории.Значение.Родитель);			
			Стр = Ветка.Строки.Добавить();	
		Иначе
			Стр = Дерево.Строки.Добавить();	
		КонецЕсли;
		
	
		Стр.Пометка = Истина;
		Стр.Идентификатор = ЗаписьИстории.Значение;
		Стр.Предмет = ЗаписьИстории.Представление;
		
	КонецЦикла;
	
	Дерево.Строки.Сортировать("Идентификатор");
	
	ЗначениеВРеквизитФормы(Дерево, "Предметы");
		
	Организации.СортироватьПоПредставлению();
	КонтролирующиеОрганы.СортироватьПоПредставлению();
	ВидыОбъектов.СортироватьПоЗначению();
	
	НачалоПериода = Начало;
	ОкончаниеПериода = Окончание;
	
	Если ВходящиеНастройки = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	//Применение настроек предыдущей сессии
	
	Для Каждого Эл Из Организации Цикл 
		НастройкаЭл = ВходящиеНастройки.Организации.НайтиПоЗначению(Эл.Значение);
		Если НастройкаЭл = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		Эл.Пометка = НастройкаЭл.Пометка
	КонецЦикла;
	
	Для Каждого Эл Из КонтролирующиеОрганы Цикл 
		НастройкаЭл = ВходящиеНастройки.КонтролирующиеОрганы.НайтиПоЗначению(Эл.Значение);
		Если НастройкаЭл = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		Эл.Пометка = НастройкаЭл.Пометка
	КонецЦикла;
	
	Для Каждого Эл Из ВидыОбъектов Цикл 
		НастройкаЭл = ВходящиеНастройки.ВидыОбъектов.НайтиПоЗначению(Эл.Значение);
		Если НастройкаЭл = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		Эл.Пометка = НастройкаЭл.Пометка
	КонецЦикла;
	
	НачалоПериода = ВходящиеНастройки.Начало;
	ОкончаниеПериода = ВходящиеНастройки.Окончание;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборИнтервалаОбработкаВыбора(Элемент, ВхПараметры) Экспорт
	
	Если Элемент = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Элемент.Значение;
	
	НачалоПериода = ВыбранноеЗначение.Начало;
	ОкончаниеПериода = ВыбранноеЗначение.Окончание;
	
КонецПроцедуры

