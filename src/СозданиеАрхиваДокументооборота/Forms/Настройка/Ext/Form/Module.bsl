	//
КонецПроцедуры

&НаСервере
Функция ПолучитьВыбранныеПредметы()
	дерПредметы = РеквизитФормыВЗначение("Предметы",);
	
	ВыбранныеПредметы = Новый Массив;
	Для Каждого Эл Из дерПредметы.Строки Цикл 
		Если Эл.Пометка Тогда 
			ВыбранныеПредметы.Добавить(Эл.Предмет);
		КонецЕсли;
		Для Каждого Эл2 Из Эл.Строки Цикл 
			Если Эл2.Пометка Тогда 
				ВыбранныеПредметы.Добавить(Эл2.Предмет);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ВыбранныеПредметы;
КонецФункции
	
&НаКлиенте
Процедура КомандаВыбор(Команда)
	
	Пометок = 0;
	Для Каждого Эл Из Организации Цикл 
		Если Эл.Пометка Тогда 
			Пометок = Пометок + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Эл Из КонтролирующиеОрганы Цикл 
		Если Эл.Пометка Тогда 
			Пометок = Пометок + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Эл Из ВидыОбъектов Цикл 
		Если Эл.Пометка Тогда 
			Пометок = Пометок + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ВыбранныеПредметы = ПолучитьВыбранныеПредметы();
			
	Если Пометок < 3 Тогда
		ПоказатьПредупреждение(, "Необходмо выбрать как минимум одну организацию, один контролирующий орган и один вид объектов");
		Возврат;
	КонецЕсли;
	
	ПараметрЗакрытия = Новый Структура;
	ПараметрЗакрытия.Вставить("Организации", Организации);
	ПараметрЗакрытия.Вставить("КонтролирующиеОрганы", КонтролирующиеОрганы);
	ПараметрЗакрытия.Вставить("ВидыОбъектов", ВидыОбъектов);
	ПараметрЗакрытия.Вставить("Предметы", ВыбранныеПредметы);
	ПараметрЗакрытия.Вставить("Начало", НачалоПериода);
	ПараметрЗакрытия.Вставить("Окончание", ОкончаниеПериода);
	
	ЭтотОбъект.Закрыть(ПараметрЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИнтервал(Команда)
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Очистить();	
	
	Для Каждого Интервал Из Интервалы Цикл 
		СписокВыбора.Добавить(Интервал.Значение, Интервал.Представление);		
	КонецЦикла;
	
	ОО = Новый ОписаниеОповещения("ВыборИнтервалаОбработкаВыбора", ЭтотОбъект);
	СписокВыбора.ПоказатьВыборЭлемента(ОО, "Выберите период предыдущей архивации",);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредметыПриИзменении(Элемент)
	
	Вложенные = Элемент.ТекущиеДанные.ПолучитьЭлементы();	
	Для Каждого Эл Из Вложенные Цикл 
		Эл.Пометка = Элемент.ТекущиеДанные.Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредметыВыбратьСнять(Выбрать = Истина)
	
	дерПредметы = Предметы.ПолучитьЭлементы();
	
	Для Каждого Эл Из дерПредметы Цикл 
		Если (Выбрать И Не Эл.Пометка) Или (Не Выбрать И Эл.Пометка) Тогда 
			Эл.Пометка = Выбрать;			
		КонецЕсли;
		Вложенные = Эл.ПолучитьЭлементы();
		Для Каждого Эл2 Из Вложенные Цикл 
			Если (Выбрать И Не Эл2.Пометка) Или (Не Выбрать И Эл2.Пометка) Тогда 
				Эл2.Пометка = Выбрать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредметыВыбратьВсе(Команда)
	
	ПредметыВыбратьСнять(Истина)
	
КонецПроцедуры

&НаКлиенте
Процедура ПредметыОтменитьВыбор(Команда)
	
	ПредметыВыбратьСнять(Ложь)
	
КонецПроцедуры
