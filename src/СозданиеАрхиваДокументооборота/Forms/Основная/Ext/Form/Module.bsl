Процедура НачалоПериодаПриИзменении(Элемент)
	
	АнализироватьСодержимое(Неопределено);
	ОбновитьЗаголовкиГрупп();
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеПериодаПриИзменении(Элемент)
	
	АнализироватьСодержимое(Неопределено);
	ОбновитьЗаголовкиГрупп();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура АнализироватьСодержимое(Команда)
	Перем ВидыОбъектов;
	
	Если ОграничитьОрганизации Тогда 
		ОтмеченоОрганизаций = 0;
		Для Каждого Орг Из ФильтрОрг Цикл
			Если Орг.Пометка Тогда 
				ОтмеченоОрганизаций = ОтмеченоОрганизаций + 1;
			КонецЕсли;
		КонецЦикла;
		Если ОтмеченоОрганизаций = 0 Тогда 
			Сообщение = НСтр("ru = 'Не выбрано ни одной организации для обработки. Отключите ограничение по организациям или выберите одну или несколько организаций в списке'");
			ПоказатьПредупреждение(, Сообщение);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОрганизацииПоследнейОценки = Неопределено;
	КонтролирующиеОрганы = АнализироватьСодержимоеОъектов(ВидыОбъектов, ОрганизацииПоследнейОценки);		
	ОтметитьФильтрПослеИзменения();
	
КонецПроцедуры

&НаКлиенте
Процедура АрхивироватьВсе(Команда)
	
	ОбновитьПрогресс();
	ПрерватьВыполнение = Ложь;
	
	ВыбранныеОрганизации = Новый Массив;
	Если ОграничитьОрганизации Тогда 
		ОтмеченоОрганизаций = 0;
		Для Каждого Орг Из ФильтрОрг Цикл
			Если Орг.Пометка Тогда 
				ОтмеченоОрганизаций = ОтмеченоОрганизаций + 1;
				ВыбранныеОрганизации.Добавить(Орг.Значение);
			КонецЕсли;
		КонецЦикла;
		Если ОтмеченоОрганизаций = 0 Тогда 
			Сообщение = НСтр("ru = 'Не выбрано ни одной организации для обработки. Отключите ограничение по организациям или выберите одну или несколько организаций в списке'");
			ПоказатьПредупреждение(, Сообщение);
			Возврат;
		КонецЕсли;
	КонецЕсли;
			
	ВыбранныеВидыОбъектов = Новый Массив;
	Для Каждого ЭлСписка Из ФильтрВО Цикл
		Если ЭлСписка.Пометка Тогда 
			ВыбранныеВидыОбъектов.Добавить(ЭлСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВыбранныеКонтролирующиеОрганы = Новый Массив;
	Для Каждого ЭлСписка Из ФильтрКО Цикл
		Если ЭлСписка.Пометка Тогда 
			ВыбранныеКонтролирующиеОрганы.Добавить(ЭлСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если ОграничитьПериод Тогда 
		НачПериода = НачалоПериода;
		
		Если ОкончаниеПериода <> '00010101' Тогда 
			КонПериода = КонецДня(ОкончаниеПериода);
		Иначе
			КонПериода = ОкончаниеПериода;
		КонецЕсли;
	Иначе
		НачПериода = '00010101';
		КонПериода = '00010101';
	КонецЕсли;
	
	Если КаталогАрхива = "" Тогда 
		Сообщение = НСтр("ru = 'Не выбран каталог для хранения архива'");
		ПоказатьПредупреждение(, Сообщение);
		Возврат;
	КонецЕсли;
	
	НеобходимаяДлина = МаксимальнаяДлинаКаталоговАрхивации();
	
	//Проверить длину организаций и каталога
	Для Каждого Орг Из ОрганизацииПоследнейОценки Цикл 
		Если СтрДлина(КаталогАрхива) + 1 + СтрДлина(Орг.Название) + 1 + НеобходимаяДлина > 260 Тогда 
			Сообщение = НСтр("ru = 'Необходимо выбрать каталог с более коротким путем для того чтобы сохранить все файлы с длинными именами'");
			ПоказатьПредупреждение(, Сообщение);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьПрогресс(0);
	Элементы.АрхивироватьВсе.Доступность = Ложь;
	Элементы.Восстановить.Доступность = Ложь;

	ПараметрыЗапускаАрхивации = Новый Структура;
	ПараметрыЗапускаАрхивации.Вставить("Стадия", 0);
	ПараметрыЗапускаАрхивации.Вставить("ВыбранныеВидыОбъектов", ВыбранныеВидыОбъектов);
	ПараметрыЗапускаАрхивации.Вставить("ВыбранныеКонтролирующиеОрганы", ВыбранныеКонтролирующиеОрганы);
	ПараметрыЗапускаАрхивации.Вставить("ВыбранныеОрганизации", ВыбранныеОрганизации);
	
	ПараметрыЗапускаАрхивации.Вставить("НачПериода", НачПериода);
	ПараметрыЗапускаАрхивации.Вставить("КонПериода", КонПериода);
	
	ПараметрыЗапускаАрхивации.Вставить("КаталогАрхива", КаталогАрхива);
	ПараметрыЗапускаАрхивации.Вставить("РасширениеПодключено", Неопределено);
	ПараметрыЗапускаАрхивации.Вставить("ВсегоОбъектов", Неопределено);
	
	ПараметрыЗапускаАрхивации.Вставить("ЭтоАрхивация", Истина);
	ПараметрыЗапускаАрхивации.Вставить("ЭтоВосстановление", Ложь);
	
	КаталогДлинныхИмен = Новый Структура;
	КаталогДлинныхИмен.Вставить("Использованные", Новый Массив);
	КаталогДлинныхИмен.Вставить("Каталог", Новый Соответствие);
	КаталогДлинныхИмен.Вставить("СтарыйКаталог", Новый Соответствие);
	КаталогДлинныхИмен.Вставить("ТолькоНовые", Новый Соответствие);
	
	КаталогСокращений = Новый Структура;
	КаталогСокращений.Вставить("Каталог", Новый Соответствие); //Ключ - код предмета, значение - сокращение
	КаталогСокращений.Вставить("ОбратныйКаталог", Новый Соответствие); //Ключ - сокращение, значение - код предмета
	КаталогСокращений.Вставить("Новые", Новый Массив); //Значение - предмет
	КаталогСокращений.Вставить("КаталогРодителей", Новый Соответствие); //Ключ - код, значение - код родителя
	
	ПрочитатьКаталогИменИСокращений();
		
	ПодключитьОбработчикОжидания("Подключаемый_ЗапуститьАрхивацию", 0.1, Истина);
			
КонецПроцедуры

&НаКлиенте
Процедура СделатьБэкап(Команда)
			
	ОткрытьФорму("Обработка.РезервноеКопированиеИБ.Форма.РезервноеКопированиеДанных",, ЭтотОбъект); 
			
КонецПроцедуры

&НаКлиенте
Процедура Восстановить(Команда)
	
	Если КаталогАрхива = "" Тогда 
		Сообщение = НСтр("ru = 'Не выбран каталог архива'");
		ПоказатьПредупреждение(, Сообщение);
		Возврат;
	КонецЕсли;
		
	Если ПоследниеНастройкиВосстановления = Неопределено Тогда 
		
		ОткрытьФормуНастройки(Истина);
		Возврат;
		
	КонецЕсли;
	
	ОбновитьПрогресс();
	ПрерватьВыполнение = Ложь;
	
	ВыбранныеОрганизации = Новый Массив;
	Если ОграничитьОрганизации Тогда 
		ОтмеченоОрганизаций = 0;
		Для Каждого Орг Из ПоследниеНастройкиВосстановления.Организации Цикл
			Если Орг.Пометка Тогда 				
				ОтмеченоОрганизаций = ОтмеченоОрганизаций + 1;
				ВыбранныеОрганизации.Добавить(Орг.Значение);
			КонецЕсли;
		КонецЦикла;
		Если ОтмеченоОрганизаций = 0 Тогда 
			Сообщение = НСтр("ru = 'Не выбрано ни одной организации для обработки'");
			ПоказатьПредупреждение(, Сообщение);
			Возврат;
		КонецЕсли;
	КонецЕсли;
			
	ВыбранныеВидыОбъектов = Новый Массив;
	Для Каждого ЭлСписка Из ПоследниеНастройкиВосстановления.ВидыОбъектов Цикл
		Если ЭлСписка.Пометка Тогда 
			ВыбранныеВидыОбъектов.Добавить(ЭлСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВыбранныеКонтролирующиеОрганы = Новый Массив;
	Для Каждого ЭлСписка Из ПоследниеНастройкиВосстановления.КонтролирующиеОрганы Цикл
		Если ЭлСписка.Пометка Тогда 
			ВыбранныеКонтролирующиеОрганы.Добавить(ЭлСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	НачПериода = ПоследниеНастройкиВосстановления.Начало;
	КонПериода = ПоследниеНастройкиВосстановления.Окончание;
	Если КонПериода <> '00010101' Тогда 
		КонПериода = КонецДня(КонПериода);
	КонецЕсли;

	ОбновитьПрогресс(0);
	Элементы.АрхивироватьВсе.Доступность = Ложь;
	Элементы.Восстановить.Доступность = Ложь;

	ПараметрыЗапускаАрхивации = Новый Структура;
	ПараметрыЗапускаАрхивации.Вставить("Стадия", 0);
	ПараметрыЗапускаАрхивации.Вставить("ВыбранныеВидыОбъектов", ВыбранныеВидыОбъектов);
	ПараметрыЗапускаАрхивации.Вставить("ВыбранныеКонтролирующиеОрганы", ВыбранныеКонтролирующиеОрганы);
	ПараметрыЗапускаАрхивации.Вставить("ВыбранныеОрганизации", ВыбранныеОрганизации);
	
	ПараметрыЗапускаАрхивации.Вставить("НачПериода", НачПериода);
