&НаСервере
Функция БезРасширения(Знач ИмяФайла)
	
	Длина = СтрДлина(ИмяФайла);
	Для ш = 1 по Длина Цикл 
		СимволИмени = Сред(ИмяФайла, Длина - ш - 1, 1);
		Если СимволИмени = "." Тогда 
			ТолькоИмя = Лев(ИмяФайла, Длина - ш - 2);
			Если ТолькоИмя = "" Тогда 
				Возврат ИмяФайла;
			Иначе 
				Возврат ТолькоИмя;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИмяФайла;
	
КонецФункции

&НаСервере
Функция ВыбратьСостоянияОбъекта(ОбъектВладелец, ВидВладельца)
	
	Вид_Измерение = ВыгружаемыеРеквизиты();
	ИмяИзмерения = Вид_Измерение.Получить(ВидВладельца);
	
	Вид_ИзмерениеМета = ВыгружаемыеРеквизитыМетаданные();
	ВидВладельцаМета = Вид_ИзмерениеМета.Получить(ВидВладельца);
		
	Набор = РегистрыСведений.ПризнакиАрхивированияФайловДОСКонтролирующимиОрганами.СоздатьНаборЗаписей();
		
	Если Найти("ОтправкиФТС|ОтправкиФСС|ОтправкиФСРАР|ОтправкиРПН|", ВидВладельца) = 0 Тогда
		ИмяФайла = ОбъектВладелец.ИмяФайла;
		СсылкаВладельца = ОбъектВладелец[ИмяИзмерения].Ссылка;
	Иначе
		ИмяФайла = БезРасширения(ОбъектВладелец.ИмяФайла);
		СсылкаВладельца = ОбъектВладелец.Ссылка;
	КонецЕсли;
	
	Набор.Отбор["Объект"].Установить(СсылкаВладельца);
	Набор.Отбор["ИмяФайла"].Установить(ИмяФайла);
	Набор.Отбор["Владелец"].Установить(ВидВладельцаМета);
	Набор.Прочитать();
		
	Возврат Набор;
	
КонецФункции

//Возвращает результат завершения операции если Архивировать булево
//В противном случае возвращает значение признака "Архивный" объекта
&НаСервере
Функция УстановитьСостояниеОбъекта(ОбъектВладелец, ВидВладельца, Архивировать = Истина)
	
	Набор = ВыбратьСостоянияОбъекта(ОбъектВладелец, ВидВладельца);
	Если Набор.Количество() = 0 Тогда 
		
		Если Архивировать = Неопределено Тогда //Возвращаем состояние объекта
			Возврат Ложь; //Нет записей - не архивный
		КонецЕсли;
		
		Если Не Архивировать Тогда //Разархивация - возвращаем состояние операции
			Возврат Истина; //Нет записей - успешно
		КонецЕсли;
		
		Запись = Набор.Добавить();
		
		Если Найти("ОтправкиФТС|ОтправкиФСС|ОтправкиФСРАР|ОтправкиРПН|", ВидВладельца) = 0 Тогда
			ИмяФайла = ОбъектВладелец.ИмяФайла;
		Иначе
			ИмяФайла = БезРасширения(ОбъектВладелец.ИмяФайла);
		КонецЕсли;
		
		Запись.Владелец = Набор.Отбор.Владелец.Значение;
		Запись.Объект = Набор.Отбор.Объект.Значение;
		Запись.ИмяФайла = ИмяФайла;
		Запись.Архивный = Истина;
		
	Иначе
		Если Архивировать = Неопределено Или Архивировать Тогда
			Для Каждого Запись Из Набор Цикл 
				Если Архивировать = Неопределено Тогда //Возвращаем состояние объекта
					Возврат Запись.Архивный;
				КонецЕсли;
				Запись.Архивный = Истина;
			КонецЦикла;
		Иначе
			Набор.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗаписьВПопытке(Набор, Истина);
	
КонецФункции

&НаСервере
