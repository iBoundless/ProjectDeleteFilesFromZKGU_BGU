&НаКлиенте
Процедура ВыполнитьАрхивациюВосстановлениеОбъектов_Продолжение(Результат, ВхПараметры) Экспорт
	Перем РежимАрхивации, РежимОчистки, РежимВосстановления;
	
	ВхПараметры.ПараметрыЗапуска.Свойство("РежимАрхивации", РежимАрхивации);
	ВхПараметры.ПараметрыЗапуска.Свойство("РежимОчистки", РежимОчистки);
	ВхПараметры.ПараметрыЗапуска.Свойство("РежимВосстановления", РежимВосстановления);
	
	ВыполнитьАрхивациюВосстановлениеОбъектов(
		ВхПараметры.ПараметрыЗапуска.Стадия,
		ВхПараметры.ПараметрыЗапуска.ВыбранныеВидыОбъектов,
		ВхПараметры.ПараметрыЗапуска.ВыбранныеКонтролирующиеОрганы,
		ВхПараметры.ПараметрыЗапуска.ВыбранныеОрганизации,
		ВхПараметры.ПараметрыЗапуска.НачПериода,
		ВхПараметры.ПараметрыЗапуска.КонПериода,
		ВхПараметры.ПараметрыЗапуска.КаталогАрхива,
		,
		ВхПараметры.ПараметрыЗапуска.ВсегоОбъектов
		, ?(РежимАрхивации = Неопределено, Ложь, РежимАрхивации)
		, ?(РежимОчистки = Неопределено, Ложь, РежимОчистки)
		, ?(РежимВосстановления = Неопределено, Ложь, РежимВосстановления)
	);
	
КонецПроцедуры

//*** 2б
&НаКлиенте
Процедура ВыполнитьАрхивацию_ПереместитьДанныеВАрхивРекурсивно(Оповещение, ОбрабатываемыйОбъект, ОставшиесяОбъекты)
	
	ИндексВложения = ОбрабатываемыйОбъект.ИндексВложения + 1;
	Если ИндексВложения >= ОбрабатываемыйОбъект.АдресаАрхивируемых.Количество() Тогда 
		
		ОбработаноОбъектов = ОбработаноОбъектов + 1;
		
		Если ТолькоВыгрузка Тогда //одна итерация
			Множитель = 1;
		Иначе //Выгрузка, установка флагов, очистка - 3 итерации
			Множитель = 3;
		КонецЕсли;
			
		ОбновитьПрогресс(ОбработаноОбъектов + ЗаархивированоОбъектов + ОчищеноОбъектов, Оповещение.ДополнительныеПараметры.ВсегоОбъектов * Множитель);
						
		ОбрабатываемыйОбъект.Обработан = Истина;
		ВыполнитьОбработкуОповещения(Оповещение, ОставшиесяОбъекты);
		Возврат;
	Иначе
		ОбрабатываемыйОбъект.ИндексВложения = ИндексВложения;
	КонецЕсли;
								
	НовыйФайл = ОбрабатываемыйОбъект.АдресаАрхивируемых[ИндексВложения];
	Если НовыйФайл = Неопределено Тогда //Пропустим выгрузку пустых файлов
		ВыполнитьАрхивацию_ПереместитьДанныеВАрхивРекурсивно(Оповещение, ОбрабатываемыйОбъект, ОставшиесяОбъекты);
		Возврат;
	КонецЕсли;
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеЗавершения", Оповещение);
	Контекст.Вставить("ОставшиесяОбъекты", ОставшиесяОбъекты);
	Контекст.Вставить("НовыйФайл", НовыйФайл);
	Контекст.Вставить("ОбрабатываемыйОбъект", ОбрабатываемыйОбъект);
	
	Каталог = Новый Файл(НовыйФайл.Каталог);
	Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеВАрхив_ПроверкаПередСозданиемКаталога", ЭтотОбъект, Контекст);
	Каталог.НачатьПроверкуСуществования(Оповещение1);
								
КонецПроцедуры

//*** 2б (восстановление)
&НаКлиенте
Процедура ВыполнитьВосстановление_ПереместитьДанныеИзАрхиваРекурсивно(Оповещение, ОбрабатываемыйОбъект, ОставшиесяОбъекты)
	
	ИндексВложения = ОбрабатываемыйОбъект.ИндексВложения + 1;
	Если ИндексВложения >= ОбрабатываемыйОбъект.АдресаАрхивируемых.Количество() Тогда 
		
		ВыполнитьВосстановление_ЗагрузитьСодержимоеОбъектов(ОбрабатываемыйОбъект);
		
		ОбработаноОбъектов = ОбработаноОбъектов + 1;		
		ОбновитьПрогресс(ОбработаноОбъектов, Оповещение.ДополнительныеПараметры.ВсегоОбъектов);
						
		ОбрабатываемыйОбъект.Обработан = Истина;
			
		ВыполнитьОбработкуОповещения(Оповещение, ОставшиесяОбъекты);
		Возврат;
	Иначе
		ОбрабатываемыйОбъект.ИндексВложения = ИндексВложения;
	КонецЕсли;
								
	НовыйФайл = ОбрабатываемыйОбъект.АдресаАрхивируемых[ИндексВложения];
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеЗавершения", Оповещение);
	Контекст.Вставить("ОставшиесяОбъекты", ОставшиесяОбъекты);
	Контекст.Вставить("НовыйФайл", НовыйФайл);
	Контекст.Вставить("ОбрабатываемыйОбъект", ОбрабатываемыйОбъект);
			
	Загружаемый = Новый Файл(НовыйФайл.ПолныйПуть);
	Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеИзАрхива_ПроверкаСуществованияФайла", ЭтотОбъект, Контекст);
	Загружаемый.НачатьПроверкуСуществования(Оповещение1);
								
КонецПроцедуры

&НаСервере
Функция ВыполнитьВосстановление_ЗагрузитьСодержимоеОбъектов(ОбрабатываемыйОбъект)
	
	Вид_Измерение = ВыгружаемыеРеквизиты();	
	Если Вид_Измерение.Получить(ОбрабатываемыйОбъект.Вид) <> Неопределено Тогда 
		
		РаботаемСРегистром = Найти("ОтправкиФТС|ОтправкиФСС|ОтправкиФСРАР|ОтправкиРПН|", ОбрабатываемыйОбъект.Вид) = 0;
		ИмяИзмерения = Вид_Измерение.Получить(ОбрабатываемыйОбъект.Вид);		
				
		Если РаботаемСРегистром Тогда
			Набор = РегистрыСведений[ОбрабатываемыйОбъект.Вид].СоздатьНаборЗаписей();
			Набор.Отбор[ИмяИзмерения].Установить(ОбрабатываемыйОбъект.Ссылка);
			Набор.Прочитать();
		Иначе
			Набор = РеквизитыВыборкой(ОбрабатываемыйОбъект.Ссылка, Истина);
			ОбъектОтправки = ОбрабатываемыйОбъект.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Изменений = 0;
		ИзмененийПрисоединенных = 0;
		
		Для Каждого Запись Из Набор Цикл 
			
			Архивная = ПолучитьПризнакАрхивного(Запись, ОбрабатываемыйОбъект.Вид);
			Если Не Архивная Тогда 
				Продолжить;
			КонецЕсли;
			
			Если Запись.ИмяФайла = "" Тогда 
				Продолжить;
			КонецЕсли;
			
			Данные = Неопределено;
			Для Каждого ТекущийФайл Из ОбрабатываемыйОбъект.АдресаАрхивируемых Цикл
				Если ТекущийФайл.Адрес = Неопределено Тогда 
					Продолжить;
				КонецЕсли;
				Если ТекущийФайл.ИмяФайла = Запись.ИмяФайла Тогда 
					Данные = ПолучитьИзВременногоХранилища(ТекущийФайл.Адрес);
					Если ТекущийФайл.ПоложитьВХранилищеЗначения Тогда 
						Данные = Новый ХранилищеЗначения(Данные);						
					КонецЕсли;
					УдалитьИзВременногоХранилища(ТекущийФайл.Адрес);
					ТекущийФайл.Адрес = Неопределено;
					Прервать;
				КонецЕсли;				
			КонецЦикла;
			
			Если Данные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ИзмененПрисоединенный = УстановитьЗначениеПрисоединенногоФайла(ОбрабатываемыйОбъект.Ссылка, Запись.ИмяФайла, ОбрабатываемыйОбъект.Вид, Данные);
			Если ИзмененПрисоединенный Тогда 
				ИзмененийПрисоединенных = ИзмененийПрисоединенных + 1;
				Продолжить;
			КонецЕсли;
			
			Если РаботаемСРегистром Тогда
				Запись["Данные"] = Данные;
			Иначе
				ОбъектОтправки[Запись.Реквизит] = Данные;
			КонецЕсли;
			
			Изменений = Изменений + 1;
			
		КонецЦикла;
		
		Если Изменений > 0 Тогда 
			Если РаботаемСРегистром Тогда
				Успешно = ЗаписьВПопытке(Набор, Истина);
			Иначе
				Успешно = ЗаписьВПопытке(ОбъектОтправки);
			КонецЕсли;
		КонецЕсли;
		
		Если Изменений > 0 Или ИзмененийПрисоединенных > 0 Тогда
			
			Для Каждого Запись Из Набор Цикл 
				
				Архивная = ПолучитьПризнакАрхивного(Запись, ОбрабатываемыйОбъект.Вид);
				Если Не Архивная Тогда 
					Продолжить;
				КонецЕсли;
				
				СнятьПризнакАрхивного(Запись, ОбрабатываемыйОбъект.Вид)
				
			КонецЦикла;
			
			Возврат Успешно;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

//*** 2а
&НаСервере
Функция ВыполнитьАрхивацию_ИзвлечьАрхивируемыеДанные(ОбрабатываемыйОбъект, Знач ТолькоПодсчет = Ложь, Знач Архивировать = Ложь, Знач Очистить = Ложь, КаталогИмен, КаталогСокращений)
			
	ПустыеДвоичныеДанные = Base64Значение("AA=="); //$00
	ПустоеХранилищеДД = Новый ХранилищеЗначения(ПустыеДвоичныеДанные);
	ПустоеХранилищеСтр = Новый ХранилищеЗначения(" ");	
	Вид_Измерение = ВыгружаемыеРеквизиты();
	
	Если Вид_Измерение.Получить(ОбрабатываемыйОбъект.Вид) <> Неопределено Тогда 
		
		ИмяИзмерения = Вид_Измерение.Получить(ОбрабатываемыйОбъект.Вид);		
		РаботаемСРегистром = Найти("ОтправкиФТС|ОтправкиФСС|ОтправкиФСРАР|ОтправкиРПН|", ОбрабатываемыйОбъект.Вид) = 0;
		
		Если Архивировать Или Очистить Тогда 
			
			Изменений = 0;
			
			Если РаботаемСРегистром Тогда
				Набор = РегистрыСведений[ОбрабатываемыйОбъект.Вид].СоздатьНаборЗаписей();
				Набор.Отбор[ИмяИзмерения].Установить(ОбрабатываемыйОбъект.Ссылка);
				Набор.Прочитать();
			Иначе
				Набор = РеквизитыВыборкой(ОбрабатываемыйОбъект.Ссылка, Истина);
				ОбъектОтправки = ОбрабатываемыйОбъект.Ссылка.ПолучитьОбъект();
			КонецЕсли;
									
			Для Каждого Запись Из Набор Цикл 
				
				Если СокрП(Запись.ИмяФайла) = "" Тогда 
					Продолжить;
				КонецЕсли;
				
				Архивная = ПолучитьПризнакАрхивного(Запись, ОбрабатываемыйОбъект.Вид);
				Если Архивировать И Архивная Тогда 
					Продолжить;
				КонецЕсли;
				
				Если Очистить И Не Архивная Тогда 
					Продолжить;
				КонецЕсли;
				
				//Если Очистить И Не Архивная И РаботаемСРегистром Тогда
				//	//При обработке объектов с флагом архивный это должно быть критической ошибкой
				//	Возврат Ложь;
				//КонецЕсли;
				
				Если Очистить Тогда
					
					Если РаботаемСРегистром Тогда
						ПустоеХранилище = ПустоеХранилищеДД;
					Иначе
						ЗначениеРеквизита = ОбъектОтправки[Запись.Реквизит].Получить();
						Если ТипЗнч(ЗначениеРеквизита) = Тип("ДвоичныеДанные") Тогда //
							ПустоеХранилище = ПустоеХранилищеДД;
							
						//Незаполненные реквизиты справочников не перезаписываем пустыми хранилищами
						ИначеЕсли ЗначениеРеквизита = Неопределено Или СтрДлина(ЗначениеРеквизита) < 5 Тогда
							Продолжить;
						Иначе
							ПустоеХранилище = ПустоеХранилищеСтр;
						КонецЕсли;
					КонецЕсли;
					
					ИзмененПрисоединенный = УстановитьЗначениеПрисоединенногоФайла(ОбрабатываемыйОбъект.Ссылка, Запись.ИмяФайла, ОбрабатываемыйОбъект.Вид, ПустоеХранилище);
					Если ИзмененПрисоединенный Тогда 
						Продолжить;
					КонецЕсли;
			
					Если РаботаемСРегистром Тогда
						Запись["Данные"] = ПустоеХранилище;
					Иначе
						ОбъектОтправки[Запись.Реквизит] = ПустоеХранилище;
					КонецЕсли;					
					Изменений = Изменений + 1;
				Иначе
					
					//Незаполненные реквизиты справочников не помечаем как архивные
					Если РаботаемСРегистром Тогда
						ЗначениеРеквизита = Запись["Данные"].Получить();
					Иначе
						ЗначениеРеквизита = ОбъектОтправки[Запись.Реквизит].Получить();
					КонецЕсли;
					
					Если (ТипЗнч(ЗначениеРеквизита) <> Тип("ДвоичныеДанные")) И (ЗначениеРеквизита = Неопределено Или СтрДлина(ЗначениеРеквизита) < 5) Тогда
						СодержимоеКонтейнера = ПолучитьИзПрисоединенныхФайлов(ОбрабатываемыйОбъект.Ссылка, Запись.ИмяФайла, ОбрабатываемыйОбъект.Вид);
						Если СодержимоеКонтейнера = Неопределено Тогда 
							//ЛогВыполнения.Добавить("-Пропущен, пустой: " + Запись.ИмяФайла);
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					
					УстановитьПризнакАрхивного(Запись, ОбрабатываемыйОбъект.Вид);
				КонецЕсли;
			КонецЦикла;
			Если Изменений > 0 Тогда 
				Если РаботаемСРегистром Тогда
					Успешно = ЗаписьВПопытке(Набор, Истина);
				Иначе
					Успешно = ЗаписьВПопытке(ОбъектОтправки);
				КонецЕсли;
				Возврат Успешно;
			КонецЕсли;			
		Иначе			
			
			Если РаботаемСРегистром Тогда
				Отбор = Новый Структура(ИмяИзмерения, ОбрабатываемыйОбъект.Ссылка);
				Выборка = РегистрыСведений[ОбрабатываемыйОбъект.Вид].Выбрать(Отбор);
			Иначе
				Выборка = РеквизитыВыборкой(ОбрабатываемыйОбъект.Ссылка);
			КонецЕсли;
			
			Пока Выборка.Следующий() Цикл 
				
				Если Выборка.ИмяФайла = "" Тогда 
					Продолжить;
				КонецЕсли;
				
				Архивная = ПолучитьПризнакАрхивного(Выборка, ОбрабатываемыйОбъект.Вид);
				
				Если Архивная Тогда 
					Продолжить;
				КонецЕсли;
				
				ЧитатьКакДД = Истина;
				Если ТолькоПодсчет Тогда 
					АдресСодержимого = Неопределено;
				Иначе
					СодержимоеКонтейнера = Выборка.Данные.Получить();
					Если СодержимоеКонтейнера = Неопределено Тогда
						//Может быть лежит в присоединённых файлах
						СодержимоеКонтейнера = ПолучитьИзПрисоединенныхФайлов(ОбрабатываемыйОбъект.Ссылка, Выборка.ИмяФайла, ОбрабатываемыйОбъект.Вид);
					Иначе
						ЧитатьКакДД = ТипЗнч(СодержимоеКонтейнера) = Тип("ДвоичныеДанные");
						Если Не ЧитатьКакДД Тогда 
							Если ТипЗнч(СодержимоеКонтейнера) = Тип("Строка") Тогда 
								Если СтрДлина(СодержимоеКонтейнера) < 5 Тогда 
									СодержимоеКонтейнера = Неопределено;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					Если СодержимоеКонтейнера <> Неопределено Тогда 
						АдресСодержимого = ПоместитьВоВременноеХранилище(СодержимоеКонтейнера, ЭтотОбъект.УникальныйИдентификатор);
					Иначе
						АдресСодержимого = "";
					КонецЕсли;
				КонецЕсли;
							
				Каталог = ПолучитьПолныйПуть(ОбрабатываемыйОбъект, КаталогСокращений);
				ПолныйПутьКФайлу = Каталог + Выборка.ИмяФайла;
				
				Если СтрДлина(ПолныйПутьКФайлу)>250 Тогда 
					
					ДобавленНовый = Ложь;
					КороткоеИмя = КаталогИмен.СтарыйКаталог.Получить(Выборка.ИмяФайла);
					
					Если КороткоеИмя = Неопределено Тогда 
						НовоеИмя = ПолучитьКороткоеИмяФайла(КаталогИмен.Использованные, Выборка.ИмяФайла);
						ДобавленНовый = Истина;
					Иначе
						НовоеИмя = КороткоеИмя;
					КонецЕсли;					
					
					ПолныйПутьКФайлу = Каталог + НовоеИмя;
					
					Если СтрДлина(ПолныйПутьКФайлу)>250 Тогда						
						Возврат Ложь;
						//ВызватьИсключение "Слишком длинный путь к файлу. Необходимо выбрать каталог с меньшей длиной пути";
					КонецЕсли;
					
					КаталогИмен.Использованные.Добавить(НовоеИмя);
					КаталогИмен.Каталог.Вставить(НовоеИмя, Выборка.ИмяФайла);
					КаталогИмен.СтарыйКаталог.Вставить(Выборка.ИмяФайла, НовоеИмя);
					Если ДобавленНовый Тогда 
						КаталогИмен.ТолькоНовые.Вставить(НовоеИмя, Выборка.ИмяФайла);
					КонецЕсли;
				Иначе //Сокращение было сгенерировано в предыдущей попытке архивации
					КороткоеИмя = КаталогИмен.СтарыйКаталог.Получить(Выборка.ИмяФайла);
					Если КороткоеИмя <> Неопределено Тогда
						ПолныйПутьКФайлу = Каталог + КороткоеИмя;
					КонецЕсли;
				КонецЕсли;
				
				Если АдресСодержимого = "" Тогда 
					АрхивируемыеДанные = Неопределено;
				Иначе					
					АрхивируемыеДанные = Новый Структура("Адрес, ИмяФайла, ПолныйПуть, Каталог", АдресСодержимого, Выборка.ИмяФайла, ПолныйПутьКФайлу, Каталог);
					АрхивируемыеДанные.Вставить("ЧитатьКакДД", ЧитатьКакДД);
					АрхивируемыеДанные.Вставить("ПоложитьВХранилищеЗначения", Истина);
				КонецЕсли;
				
				ОбрабатываемыйОбъект.АдресаАрхивируемых.Добавить(АрхивируемыеДанные);
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

//*** 2а (восстановление)
&НаСервере
Функция ВыполнитьВосстановление_ОпределитьВосстанавливаемыеДанные(ОбрабатываемыйОбъект, КаталогИмен, КаталогСокращений, ОтборПредметы)
	
	ТолькоПодсчет = Истина;
	
	Вид_Измерение = ВыгружаемыеРеквизиты();
	
	Если Вид_Измерение.Получить(ОбрабатываемыйОбъект.Вид) <> Неопределено Тогда 
		
		ИмяИзмерения = Вид_Измерение.Получить(ОбрабатываемыйОбъект.Вид);		
		Отбор = Новый Структура(ИмяИзмерения, ОбрабатываемыйОбъект.Ссылка);
		РаботаемСРегистром = Найти("ОтправкиФТС|ОтправкиФСС|ОтправкиФСРАР|ОтправкиРПН|", ОбрабатываемыйОбъект.Вид) = 0;
		
		Если РаботаемСРегистром Тогда 
			Выборка = РегистрыСведений[ОбрабатываемыйОбъект.Вид].Выбрать(Отбор);
		Иначе
			Выборка = РеквизитыВыборкой(ОбрабатываемыйОбъект.Ссылка);
		КонецЕсли;
			
		Пока Выборка.Следующий() Цикл 
			
			Если Выборка.ИмяФайла = "" Тогда 
				Продолжить;
			КонецЕсли;
			
			Архивный = ПолучитьПризнакАрхивного(Выборка, ОбрабатываемыйОбъект.Вид);
			
			Если Не Архивный Тогда
				Продолжить;
			КонецЕсли;
			
			АдресСодержимого = Неопределено;
			Каталог = ПолучитьПолныйПуть(ОбрабатываемыйОбъект, КаталогСокращений, ОтборПредметы);
			Если Каталог = "" Тогда 
				Продолжить;
			КонецЕсли;
			
			ПолныйПутьКФайлу = Каталог + Выборка.ИмяФайла;
			
			КороткоеИмя = КаталогИмен.СтарыйКаталог.Получить(Выборка.ИмяФайла);
			Если КороткоеИмя <> Неопределено Тогда
				ПолныйПутьКФайлу = Каталог + КороткоеИмя;
			КонецЕсли;
			
			ЧитатьКакДД = Истина;
			СодержимоеКонтейнера = Выборка.Данные.Получить();
			Если СодержимоеКонтейнера = Неопределено Тогда //Точно не архивный, скорее всего был в присоединенных файлах
			Иначе
				ТипСодержимого = ТипЗнч(СодержимоеКонтейнера);
				ЧитатьКакДД = ТипСодержимого = Тип("ДвоичныеДанные");
			КонецЕсли;
			
			АрхивируемыеДанные = Новый Структура("Адрес, ИмяФайла, ПолныйПуть, Каталог", АдресСодержимого, Выборка.ИмяФайла, ПолныйПутьКФайлу, Каталог);
			АрхивируемыеДанные.Вставить("ЧитатьКакДД", ЧитатьКакДД);
			АрхивируемыеДанные.Вставить("ПоложитьВХранилищеЗначения", Истина);
			ОбрабатываемыйОбъект.АдресаАрхивируемых.Добавить(АрхивируемыеДанные);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ВыполнитьАрхивацию_ПакетАрхивацииОчистки(Пакет, Архивировать, Очистить, КаталогДлинныхИмен, КаталогСокращений)
	
	Результаты = Новый Массив;
	Для Каждого АрхивируемыйЭлемент Из Пакет Цикл 
		Результат = ВыполнитьАрхивацию_ИзвлечьАрхивируемыеДанные(АрхивируемыйЭлемент,, Архивировать, Очистить, КаталогДлинныхИмен, КаталогСокращений);
		Результаты.Добавить(Результат);
	КонецЦикла;
	
	Возврат Результаты;
	
КонецФункции

//*** 2
&НаКлиенте
Процедура ВыполнитьАрхивацию_ИзвлечьИПереместитьДанные(Знач Оценка, ВхПараметры) Экспорт
	
	ОбработкаПрерыванияПользователя();
	Если ПрерватьВыполнение Тогда 
		ОбновитьПрогресс();
		Возврат;
	КонецЕсли;
	
	Архивировать = ВхПараметры.РежимАрхивации;
	Очистить = ВхПараметры.РежимОчистки;
	
	Если Оценка.Количество() = 0 Тогда
		Контекст = Новый Структура;
		Контекст.Вставить("ПараметрыЗапуска", ВхПараметры);
		
		//Переход к извлечению следующей категории объектов
		Оповещение = Новый ОписаниеОповещения("ВыполнитьАрхивациюВосстановлениеОбъектов_Продолжение", ЭтотОбъект, Контекст);
		ВыполнитьОбработкуОповещения(Оповещение);
		Возврат;
	Иначе
		АрхивируемыйЭлемент = Оценка[Оценка.Количество()-1];
		Оценка.Удалить(Оценка.Количество()-1);
	КонецЕсли;
	
	ОбъектовОценкиВПакете = Мин( Макс(5, Цел(ВхПараметры.ВсегоОбъектов / 40)), 50); // 5..50 объектов в пакете
	
	Если Архивировать Или Очистить Тогда
		
		Пакет = Новый Массив;		
		Пакет.Добавить(АрхивируемыйЭлемент);
		
		Пока (Оценка.Количество() > 0) И (ОбъектовОценкиВПакете > 0) Цикл 
			ЭлементПакета = Оценка[Оценка.Количество()-1];
			Оценка.Удалить(Оценка.Количество()-1);
			ОбъектовОценкиВПакете = ОбъектовОценкиВПакете - 1;
			Пакет.Добавить(ЭлементПакета);
		КонецЦикла;
		
		Если Пакет.Количество() > 0 Тогда 
			Результаты = ВыполнитьАрхивацию_ПакетАрхивацииОчистки(Пакет, Архивировать, Очистить, КаталогДлинныхИмен, КаталогСокращений);
		Иначе
			Результаты = Новый Массив;
		КонецЕсли;
		
		Для Каждого Результат Из Результаты Цикл 
			Если Не Результат Тогда
				
				Если Архивировать Или Очистить Тогда
					Если КаталогДлинныхИмен.ТолькоНовые.Количество() > 0 Тогда 
						СобраннаяИнформация.Вставить("Незавершенная", Истина);
						ЗафиксироватьИсториюАрхивации(СобраннаяИнформация);
					КонецЕсли;
				КонецЕсли;
				
				Если Архивировать Тогда
					ВызватьИсключение "Не удалось записать признак архивации объекта";
				ИначеЕсли Очистить Тогда
					ВызватьИсключение "Не удалось записать результат очистки реквизитов";
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
		Если Архивировать Тогда 
			ЗаархивированоОбъектов = ЗаархивированоОбъектов + Результаты.Количество();
		Иначе //Очистить (выполняется повторно для уже очищенных, особый счетчик)
			ОчищеноОбъектов = Мин(ОбработаноОбъектов, ОчищеноОбъектов + Результаты.Количество());
		КонецЕсли;
		
		ОбновитьПрогресс(ОбработаноОбъектов + ЗаархивированоОбъектов + ОчищеноОбъектов, ВхПараметры.ВсегоОбъектов * 3);

		ВыполнитьАрхивацию_ИзвлечьИПереместитьДанные(Оценка, ВхПараметры);
		
		Возврат;
		
	Иначе //Выгрузка содержимого
		
		Результат = ВыполнитьАрхивацию_ИзвлечьАрхивируемыеДанные(АрхивируемыйЭлемент,, Архивировать, Очистить, КаталогДлинныхИмен, КаталогСокращений);
							
		НавСсылка = ПолучитьНавигационнуюСсылку(АрхивируемыйЭлемент.Ссылка);
		
		Если Не Результат Тогда				
			
			Если КаталогДлинныхИмен.ТолькоНовые.Количество() > 0 Тогда 
				СобраннаяИнформация.Вставить("Незавершенная", Истина);
				ЗафиксироватьИсториюАрхивации(СобраннаяИнформация);
			КонецЕсли;
					
			ВызватьИсключение 
				Новый ФорматированнаяСтрока("Не удалось получить архивируемые данные объекта", 
					Новый ФорматированнаяСтрока("Ссылка",,,, НавСсылка) 
				);
		КонецЕсли;
			
		//ЛогВыполнения.Добавить(">");
		//ЛогВыполнения.Добавить(АрхивируемыйЭлемент.Вид + " % " + АрхивируемыйЭлемент.Ссылка + " { " + НавСсылка + " }"); //Сред(АрхивируемыйЭлемент.Ссылка.УникальныйИдентификатор(),1, 13)
		//
		//Для Каждого Файлы Из АрхивируемыйЭлемент.АдресаАрхивируемых Цикл
		//	Если Файлы <> Неопределено Тогда 
		//		ЛогВыполнения.Добавить(Файлы.ПолныйПуть);
		//	КонецЕсли;
		//КонецЦикла;		
		
	КонецЕсли;
	
	ПараметрыПеремещенияФайлов = Новый Структура;
	ПараметрыПеремещенияФайлов.Вставить("АрхивируемыйЭлемент", АрхивируемыйЭлемент);
	ПараметрыПеремещенияФайлов.Вставить("Оценка", Оценка);
	ПараметрыПеремещенияФайлов.Вставить("ВхПараметры", ВхПараметры);
	
	ЗадержкаВыполнения = 0.1;
	
	// "Special" запуск для нормальной перерисовки формы процедуры ВыполнитьАрхивацию_ПереместитьДанныеВАрхивРекурсивно
	ПодключитьОбработчикОжидания("Подключаемый_ПереместитьФайлы", ЗадержкаВыполнения, Истина);
								
КонецПроцедуры

//*** 2 (восстановление)
&НаКлиенте
Процедура ВыполнитьВосстановление_НайтиИЗагрузитьДанные(Знач Оценка, ВхПараметры) Экспорт
	
	ОбработкаПрерыванияПользователя();
	Если ПрерватьВыполнение Тогда 
		ОбновитьПрогресс();
		Возврат;
	КонецЕсли;
			
	Если Оценка.Количество() = 0 Тогда				
		Контекст = Новый Структура;
		Контекст.Вставить("ПараметрыЗапуска", ВхПараметры);
	
		Оповещение = Новый ОписаниеОповещения("ВыполнитьАрхивациюВосстановлениеОбъектов_Продолжение", ЭтотОбъект, Контекст); //Переход к обработке следующей категории объектов
		ВыполнитьОбработкуОповещения(Оповещение);
		Возврат;
	КонецЕсли;
	
	ОтборПредметы = ПоследниеНастройкиВосстановления.Предметы; 
	АрхивируемыйЭлемент = Неопределено;
	
	Пока (Оценка.Количество() > 0) Цикл
		
		АрхивируемыйЭлемент = Оценка[Оценка.Количество()-1];
		Оценка.Удалить(Оценка.Количество()-1);
		
		Результат = ВыполнитьВосстановление_ОпределитьВосстанавливаемыеДанные(АрхивируемыйЭлемент, КаталогДлинныхИмен, КаталогСокращений, ОтборПредметы);
		
		Если (АрхивируемыйЭлемент.АдресаАрхивируемых.Количество() = 0) Тогда 
			
			ОбработаноОбъектов = ОбработаноОбъектов + 1;		
			ОбновитьПрогресс(ОбработаноОбъектов, ВхПараметры.ВсегоОбъектов);
			
			Продолжить;
		Иначе
			Прервать;
		КонецЕсли;

	КонецЦикла;
	
	Если (АрхивируемыйЭлемент = Неопределено) Или (АрхивируемыйЭлемент.АдресаАрхивируемых.Количество() = 0) Тогда 
		Контекст = Новый Структура;
		Контекст.Вставить("ПараметрыЗапуска", ВхПараметры);
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьАрхивациюВосстановлениеОбъектов_Продолжение", ЭтотОбъект, Контекст); //Переход к обработке следующей категории объектов
		ВыполнитьОбработкуОповещения(Оповещение);
		Возврат;
	КонецЕсли;

	//НавСсылка = ПолучитьНавигационнуюСсылку(АрхивируемыйЭлемент.Ссылка);
	//ЛогВыполнения.Добавить(АрхивируемыйЭлемент.Вид + " % " + АрхивируемыйЭлемент.Ссылка + " { " + НавСсылка + " }"); //Сред(АрхивируемыйЭлемент.Ссылка.УникальныйИдентификатор(),1, 13)
	//
	//Для Каждого Файлы Из АрхивируемыйЭлемент.АдресаАрхивируемых Цикл
	//	Если Файлы <> Неопределено Тогда 
	//		ЛогВыполнения.Добавить(Файлы.ПолныйПуть);
	//	КонецЕсли;
	//КонецЦикла;
	//
	//ЛогВыполнения.Добавить("<");
	
	ПараметрыПеремещенияФайлов = Новый Структура;
	ПараметрыПеремещенияФайлов.Вставить("АрхивируемыйЭлемент", АрхивируемыйЭлемент);
	ПараметрыПеремещенияФайлов.Вставить("Оценка", Оценка);
	ПараметрыПеремещенияФайлов.Вставить("ВхПараметры", ВхПараметры);
	
	ЗадержкаВыполнения = 0.1;
	
	// "Special" запуск для нормальной перерисовки формы
	ПодключитьОбработчикОжидания("Подключаемый_ВосстановитьФайлы", ЗадержкаВыполнения, Истина);
								
КонецПроцедуры

//*** 1
&НаСервере
Функция ВыполнитьАрхивацию_ВыбратьОснования(
				Знач Вид, 
				Знач ВыбранныеВидыОбъектов, 
				Знач ВыбранныеКонтролирующиеОрганы, 
				Знач ВыбранныеОрганизации, 
				Знач НачПериода, 
				Знач КонПериода, 
				Знач РежимВосстановления, 
				Знач РежимОчистки)
	
	КонтекстМодуля = РеквизитФормыВЗначение("Объект");
	
	ОтбиратьПоОрганизации = ВыбранныеОрганизации.Количество() <> 0;
	ОтбиратьПоПериоду = НачПериода <> '00010101' Или КонПериода <> '00010101';
	ОтбиратьПоКонтролирующемуОргану = ВыбранныеКонтролирующиеОрганы.Количество() <> 0;
	ОтбиратьПоВидуОбъектов = ВыбранныеВидыОбъектов.Количество() <> 0;
		
	ВсеОбъектыВида = Новый Массив;
	
	//Для каждого документа ТранспортноеСообщение найдём ассоциированные записи, поместим данные во временное хранилище, 
	//	вернём адреса на клиент для последующей поштучной обработки
	
	ДляАрхивации = Не РежимВосстановления;
	Если ДляАрхивации И РежимОчистки Тогда
		//В режиме очистки обрабатываемые объекты числятся в архиве, чтобы они попали в выборку
		//надо изменить признак отбора
		ДляАрхивации = Не ДляАрхивации;
	КонецЕсли;		
	
	Если Вид = "ТранспортныеКонтейнеры" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ТранспортныеКонтейнеры(ДляАрхивации));
	ИначеЕсли Вид = "СодержимоеТранспортныхКонтейнеров" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_СодержимоеТранспортныхКонтейнеров(ДляАрхивации));
	ИначеЕсли Вид = "ВложенияНеформализованныхДокументов" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ПерепискаСКО(ДляАрхивации));
	ИначеЕсли Вид = "ОтправкиРПН" Тогда 		
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ОтправкиРПН(ДляАрхивации));
	ИначеЕсли Вид = "ОтправкиФСС" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ОтправкиФСС(ДляАрхивации));
	ИначеЕсли Вид = "ОтправкиФТС" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ОтправкиФТС(ДляАрхивации));
	ИначеЕсли Вид = "ОтправкиФСРАР" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ОтправкиФСРАР(ДляАрхивации));
	ИначеЕсли Вид = "ОтветыНаЗапросыВыпискиИзЕГРЮЛ_ЕГРИП" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ЗапросНаВыпискуИзЕГРЮЛ_ЕГРИП(ДляАрхивации));
	ИначеЕсли Вид = "ОтветыНаЗапросыИОН" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ЗапросНаИОН(ДляАрхивации));
	ИначеЕсли Вид = "ОтветыНаЗапросыИОС" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ЗапросНаИОС(ДляАрхивации));
	ИначеЕсли Вид = "ХранилищеЭлектронныхПредставленийРегламентированныхОтчетов" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ЭлектронныеПредставленияРегламентированныхОтчетов(ДляАрхивации));
	ИначеЕсли Вид = "ФайлыДокументовРеализацииПолномочийНалоговыхОрганов" Тогда 
		Запрос = Новый Запрос(КонтекстМодуля.ТекстЗапроса_ДокументыРеализацииПолномочийНалоговыхОрганов(ДляАрхивации));
	Иначе
		Возврат ВсеОбъектыВида;
	КонецЕсли;
	
	Если ОтбиратьПоПериоду Тогда 
		Запрос.УстановитьПараметр("НачПериода", НачПериода);		
		
		Если КонПериода <> '00010101' Тогда 
			КонПериода = КонецДня(КонПериода);
		КонецЕсли;
		Запрос.УстановитьПараметр("КонПериода", КонПериода);
		
	Иначе
		Запрос.УстановитьПараметр("НачПериода", '00010101');
		Запрос.УстановитьПараметр("КонПериода", '00010101');
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ОтобратьОрганизации", ВыбранныеОрганизации);
	Запрос.УстановитьПараметр("НеИспользоватьОтборОрганизации", Не ОтбиратьПоОрганизации);
	
	Запрос.УстановитьПараметр("ОтобратьКонтролирующиеОрганы", ВыбранныеКонтролирующиеОрганы);
	Запрос.УстановитьПараметр("НеИспользоватьОтборПоКонтролирующемуОргану", Не ОтбиратьПоКонтролирующемуОргану);
	
	Запрос.УстановитьПараметр("ОтобратьВидыОбъектов", ВыбранныеВидыОбъектов);
	Запрос.УстановитьПараметр("НеИспользоватьОтборПоВидамОбъектов", Не ОтбиратьПоВидуОбъектов);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат ВсеОбъектыВида;
	КонецЕсли;
	
	ТабРезультат = РезультатЗапроса.Выгрузить();
	ТабРезультат.Свернуть("ИдентификаторГруппы, КонтролирующийОрган, Организация, Ссылка",);
	
	Для Каждого ВладелецЗаписи Из ТабРезультат Цикл
		
		ЭлементыАрхивируемого = Новый Структура("Ссылка, КонтролирующийОрган, АдресаАрхивируемых, Вид",,, Новый Массив);
		ЭлементыАрхивируемого.Вставить("ИдентификаторГруппы", ВладелецЗаписи.ИдентификаторГруппы);
		ЭлементыАрхивируемого.Вид = Вид;
		ЭлементыАрхивируемого.Ссылка = ВладелецЗаписи.Ссылка;
		ЭлементыАрхивируемого.КонтролирующийОрган = ВладелецЗаписи.КонтролирующийОрган;
		ЭлементыАрхивируемого.Вставить("Обработан", Ложь);
		ЭлементыАрхивируемого.Вставить("ЗавершеноСОшибкой", Ложь);
		ЭлементыАрхивируемого.Вставить("Организация");
		ЭлементыАрхивируемого.Вставить("ИндексВложения", -1);
		ЭлементыАрхивируемого.Организация = ВладелецЗаписи.Организация;
    				
		ВсеОбъектыВида.Добавить(ЭлементыАрхивируемого);
		
	КонецЦикла;
	
	Возврат ВсеОбъектыВида;
	
КонецФункции

//*** 0
//Обработка объектов выполняется в несколько этапов повторяющихся для каждой из организаций
// Первый запуск подсчет и оценка объектов
// Второй запуск непосредственно копирование объектов
// Третий запуск установка флага архивации и очистка хранилищ объектов
//
//	- Отбор с учетом фильтров, запускается для каждой организации отдельно
//	- На сервере размещение данных отобранных объектов во временном хранилище
//	- На клиенте перемещение данных из временного хранилища в каталог архива, очистка временного хранилища
//	- На сервере очистка данных успешно обработанных на клиенте, проставление отметок об архивировании, месте расположения архива
// Процедура перезапускается для каждой новой группы объектов
&НаКлиенте
Функция ВыполнитьАрхивациюВосстановлениеОбъектов(
				Знач Стадия = 0, 
				Знач ВыбранныеВидыОбъектов, 
				Знач ВыбранныеКонтролирующиеОрганы, 
				Знач ВыбранныеОрганизации, 
				Знач НачПериода = '00010101', 
				Знач КонПериода = '00010101', 
				Знач КаталогАрхива, 
				Знач РасширениеПодключено = Неопределено,
				Знач ВсегоОбъектов = Неопределено, 
				Знач РежимАрхивации = Ложь,
				Знач РежимОчистки = Ложь,
				Знач РежимВосстановления = Ложь
				)
				
	ОтбиратьПоВидуОбъектов = ВыбранныеВидыОбъектов.Количество() <> 0;
	//ОтбиратьПоКонтролирующемуОргану = ВыбранныеКонтролирующиеОрганы.Количество() <> 0;
	//ОтбиратьПоОрганизации = ВыбранныеОрганизации.Количество() <> 0;
	//ОтбиратьПоПериоду = НачПериода <> '00010101' Или КонПериода <> '00010101';
	
	ВхПараметры = Новый Структура; //Используется для запуска повторных рекурсивных вызовов
	ВхПараметры.Вставить("Стадия", Стадия);
	ВхПараметры.Вставить("ВыбранныеВидыОбъектов", ВыбранныеВидыОбъектов);
	ВхПараметры.Вставить("ВыбранныеКонтролирующиеОрганы", ВыбранныеКонтролирующиеОрганы);
	ВхПараметры.Вставить("ВыбранныеОрганизации", ВыбранныеОрганизации);
	ВхПараметры.Вставить("НачПериода", НачПериода);
	ВхПараметры.Вставить("КонПериода", КонПериода);
	ВхПараметры.Вставить("КаталогАрхива", КаталогАрхива);
	ВхПараметры.Вставить("РасширениеПодключено", РасширениеПодключено);
	ВхПараметры.Вставить("РежимАрхивации", РежимАрхивации);
	ВхПараметры.Вставить("РежимОчистки", РежимОчистки);
	ВхПараметры.Вставить("РежимВосстановления", РежимВосстановления);
	
	//ВсегоОбъектов = Неопределено только для первого прохода, для последующих содержит число родительских объектов которые необходимо обработать
	Если ВсегоОбъектов = Неопределено Тогда
		ВсегоОбрабатываемыхОбъектов = 0;
		ОбработаноОбъектов = 0;	//Инкрементируется после обработки всех связанных записей с родительским объектом	
		ЗаархивированоОбъектов = 0;
		ОчищеноОбъектов = 0;
	Иначе
		ВхПараметры.Вставить("ВсегоОбъектов", ВсегоОбъектов);
	КонецЕсли;
	
	ПорядокОбхода = ПолучитьПорядокОбходаОбъектов();
	
	//Обходим все виды объектов, выбираем родительские объекты с учетом фильтров и перемещаем связанные с ними элементы и записи в архив
	Для ИндексВида = Стадия по ПорядокОбхода.Количество() - 1 Цикл
		
		ВидОбъекта = ПорядокОбхода.Получить(ИндексВида);
						
		Если РежимВосстановления Или ТолькоВыгрузка Тогда
			Если (ВидОбъекта = "ВыполнитьАрхивацию") Или (ВидОбъекта = "ВыполнитьОчистку") Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
				
		Если Не РежимОчистки И Не РежимАрхивации И ВидОбъекта = "ВыполнитьАрхивацию" Тогда
		//Это искуственный вид объектов, в конце второго прохода запускает этап архивации скопированных элементов и записей
			
			Если ВсегоОбъектов = Неопределено Тогда
				Продолжить;
			Иначе
				
				ОбновитьНадписиПрогресса(, 1);
				
				//Пройдемся по всем объектам организации ещё раз в режиме архивации
				ВыполнитьАрхивациюВосстановлениеОбъектов(
					0, 
					ВыбранныеВидыОбъектов, 
					ВыбранныеКонтролирующиеОрганы, 
					ВыбранныеОрганизации, 
					НачПериода, 
					КонПериода, 
					КаталогАрхива,, 
					ВсегоОбъектов,
					Истина);

			КонецЕсли;		
			
			Возврат Неопределено;
			
		ИначеЕсли Не РежимОчистки И ВидОбъекта = "ВыполнитьОчистку" Тогда
		//Это искуственный вид объектов, в конце прохода архивации запускает этап очистки элементов и записей
			
			Если ВсегоОбъектов = Неопределено Тогда
				Продолжить;
			Иначе
				
				ОбновитьНадписиПрогресса(, 2);
				
				//Пройдемся по всем объектам организации ещё раз в режиме очистки
				ВыполнитьАрхивациюВосстановлениеОбъектов(
					0, 
					ВыбранныеВидыОбъектов, 
					ВыбранныеКонтролирующиеОрганы, 
					ВыбранныеОрганизации, 
					НачПериода, 
					КонПериода, 
					КаталогАрхива,, 
					ВсегоОбъектов,
					, Истина);

			КонецЕсли;		
				
			Возврат Неопределено;
			
		КонецЕсли;
	
		Если Стадия < ИндексВида + 1 Тогда
			
			Оценка = ВыполнитьАрхивацию_ВыбратьОснования(
						ВидОбъекта, 
						ВыбранныеВидыОбъектов, 
						ВыбранныеКонтролирующиеОрганы, 
						ВыбранныеОрганизации, 
						НачПериода, 
						КонПериода, 
						РежимВосстановления,
						РежимОчистки);
			
			ВхПараметры.Вставить("Стадия", ИндексВида + 1);
			
			Если ВсегоОбъектов = Неопределено Тогда
				//На первом проходе просто собираем информацию о количестве родительских объектов
				ВсегоОбрабатываемыхОбъектов = ВсегоОбрабатываемыхОбъектов + Оценка.Количество();
			Иначе
				//Родительских объектов этого вида может не оказаться
				Если Оценка.Количество() > 0 Тогда
					
					//подсчет фактически заархивированных объектов в разрезе КО и ВО
					Если Не РежимАрхивации И Не РежимОчистки И Не РежимВосстановления Тогда
						Для Каждого ЭлОценки Из Оценка Цикл 
							
							Для Каждого ИнфоКО Из СобраннаяИнформация.КонтролирующиеОрганы Цикл 
								Если ИнфоКО.Орган = ЭлОценки.КонтролирующийОрган Тогда 
									ИнфоКО.КоличествоОбъектов = ИнфоКО.КоличествоОбъектов + 1;
									Прервать;
								КонецЕсли;
							КонецЦикла;	
							
							Для Каждого ИнфоВО Из СобраннаяИнформация.ВидыОбъектов Цикл 
								Если ИнфоВО.Идентификатор = ЭлОценки.ИдентификаторГруппы Тогда 
									ИнфоВО.КоличествоОбъектов = ИнфоВО.КоличествоОбъектов + 1;
									Прервать;
								КонецЕсли;
							КонецЦикла;	
							
						КонецЦикла;	
					КонецЕсли;
				
					Если РежимВосстановления Тогда 						
						ВыполнитьВосстановление_НайтиИЗагрузитьДанные(Оценка, ВхПараметры);
					Иначе						
						ВыполнитьАрхивацию_ИзвлечьИПереместитьДанные(Оценка, ВхПараметры);
					КонецЕсли;
					
					Возврат Неопределено;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВсегоОбъектов = Неопределено Тогда
		Возврат ВсегоОбрабатываемыхОбъектов;
	Иначе
		
		Если Не РежимВосстановления Тогда
			Для Каждого ИнфоОрг Из СобраннаяИнформация.Организации Цикл 
				Если ИнфоОрг.Организация = ВыбранныеОрганизации[0] Тогда 
					ИнфоОрг.ОбъектовОбработано = ИнфоОрг.ОбъектовОтобрано;
					Прервать;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
			
		Если ОбработаноОбъектов = ВсегоОбъектов Или ОсталосьОбработатьОрганизации.Количество() = 0 Тогда //Полное завершение выполнения
			
			Если Не РежимВосстановления Тогда
				//ЗаписатьКаталогДлинныхИмен();
				ЗафиксироватьИсториюАрхивации(СобраннаяИнформация);
			КонецЕсли;
			
			ОбновитьПрогресс(,, Не РежимВосстановления);
			
			Если Не РежимВосстановления Тогда
				Элементы.АрхивироватьВсе.Доступность = Истина;
				ОтметитьФильтрПриИзменении(Неопределено);
				АнализироватьСодержимое(Неопределено);
			КонецЕсли;
			Элементы.Восстановить.Доступность = Истина;
						
		Иначе
								
			//ЗафиксироватьИсториюАрхивации(СобраннаяИнформация);
			
			Если ОсталосьОбработатьОрганизации.Количество() > 0 Тогда 
				
				ВыбраннаяОрганизация = Новый Массив;
				ВыбраннаяОрганизация.Добавить(ОсталосьОбработатьОрганизации[0].Ссылка);
				ОбновитьНадписиПрогресса(ОсталосьОбработатьОрганизации[0], ?(РежимВосстановления, 10, 0));
				ОсталосьОбработатьОрганизации.Удалить(0);
				
				ВыполнитьАрхивациюВосстановлениеОбъектов( //Запустим архивацию/восстановление по следующей организации из списка
					0, 
					ВыбранныеВидыОбъектов, 
					ВыбранныеКонтролирующиеОрганы, 
					ВыбраннаяОрганизация, 
					НачПериода, 
					КонПериода, 
					КаталогАрхива,, 
					ВсегоОбъектов,
					,, РежимВосстановления);
		
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область СовместимостьРелизов

// Возвращает значение перечисления по имени, если оно есть в конфигурации.
//
// Параметры:
//   ИмяПеречисления - Строка - имя перечисления, например "ТипыКонтролирующихОрганов".
//   ИмяЗначения - Строка - имя значения перечисления.
//
// Возвращаемое значение:
//   ПеречислениеСсылка, Неопределено - Неопределено, если значения нет в этом релизе.
//
&НаСервере
Функция ЗначениеПеречисленияПоИмени(ИмяПеречисления, ИмяЗначения)
	
	Значения = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления;
	Если Значения.Найти(ИмяЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
	
КонецФункции

#КонецОбласти