&НаСервереБезКонтекста
Функция РеквизитыВыборкой(СпрСсылка, Знач Выгрузить = Ложь)
	
	СправочникиИПоля = ПолучитьВыгружаемыеПоляСправочников();		
	ВидСправочника = СпрСсылка.Метаданные().Имя;
	ПоляСпр = СправочникиИПоля.Получить(ВидСправочника);
	Запрос = Новый Запрос;
	
	Шаблон = "ВЫБРАТЬ Отправки.Ссылка КАК Ссылка, Отправки.%1 КАК Данные, ""%2"" КАК ИмяФайла, ""%4"" КАК Реквизит Из Справочник.%3 КАК Отправки ГДЕ Отправки.Ссылка = &СпрСсылка";
	Текст = "";
	Для Каждого Поле Из ПоляСпр Цикл 
		Текст = Текст + ?(Текст = "", "", "
		|ОБЪЕДИНИТЬ ВСЕ
		|");
		
		ТекстЗапроса = СтрЗаменить(Шаблон, "%1", Поле.Реквизит);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%2", Поле.ИмяФайла);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%3", ВидСправочника);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%4", Поле.Реквизит);
		
		Текст = Текст + ТекстЗапроса;
	КонецЦикла;
	
	Запрос.Текст = Текст;
	
	Запрос.Параметры.Вставить("СпрСсылка", СпрСсылка);
	Результат = Запрос.Выполнить();	
	
	Если Выгрузить Тогда 
		Возврат Результат.Выгрузить();
	КонецЕсли;
	
	Возврат Результат.Выбрать();
	
КонецФункции

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ФормаПрогресса_ПриОстановкеВыполнения(УспешноеЗавершение, ДополнительныеПараметры) Экспорт
	
	ПрерватьВыполнение = Истина;
	Элементы.АрхивироватьВсе.Доступность = Истина;
	Элементы.Восстановить.Доступность = Истина;
	Если (ДополнительныеПараметры.Архивирование) И (Не УспешноеЗавершение) Тогда 
		СобраннаяИнформация.Вставить("Незавершенная", Истина);
		ЗафиксироватьИсториюАрхивации(СобраннаяИнформация);
	КонецЕсли;	
	ОтметитьФильтрПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура Настройка_ПослеЗакрытия(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) = Тип("Структура") Тогда //Была нажата ОК
		ПоследниеНастройкиВосстановления = РезультатЗакрытия;
		
		Если ДополнительныеПараметры.ЗапуститьВосстановление Тогда
			Восстановить(Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеВАрхив_ПроверкаПередСозданиемКаталога(Существует, ВхПараметры) Экспорт
	
	Если Существует Тогда 
		ПереместитьДанныеВАрхив_ЗаписатьФайлПослеСозданияКаталога(ВхПараметры.НовыйФайл.Каталог, ВхПараметры);
	Иначе 
		Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеВАрхив_ЗаписатьФайлПослеСозданияКаталога", ЭтотОбъект, ВхПараметры, "ПереместитьДанныеВАрхив_ЗаписатьФайлПослеСозданияКаталогаПриОшибке", ЭтотОбъект);
		НачатьСозданиеКаталога(Оповещение1, ВхПараметры.НовыйФайл.Каталог);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеВАрхив_ЗаписатьФайлПослеСозданияКаталога(ИмяКаталога, ВхПараметры) Экспорт
	
	Данные = ПолучитьИзВременногоХранилища(ВхПараметры.НовыйФайл.Адрес);
		
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда 
		Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеВАрхив_ПослеЗаписиДвоичныхДанных", ЭтотОбъект, ВхПараметры);
		Данные.НачатьЗапись(Оповещение1, ВхПараметры.НовыйФайл.ПолныйПуть);	
	Иначе
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(Данные);
		Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеВАрхив_ПослеЗаписиТекстовыхДанных", ЭтотОбъект, ВхПараметры);
		Текст.НачатьЗапись(Оповещение1, ВхПараметры.НовыйФайл.ПолныйПуть, КодировкаТекста.UTF8, "");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеВАрхив_ЗаписатьФайлПослеСозданияКаталогаПриОшибке(ИнформацияОбОшибке, РезультатЧегото, ВхПараметры) Экспорт
	
	Данные = ПолучитьИзВременногоХранилища(ВхПараметры.НовыйФайл.Адрес);
		
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда 
		Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеВАрхив_ПослеЗаписиДвоичныхДанных", ЭтотОбъект, ВхПараметры, "ПереместитьДанныеВАрхив_ПослеЗаписиДвоичныхДанныхПриОшибке", ЭтотОбъект);
		Данные.НачатьЗапись(Оповещение1, ВхПараметры.НовыйФайл.ПолныйПуть);	
	Иначе
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(Данные);
		Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеВАрхив_ПослеЗаписиТекстовыхДанных", ЭтотОбъект, ВхПараметры);
		Текст.НачатьЗапись(Оповещение1, ВхПараметры.НовыйФайл.ПолныйПуть, КодировкаТекста.UTF8, "");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеВАрхив_ПослеЗаписиТекстовыхДанных(Результат, ВхПараметры) Экспорт
	
	УдалитьИзВременногоХранилища(ВхПараметры.НовыйФайл.Адрес);
	ВыполнитьАрхивацию_ПереместитьДанныеВАрхивРекурсивно(ВхПараметры.ОповещениеЗавершения, ВхПараметры.ОбрабатываемыйОбъект, ВхПараметры.ОставшиесяОбъекты)
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеВАрхив_ПослеЗаписиДвоичныхДанных(ВхПараметры) Экспорт
	
	УдалитьИзВременногоХранилища(ВхПараметры.НовыйФайл.Адрес);
	ВыполнитьАрхивацию_ПереместитьДанныеВАрхивРекурсивно(ВхПараметры.ОповещениеЗавершения, ВхПараметры.ОбрабатываемыйОбъект, ВхПараметры.ОставшиесяОбъекты)
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеИзАрхива_ПослеЧтенияТекстовыхДанных(ВхПараметры) Экспорт
	
	Текст = ВхПараметры.ТекстовыйДокумент;
	ВхПараметры.НовыйФайл.Адрес = ПоместитьВоВременноеХранилище(Текст.ПолучитьТекст(), ЭтотОбъект.УникальныйИдентификатор);
	ВхПараметры.Удалить("ТекстовыйДокумент");
	ВыполнитьВосстановление_ПереместитьДанныеИзАрхиваРекурсивно(ВхПараметры.ОповещениеЗавершения, ВхПараметры.ОбрабатываемыйОбъект, ВхПараметры.ОставшиесяОбъекты)
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеИзАрхива_ПроверкаСуществованияФайла(Существует, ВхПараметры) Экспорт
	
	Если Существует Тогда 
		Если ВхПараметры.НовыйФайл.ЧитатьКакДД Тогда 
			ДД = Новый ДвоичныеДанные(ВхПараметры.НовыйФайл.ПолныйПуть);
		Иначе
			Текст = Новый ТекстовыйДокумент;
			ВхПараметры.Вставить("ТекстовыйДокумент", Текст);
			Оповещение1 = Новый ОписаниеОповещения("ПереместитьДанныеИзАрхива_ПослеЧтенияТекстовыхДанных", ЭтотОбъект, ВхПараметры);
			Текст.НачатьЧтение(Оповещение1, ВхПараметры.НовыйФайл.ПолныйПуть, КодировкаТекста.UTF8, "");		
			Возврат;
		КонецЕсли;		
		ВхПараметры.НовыйФайл.Адрес = ПоместитьВоВременноеХранилище(ДД, ЭтотОбъект.УникальныйИдентификатор);
	Иначе
		//ЛогВыполнения.Добавить("Не найден!");
		ВхПараметры.НовыйФайл.Вставить("НеНайден", Истина);
		ВхПараметры.ОбрабатываемыйОбъект.ЗавершеноСОшибкой = Истина;
	КонецЕсли;
	
	ВыполнитьВосстановление_ПереместитьДанныеИзАрхиваРекурсивно(ВхПараметры.ОповещениеЗавершения, ВхПараметры.ОбрабатываемыйОбъект, ВхПараметры.ОставшиесяОбъекты)
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьДанныеВАрхив_ПослеЗаписиДвоичныхДанныхПриОшибке(ИнформацияОбОшибке, РезультатЧегото, ВхПараметры) Экспорт
	
	ВыполнитьАрхивацию_ПереместитьДанныеВАрхивРекурсивно(ВхПараметры.ОповещениеЗавершения, ВхПараметры.ОбрабатываемыйОбъект, ВхПараметры.ОставшиесяОбъекты)
	
КонецПроцедуры

