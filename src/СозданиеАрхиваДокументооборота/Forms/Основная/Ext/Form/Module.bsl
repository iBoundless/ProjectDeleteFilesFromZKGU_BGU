#Область ГлобальныеПеременные

&НаКлиенте
Перем ОбработаноОбъектов, ЗаархивированоОбъектов, ОчищеноОбъектов, ПрерватьВыполнение, ПараметрыЗапускаАрхивации, ПараметрыПеремещенияФайлов;

&НаКлиенте
Перем ОсталосьОбработатьОрганизации, ТекущаяОбрабатываемаяОрганизация, ОрганизацииПоследнейОценки;

&НаКлиенте
Перем КаталогДлинныхИмен, СобраннаяИнформация;

&НаКлиенте
Перем КаталогСокращений;

&НаКлиенте
Перем ПоследняяЗагруженнаяИстория, ПоследниеНастройкиВосстановления;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не РазрешитьОткрытиеФормы() Тогда 
		Сообщение = НСтр("ru = 'У Вас недостаточно прав для запуска этой обработки'");
		ПоказатьПредупреждение(, Сообщение,, НСтр("ru = 'Недостаточно прав'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	#Если ВебКлиент Тогда 
		Сообщение = НСтр("ru = 'Использование данной функции в web-клиенте невозможно'");
		ПоказатьПредупреждение(, Сообщение,, НСтр("ru = 'Неправильный клиент'"));
		Отказ = Истина;
		Возврат;
	#КонецЕсли
	
	ОпределитьПериодАрхивации(); //Тут, поскольку автонастройка ешё не загрузилась ПриСозданииНаСервере
	
	ОграничитьПериодПриИзменении(Неопределено);
	ОграничитьОрганизацииПриИзменении(Неопределено);
	ОтметитьФильтрПриИзменении(Неопределено);
	
	АнализироватьСодержимое(Неопределено);
			
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступенБанкРоссии = Ложь; //Метаданные.Справочники.Найти("ОтправкиБанкРоссии") <> Неопределено;
	
	ВсеОрганизации = Справочники.Организации.Выбрать();
	ВсегоОрганизаций = 0;
	ОграничениеОрганизаций = 10; //Максимум до которого организации выводятся в одну колонку
	КолонкиОрганизаций = Новый Массив;
	
	Для Каждого Вложенный Из Элементы.ГруппаВерстка0.ПодчиненныеЭлементы Цикл 
		Если ТипЗнч(Вложенный) = Тип("ГруппаФормы") Тогда 
			КолонкиОрганизаций.Добавить(Вложенный);
			Для ш = 0 по Вложенный.ПодчиненныеЭлементы.Количество()-1 Цикл 
				Элементы.Удалить(Вложенный.ПодчиненныеЭлементы[0]);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
			
	ИндексОрганизации = 0;
	Пока ВсеОрганизации.Следующий() Цикл 
		ВсегоОрганизаций = ВсегоОрганизаций + 1;
	КонецЦикла;	
	
	Пока ВсеОрганизации.Следующий() Цикл		
		Представление = ПредставлениеОрганизации(ВсеОрганизации.Ссылка);
		Если ВсегоОрганизаций > ОграничениеОрганизаций Тогда 
			ШтукВКолонке = Окр(ВсегоОрганизаций / КолонкиОрганизаций.Количество(), 0, 1);
			ИндексКолонки = Цел(ИндексОрганизации / ШтукВКолонке);
			ГруппаРодительОрганизаций = КолонкиОрганизаций[Мин(ИндексКолонки, КолонкиОрганизаций.Количество()-1)];
		Иначе
			ГруппаРодительОрганизаций = Элементы.ГруппаДинамическиеЭлементыОрганизации;
		КонецЕсли;
		Имя = ДобавитьПереключательФормы(Представление, ГруппаРодительОрганизаций, "ФильтрОрг");
		ФильтрОрг.Добавить(ВсеОрганизации.Ссылка, Представление, Не ВсеОрганизации.ПометкаУдаления);
		ИндексОрганизации = ИндексОрганизации + 1;
	КонецЦикла;
	
	//ЗагрузитьПользовательскуюНастройкуЗаполненияПолейФормы();
	ПредставлениеФильтраОрг = ПолучитьПредставлениеФильтраОрганизаций(ФильтрОрг);
	
	//Заполнение чекбоксов фильтра по контролирующим органам
	Для Сч = 0 По Перечисления.ТипыКонтролирующихОрганов.Количество()-1 Цикл 
		КонтролирующийОрган = Перечисления.ТипыКонтролирующихОрганов[Сч];
		// В разных релизах значение называется БанкРоссии, УдалитьБанкРоссии или ЦБ.
		// Обращаемся по имени через метаданные, чтобы не получить «Поле объекта не обнаружено».
		Если КонтролирующийОрган = ЗначениеПеречисленияПоИмени("ТипыКонтролирующихОрганов", "БанкРоссии")
			Или КонтролирующийОрган = ЗначениеПеречисленияПоИмени("ТипыКонтролирующихОрганов", "УдалитьБанкРоссии")
			Или КонтролирующийОрган = ЗначениеПеречисленияПоИмени("ТипыКонтролирующихОрганов", "ЦБ") Тогда 
			Продолжить;
		КонецЕсли;		
		Имя = ДобавитьПереключательФормы(Строка(КонтролирующийОрган), Элементы.ГруппаКонтролирующиеОрганы, "ФильтрКО");		
		ФильтрКО.Добавить(КонтролирующийОрган, Строка(КонтролирующийОрган), Истина);
	КонецЦикла;
	
	//Заполнение чекбоксов фильтра по видам объектов
	ВидыОбъектов = ПолучитьПользовательскиеНазванияГрупп();	
	Для Каждого ВидОбъекта Из ВидыОбъектов Цикл 
		Если ВидОбъекта.Ключ = 99 Тогда 
			Продолжить;
		КонецЕсли;
		ПредставлениеГруппы = ВидОбъекта.Значение;
		ПометкаЧекбокса = Истина;
		Имя = ДобавитьПереключательФормы(ПредставлениеГруппы, Элементы.ГруппаВидыОбъектов, "ФильтрВО");
		ФильтрВО.Добавить(ВидОбъекта.Ключ, ПредставлениеГруппы, ПометкаЧекбокса);
	КонецЦикла;
		
	Элементы.ГруппаФильтрОрганизаций.Видимость = Истина;
	Элементы.ГруппаКУдалению0.Видимость = Ложь; //Убрать совсем?
	
	Если ФильтрОрг.Количество() = 1 Тогда 
		ОграничитьОрганизации = Ложь;
		Элементы.ГруппаФильтрОрганизаций.Видимость = Ложь;
	КонецЕсли;
	
	АктуализироватьНадписиБэкапа();
		
	ТолькоВыгрузка = Истина;
			
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда 
		Возврат;
	КонецЕсли;
			
	Если ФильтрОрг.Количество() = 1 Тогда 
		Настройки.Вставить("ОграничитьОрганизации", Ложь);
		ОграничитьОрганизации = Ложь;
		Элементы.ГруппаФильтрОрганизаций.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПодключаемые

&НаКлиенте
Процедура Подключаемый_ПереместитьФайлы() Экспорт
	
	АрхивируемыйЭлемент = ПараметрыПеремещенияФайлов.АрхивируемыйЭлемент;
	Оценка = ПараметрыПеремещенияФайлов.Оценка;
	ВхПараметры = ПараметрыПеремещенияФайлов.ВхПараметры;
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьАрхивацию_ИзвлечьИПереместитьДанные", ЭтотОбъект, ВхПараметры);
	ВыполнитьАрхивацию_ПереместитьДанныеВАрхивРекурсивно(Оповещение, АрхивируемыйЭлемент, Оценка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВосстановитьФайлы() Экспорт
	
	АрхивируемыйЭлемент = ПараметрыПеремещенияФайлов.АрхивируемыйЭлемент;
	Оценка = ПараметрыПеремещенияФайлов.Оценка;
	ВхПараметры = ПараметрыПеремещенияФайлов.ВхПараметры;
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьВосстановление_НайтиИЗагрузитьДанные", ЭтотОбъект, ВхПараметры);
	ВыполнитьВосстановление_ПереместитьДанныеИзАрхиваРекурсивно(Оповещение, АрхивируемыйЭлемент, Оценка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗапуститьАрхивацию() Экспорт
	
	Стадия_ = ПараметрыЗапускаАрхивации.Стадия;
	ВыбранныеВидыОбъектов_ = ПараметрыЗапускаАрхивации.ВыбранныеВидыОбъектов;
	ВыбранныеКонтролирующиеОрганы_ = ПараметрыЗапускаАрхивации.ВыбранныеКонтролирующиеОрганы;
	ВыбранныеОрганизации_ = ПараметрыЗапускаАрхивации.ВыбранныеОрганизации;
	НачПериода_ = ПараметрыЗапускаАрхивации.НачПериода;
	КонПериода_ = ПараметрыЗапускаАрхивации.КонПериода;
	КаталогАрхива_ = ПараметрыЗапускаАрхивации.КаталогАрхива;
	//ПараметрыЗапускаАрхивации.РасширениеПодключено;
	//ПараметрыЗапускаАрхивации.ВсегоОбъектов;
	
	СобраннаяИнформация = Новый Структура;	
	
	СобраннаяИнформация.Вставить("ТолькоВыгрузка", ТолькоВыгрузка);
	СобраннаяИнформация.Вставить("ДатаСоздания", Неопределено);
	СобраннаяИнформация.Вставить("Каталог", СокрЛП(КаталогАрхива));
	СобраннаяИнформация.Вставить("Пользователь", ИмяПользователя());
	СобраннаяИнформация.Вставить("Начало", НачПериода_);
	СобраннаяИнформация.Вставить("Окончание", КонПериода_);
		
	#Если Не ВебКлиент Тогда 
	СобраннаяИнформация.Вставить("ИмяКомпьютера", ИмяКомпьютера());
	#КонецЕсли

	СобраннаяИнформация.Вставить("КонтролирующиеОрганы", Новый Массив);
	СобраннаяИнформация.Вставить("Организации", Новый Массив);
	СобраннаяИнформация.Вставить("ВидыОбъектов", Новый Массив);
	
	Для Каждого КО Из ВыбранныеКонтролирующиеОрганы_ Цикл 
		СобраннаяИнформация.КонтролирующиеОрганы.Добавить(Новый Структура("Орган, КоличествоОбъектов", КО, 0));
	КонецЦикла;
	
	Для Каждого ВО Из ВыбранныеВидыОбъектов_ Цикл 
		СобраннаяИнформация.ВидыОбъектов.Добавить(Новый Структура("Идентификатор, КоличествоОбъектов", ВО, 0));
	КонецЦикла;
	
	Если ВыбранныеОрганизации_.Количество() = 0 Тогда
		Для Каждого Орг Из ФильтрОрг Цикл 
			ОргИнфо = Новый Структура("Организация, ОбъектовОтобрано, ОбъектовОбработано", Орг.Значение, 0, 0);
			СобраннаяИнформация.Организации.Добавить(ОргИнфо);
		КонецЦикла;
	Иначе
		Для Каждого Орг Из ВыбранныеОрганизации_ Цикл 
			ОргИнфо = Новый Структура("Организация, ОбъектовОтобрано, ОбъектовОбработано", Орг, 0, 0);
			СобраннаяИнформация.Организации.Добавить(ОргИнфо);
		КонецЦикла;
	КонецЕсли;
	
	ВхПараметры  = Новый Структура;
	ВхПараметры.Вставить("Архивирование", Истина);
	ВхПараметры.Вставить("Восстановление", Ложь);
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ФормаПрогресса_ПриОстановкеВыполнения", ЭтотОбъект, ВхПараметры);
	ОткрытьФорму("ВнешняяОбработка.СозданиеАрхиваДокументооборота.Форма.ФормаПрогресс",,,,,, ОповещениеЗакрытия);
	
	//Архивация
	ВсегоОбъектов = ВыполнитьАрхивациюВосстановлениеОбъектов(
						Стадия_, 
						ВыбранныеВидыОбъектов_, 
						ВыбранныеКонтролирующиеОрганы_, 
						ВыбранныеОрганизации_, 
						НачПериода_, 
						КонПериода_, 
						КаталогАрхива_);
	
	ОсталосьОбработатьОрганизации = Новый Массив;
	Для Каждого Орг из ОрганизацииПоследнейОценки Цикл 
		Если ОграничитьОрганизации Тогда 
			Элем = ФильтрОрг.НайтиПоЗначению(Орг.Ссылка);
			Если Не Элем.Пометка Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ОсталосьОбработатьОрганизации.Добавить(Орг);
		Для Каждого ИнфоОрг Из СобраннаяИнформация.Организации Цикл 
			Если ИнфоОрг.Организация = Орг.Ссылка Тогда 
				ИнфоОрг.ОбъектовОтобрано = Орг.КоличествоИтого;
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	Если ОсталосьОбработатьОрганизации.Количество() = 0 Тогда 
		ОбновитьПрогресс();
		Возврат;
	КонецЕсли;
	
	ЗаполнитьУИДы(СобраннаяИнформация);
	//ЗафиксироватьИсториюАрхивации(СобраннаяИнформация);
	
	//Возврат;
	
	ВыбраннаяОрганизация = Новый Массив;
	ВыбраннаяОрганизация.Добавить(ОсталосьОбработатьОрганизации[0].Ссылка);
	ОбновитьНадписиПрогресса(ОсталосьОбработатьОрганизации[0]);
	ОсталосьОбработатьОрганизации.Удалить(0);
	
	//Архивация
	ВыполнитьАрхивациюВосстановлениеОбъектов( //Запустим первую из списка
		Стадия_, 
		ВыбранныеВидыОбъектов_, 
		ВыбранныеКонтролирующиеОрганы_, 
		ВыбраннаяОрганизация, 
		НачПериода_, 
		КонПериода_, 
		КаталогАрхива_,, 
		ВсегоОбъектов);
	
КонецПроцедуры
	
&НаКлиенте
Процедура Подключаемый_ЗапуститьВосстановление() Экспорт
	
	Стадия_ = ПараметрыЗапускаАрхивации.Стадия;
	ВыбранныеВидыОбъектов_ = ПараметрыЗапускаАрхивации.ВыбранныеВидыОбъектов;
	ВыбранныеКонтролирующиеОрганы_ = ПараметрыЗапускаАрхивации.ВыбранныеКонтролирующиеОрганы;
	ВыбранныеОрганизации_ = ПараметрыЗапускаАрхивации.ВыбранныеОрганизации;
	НачПериода_ = ПараметрыЗапускаАрхивации.НачПериода;
	КонПериода_ = ПараметрыЗапускаАрхивации.КонПериода;
	КаталогАрхива_ = ПараметрыЗапускаАрхивации.КаталогАрхива;
	
	ВхПараметры  = Новый Структура;
	ВхПараметры.Вставить("Восстановление", Истина);
	ВхПараметры.Вставить("Архивирование", Ложь);
	ОповещениеЗакрытия = Новый ОписаниеОповещения("ФормаПрогресса_ПриОстановкеВыполнения", ЭтотОбъект, ВхПараметры);
	ОткрытьФорму("ВнешняяОбработка.СозданиеАрхиваДокументооборота.Форма.ФормаПрогресс",,,,,, ОповещениеЗакрытия);
	
	//Восстановление, предварительный подсчет объектов
	ВсегоОбъектов = ВыполнитьАрхивациюВосстановлениеОбъектов(
						Стадия_, 
						ВыбранныеВидыОбъектов_, 
						ВыбранныеКонтролирующиеОрганы_, 
						ВыбранныеОрганизации_, 
						НачПериода_, 
						КонПериода_, 
						КаталогАрхива_,
						,,,, Истина);
	
	Если ВсегоОбъектов = 0 Тогда 
		ОбновитьПрогресс(,, Ложь);
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеОрганизации_.Количество() = 0 Тогда 
		Для Каждого Орг Из ФильтрОрг Цикл 
			ВыбранныеОрганизации_.Добавить(Орг.Значение);			
		КонецЦикла;
	КонецЕсли;
	
	ОсталосьОбработатьОрганизации = Новый Массив;
	Для Каждого Орг из ВыбранныеОрганизации_ Цикл 
		
		Описание = Новый Структура("Ссылка", Орг);
		Описание.Вставить("Название", "");
		Описание.Вставить("УникальныйИдентификатор", "");
		Описание.Вставить("ЯвляетсяИП", Ложь);
		Описание.Вставить("РазмерИтого", 0);
		Описание.Вставить("КоличествоИтого", 0);
		
		ОсталосьОбработатьОрганизации.Добавить(Описание);
	КонецЦикла;
	
	ДополнитьОписаниеОрганизаций(ОсталосьОбработатьОрганизации);
	
	Если ОсталосьОбработатьОрганизации.Количество() = 0 Тогда 
		ОбновитьПрогресс(,, Ложь);
		Возврат;
	КонецЕсли;

	ВыбраннаяОрганизация = Новый Массив;
	ВыбраннаяОрганизация.Добавить(ОсталосьОбработатьОрганизации[0].Ссылка);
	ОбновитьНадписиПрогресса(ОсталосьОбработатьОрганизации[0], 10);
	ОсталосьОбработатьОрганизации.Удалить(0);
	
	//Восстановление
	ВыполнитьАрхивациюВосстановлениеОбъектов( //Запустим первую из списка
		Стадия_, 
		ВыбранныеВидыОбъектов_, 
		ВыбранныеКонтролирующиеОрганы_, 
		ВыбраннаяОрганизация, 
		НачПериода_, 
		КонПериода_, 
		КаталогАрхива_,, 
		ВсегоОбъектов,,, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовУправленияФормы

&НаСервере
Процедура АктуализироватьНадписиБэкапа()
	
	Т1 = "ru = 'Перед выполнением %1 %2 выполнить резервное копирование данных информационной базы'";
	
	ТекстАрхивация = СтрЗаменить(Т1, "%1", "архивирования");
	ТекстВосстановление = СтрЗаменить(Т1, "%1", "восстановления объектов");
		
	Если РежимРаботы() = 1 Тогда		
		ТекстАрхивация = СтрЗаменить(ТекстАрхивация, "%2", "настоятельно рекомендуется");
		ТекстВосстановление = СтрЗаменить(ТекстВосстановление, "%2", "настоятельно рекомендуется");
		
		Элементы.ДекорацияБэкапАрхивация.Заголовок = НСтр(ТекстАрхивация);
		Элементы.ДекорацияБэкапВосстановление.Заголовок = НСтр(ТекстВосстановление);
	Иначе		
		ТекстАрхивация = СтрЗаменить(ТекстАрхивация, "%2", "попросите администратора");
		ТекстВосстановление = СтрЗаменить(ТекстВосстановление, "%2", "попросите администратора");
		
		Элементы.ДекорацияБэкапАрхивация.Заголовок = НСтр(ТекстАрхивация);
		Элементы.ДекорацияБэкапВосстановление.Заголовок = НСтр(ТекстВосстановление);
		
		Элементы.СделатьБэкап.Видимость = Ложь;
		Элементы.СделатьБэкапВосстановление.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьПериодАрхивации()
	
	ОкончаниеПериода = НачалоГода(ТекущаяДатаСеанса())-1;	// Конец предыдущего года
	//НачалоПериода = НачалоГода(ОкончаниеПериода); 			// Начало предыдущего года
	НачалоПериода = '00010101';
	
	ИсторияПредметов = Новый Массив;		
	
	ИсторияКаталога = ЗагрузитьИсториюКаталога(КаталогАрхива, ИсторияПредметов);
	Если ИсторияКаталога <> Неопределено Тогда 
		МаксДата = НачалоПериода;
		Для Каждого Запись Из ИсторияКаталога Цикл 
			МаксДата = Мин(МаксДата, ?(Запись.Окончание = '00010101', МаксДата, Запись.Окончание + 1));
		КонецЦикла;		
		НачалоПериода = МаксДата;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаРежимПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Найти(ТекущаяСтраница.Имя, "осстановл") = 0 Тогда 
		Элементы.АрхивироватьВсе.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.Восстановить.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогАрхиваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ДиалогВыбораФайлаЗавершениеВыбора", ЭтотОбъект, Элемент);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогАрхиваДляВосстановленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ДиалогВыбораФайлаИсторииЗавершениеВыбора", ЭтотОбъект, Элементы.КаталогАрхива);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Показать(Оповещение);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИсторию(Команда)
	
	ПоследняяЗагруженнаяИстория = Неопределено;
	ИсторияПредметов = Новый Массив;
	
	ПоследняяЗагруженнаяИстория = ЗагрузитьИсториюКаталога(КаталогАрхива, ИсторияПредметов);
	Если ПоследняяЗагруженнаяИстория = Неопределено Тогда 
		ПоказатьПредупреждение(, "В этом каталоге отсутствует история выгрузки объектов",);
	КонецЕсли;
	
	ОбновитьОтображениеИстории(ПоследняяЗагруженнаяИстория, ИсторияПредметов);
	ПоследниеНастройкиВосстановления = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройки(Знач ПоЗавершениюЗапуститьВосстановление = Ложь)
	
	Если ПоследняяЗагруженнаяИстория = Неопределено Тогда 
		ОбновитьИсторию(Неопределено);		
		Если ПоследняяЗагруженнаяИстория = Неопределено Тогда 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("НастройкиФильтра", ИсторияАрхивации);
	ПараметрыОткрытия.Вставить("НастройкиФильтраПредметов", ИсторияСокращенийПредметов);	
	ПараметрыОткрытия.Вставить("ВходящиеНастройки", ПоследниеНастройкиВосстановления);
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ЗапуститьВосстановление", ПоЗавершениюЗапуститьВосстановление);
		
	ОповещениеЗакрытия = Новый ОписаниеОповещения("Настройка_ПослеЗакрытия", ЭтотОбъект, ПараметрыЗакрытия);
	ОткрытьФорму("ВнешняяОбработка.СозданиеАрхиваДокументооборота.Форма.Настройка", ПараметрыОткрытия,,,,, ОповещениеЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогАрхиваДляВосстановленияОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуНастройки(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеИстории(XMLИстория, ИсторияПредметов)
	
	Если XMLИстория = Неопределено  Тогда 
		Возврат;
	КонецЕсли;
	
	//ИсторияФильтрОрг.Очистить();
	ИсторияАрхивации.Очистить();
	
	Для Каждого ЗаписьИстории Из XMLИстория Цикл 
		Представление = "%1 [%2]";
		Представление = СтрЗаменить(Представление, "%1", ЗаписьИстории.ДатаСоздания);
		Представление = СтрЗаменить(Представление, "%2", ?(ЗаписьИстории.Пользователь = "", "Неизвестный пользователь", ЗаписьИстории.Пользователь));

		ИсторияАрхивации.Добавить(ЗаписьИстории, Представление );
	КонецЦикла;
	
	ИсторияСокращенийПредметов.Очистить();
	Для Каждого ЗаписьИстории Из ИсторияПредметов Цикл 
		ИсторияСокращенийПредметов.Добавить(Новый Структура("Код, Родитель", ЗаписьИстории.Код, ЗаписьИстории.Родитель), ЗаписьИстории.Название );
	КонецЦикла;
			
	//ОбновитьОтображениеИсторииСвязанныхЭлементов();
		
КонецПроцедуры

&НаКлиенте
Процедура ДиалогВыбораФайлаЗавершениеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда 
		
		УстановитьЗначениеРеквизита(ДополнительныеПараметры.Имя, ВыбранныеФайлы[0]);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДиалогВыбораФайлаИсторииЗавершениеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда 
		
		УстановитьЗначениеРеквизита(ДополнительныеПараметры.Имя, ВыбранныеФайлы[0]);
		
		ПоследняяЗагруженнаяИстория = Неопределено;
		ИсторияПредметов = Новый Массив;
		
		ПоследняяЗагруженнаяИстория = ЗагрузитьИсториюКаталога(КаталогАрхива, ИсторияПредметов);
		Если ПоследняяЗагруженнаяИстория = Неопределено Тогда 
			ПоказатьПредупреждение(, "В этом каталоге отсутствует история выгрузки объектов",);
		КонецЕсли;
		
		ОбновитьОтображениеИстории(ПоследняяЗагруженнаяИстория, ИсторияПредметов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеРеквизита(Знач Имя, Знач Значение)
	
	ЭтотОбъект[Имя] = Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура ОграничитьПериодПриИзменении(Элемент)
	
	Элементы.НачалоПериода.Доступность = ОграничитьПериод;
	Элементы.ОкончаниеПериода.Доступность = ОграничитьПериод;
	Если Элемент <> Неопределено Тогда 
		АнализироватьСодержимое(Неопределено);
		ОбновитьЗаголовкиГрупп();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОграничитьОрганизацииПриИзменении(Элемент)
	
	Элементы.ПредставлениеФильтраОрг.Доступность = ОграничитьОрганизации;
	
	//Элементы.ГруппаДинамическиеЭлементыОрганизации.Доступность = ОграничитьОрганизации;	
	Для Каждого Вложенный Из Элементы.ГруппаВерстка0.ПодчиненныеЭлементы Цикл 
		Если ТипЗнч(Вложенный) = Тип("ГруппаФормы") Тогда 
			Вложенный.Доступность = ОграничитьОрганизации;	
		КонецЕсли;
	КонецЦикла;
	
	Если Элемент <> Неопределено Тогда 
		АнализироватьСодержимое(Неопределено);
		ОбновитьЗаголовкиГрупп();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовкиГрупп()
	
	Если ОграничитьОрганизации Тогда
		
		ОтмеченоОрганизаций = 0;
		Для Каждого Орг Из ФильтрОрг Цикл
			Если Орг.Пометка Тогда 
				ОтмеченоОрганизаций = ОтмеченоОрганизаций + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если ФильтрОрг.Количество() = ОтмеченоОрганизаций Тогда 
			Элементы.ГруппаФильтрОрганизаций.ЗаголовокСвернутогоОтображения = "По всем доступным организациям";
		Иначе
			ЗаголовокГруппы = "По организаци%1: %2";
			Окончание = ПростоеСклонение(ОтмеченоОрганизаций, "и", "ям", "ям");
			ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%1", Окончание);
			ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%2", ПредставлениеФильтраОрг);
			
			Элементы.ГруппаФильтрОрганизаций.ЗаголовокСвернутогоОтображения =  ЗаголовокГруппы;
		КонецЕсли;
	Иначе 
		Элементы.ГруппаФильтрОрганизаций.ЗаголовокСвернутогоОтображения = "По всем доступным организациям"; //Элементы.ГруппаФильтрОрганизаций.Заголовок
	КонецЕсли;
	
	Если ОграничитьПериод И НЕ (НачалоПериода = '00010101' И ОкончаниеПериода = '00010101') Тогда		
		
		ЗаголовокГруппы = "Указан период с %1 по %2";
		
		Если НачалоПериода = '00010101' Тогда
			ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%1", "даты первого обмена");
		Иначе
			ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%1", Формат(НачалоПериода, "ДЛФ=DD"));
		КонецЕсли;
		Если ОкончаниеПериода = '00010101' Тогда
			ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%2", "дату последнего обмена");
		Иначе
			ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%2", Формат(ОкончаниеПериода, "ДЛФ=DD"));
		КонецЕсли;
		
		Элементы.ГруппаФильтрПериод.ЗаголовокСвернутогоОтображения =  ЗаголовокГруппы;
	Иначе 
		Элементы.ГруппаФильтрПериод.ЗаголовокСвернутогоОтображения = "Без ограничения периода"; //Элементы.ГруппаФильтрПериод.Заголовок
	КонецЕсли;
	
	КраткоеПредставлениеГруппВО = ПолучитьКраткиеПользовательскиеНазванияГрупп();
	КраткоеПредставлениеГруппКО = ПолучитьКраткиеПользовательскиеНазванияГруппКО();
	
	ПомеченыВо = "";
	НеПомеченыВо = "";
	ОтмеченоВидов = 0;
	Для Каждого Ф Из ФильтрВО Цикл
		Если Ф.Пометка Тогда 
			ОтмеченоВидов = ОтмеченоВидов + 1;
			ПомеченыВо = ПомеченыВо + ?(ПомеченыВо = "", "", ", ") + КраткоеПредставлениеГруппВО.Получить(Ф.Значение);
		Иначе
			НеПомеченыВо = НеПомеченыВо + ?(НеПомеченыВо = "", "", ", ") + КраткоеПредставлениеГруппВО.Получить(10 + Ф.Значение);
		КонецЕсли;		
	КонецЦикла;
		
	//Элементы.ДекорацияИтогоОбъем.Заголовок = ТекстОценкиИтого;
	//Элементы.АрхивироватьВсеРасширеннаяПодсказка.Заголовок = ТекстОценкиИтого;
	
	ПомеченыКо = "";
	НеПомеченыКо = "";
	ОтмеченоОрганов = 0;
	Для Каждого Ф Из ФильтрКО Цикл
		Если Ф.Пометка Тогда 
			ОтмеченоОрганов = ОтмеченоОрганов + 1;
			ПомеченыКо = ПомеченыКо + ?(ПомеченыКо = "", "", ", ") + КраткоеПредставлениеГруппКО.Получить(Ф.Значение);
		Иначе
			НеПомеченыКо = НеПомеченыКо + ?(НеПомеченыКо = "", "", ", ") + КраткоеПредставлениеГруппКО.Получить(Ф.Значение);
		КонецЕсли;
	КонецЦикла;
				
	ЗаголовокГруппы = "Выбраны %1 и %2";
	Если ОтмеченоВидов = ФильтрВО.Количество() Тогда //Все
		ЗаголовокПодГруппы = "все виды объектов";
	ИначеЕсли ОтмеченоВидов > Цел(ФильтрВО.Количество() / 2) Тогда //Все кроме
		ЗаголовокПодГруппы = "все виды объектов, кроме %1";
		ЗаголовокПодГруппы = СтрЗаменить(ЗаголовокПодГруппы, "%1", НеПомеченыВо);
	ИначеЕсли ОтмеченоВидов = 0 Тогда //Ни одного		
		ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "Выбраны %1 и ", "Не указано ни одного вида объектов, но выбран" + ПростоеСклонение(ОтмеченоОрганов, "", "ы", "ы") + " ");
	Иначе
		ЗаголовокПодГруппы = "%1"; //следующие виды объектов: 
		ЗаголовокПодГруппы = СтрЗаменить(ЗаголовокПодГруппы, "%1", ПомеченыВо);
	КонецЕсли;	
	ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%1", ЗаголовокПодГруппы);
	
	Если ОтмеченоОрганов = ФильтрКО.Количество() Тогда //Все
		ЗаголовокПодГруппы = "все контролирующие органы";
	ИначеЕсли ОтмеченоОрганов > Цел(ФильтрКО.Количество() / 2) Тогда //Все кроме
		ЗаголовокПодГруппы = "все контролирующие органы, кроме %1";
		ЗаголовокПодГруппы = СтрЗаменить(ЗаголовокПодГруппы, "%1", НеПомеченыКо);
	ИначеЕсли ОтмеченоОрганов = 0 Тогда //Ни одного
		ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%2", "ни одного контролирующего органа");
	Иначе
		ЗаголовокПодГруппы = "%1"; //следующие контролирующие органы: 
		ЗаголовокПодГруппы = СтрЗаменить(ЗаголовокПодГруппы, "%1", ПомеченыКо);
	КонецЕсли;	
	ЗаголовокГруппы = СтрЗаменить(ЗаголовокГруппы, "%2", ЗаголовокПодГруппы);
	
	Если ОтмеченоВидов = 0 И ОтмеченоОрганов = 0 Тогда 
		ЗаголовокГруппы = "Ничего не выбрано";
	КонецЕсли;

	Элементы.ГруппаФильтрОбъектовИОрганов.ЗаголовокСвернутогоОтображения = ЗаголовокГруппы; //Server call?
		
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьФильтрПослеИзменения()
	
	ЕстьПометка1 = Ложь;
	ЕстьПометка2 = Ложь;
	
	Для Каждого Эл Из ФильтрВО Цикл 
		Если Эл.Пометка Тогда 
			ЕстьПометка1 = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Эл Из ФильтрКО Цикл 
		Если Эл.Пометка Тогда 
			ЕстьПометка2 = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.АрхивироватьВсе.Доступность = ЕстьПометка1 И ЕстьПометка2;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьФильтрПриИзменении(Элемент)
			
	Если (Элемент <> Неопределено И Элемент.Родитель.Имя = "ГруппаДинамическиеЭлементыОрганизации")	Тогда 
		ОбновитьПредставлениеФильтраОрганизаций();
	КонецЕсли;
	
	Если (Элемент <> Неопределено И Элемент.Родитель.Имя = "ГруппаДинамическиеЭлементыОрганизации")
		Или (Элемент <> Неопределено И Элемент.Родитель.Имя = "ГруппаВидыОбъектов")
		Или (Элемент <> Неопределено И Элемент.Родитель.Имя = "ГруппаКонтролирующиеОрганы")
			Тогда 
		АнализироватьСодержимое(Неопределено);
	КонецЕсли;
	
	ОбновитьЗаголовкиГрупп();
	ОтметитьФильтрПослеИзменения();
			
КонецПроцедуры

&НаСервере
Процедура ОбновитьДинамическиеЭлементыФормы(КонтролирующиеОрганы, ВидыОбъектов, ОрганизацииОценки)
	
	ПользовательскиеНазванияГрупп = ПолучитьПользовательскиеНазванияГрупп();
	
	Для Каждого Флажок Из Элементы.ГруппаДинамическиеЭлементыОрганизации.ПодчиненныеЭлементы Цикл
		Флажок.Подсказка = "";
	КонецЦикла;
	
	Для Каждого Флажок Из Элементы.ГруппаДинамическиеЭлементыОрганизации1.ПодчиненныеЭлементы Цикл
		Флажок.Подсказка = "";
	КонецЦикла;
	
	ВсеОрганизацииРазмерИтого = 0;
	
	Для Каждого Орг Из ОрганизацииОценки Цикл
		
		Если Орг.РазмерИтого = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		Эл = ФильтрОрг.НайтиПоЗначению(Орг.Ссылка);
		Индекс = ФильтрОрг.Индекс(Эл);
		
		ПутьКДанным = "ФильтрОрг[%2].Пометка";
		ПутьКДанным = СтрЗаменить(ПутьКДанным, "%2", Формат(Индекс, "ЧДЦ=; ЧН=; ЧГ="));
	
		Для Каждого Флажок Из Элементы.ГруппаДинамическиеЭлементыОрганизации.ПодчиненныеЭлементы Цикл
			Если Флажок.ПутьКДанным <> ПутьКДанным Тогда 
				Продолжить;
			КонецЕсли;
			
			Если ФильтрОрг[Индекс].Пометка Тогда 
				ВсеОрганизацииРазмерИтого = ВсеОрганизацииРазмерИтого + Орг.РазмерИтого;
			КонецЕсли;
				
			ТекстОценкиИтого = " [%1]";
			ТекстОценкиИтого = СтрЗаменить(ТекстОценкиИтого, "%1", ПредставлениеРазмера(Орг.РазмерИтого));
	
			Флажок.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСправа;
			Флажок.Подсказка = ТекстОценкиИтого;
			
		КонецЦикла;
	КонецЦикла;
	
	ТекстОценкиИтого = " Потребуется %1 свободного места";
	ТекстОценкиИтого = СтрЗаменить(ТекстОценкиИтого, "%1", ПредставлениеРазмера(ВсеОрганизацииРазмерИтого));
	
	Элементы.АрхивироватьВсе.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСправа;
	Элементы.АрхивироватьВсе.РасширеннаяПодсказка.Заголовок = ТекстОценкиИтого;
				
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставлениеФильтраОрганизаций() Экспорт
	
	Представление = ПолучитьПредставлениеФильтраОрганизаций(ФильтрОрг);	
	Если Представление <> ПредставлениеФильтраОрг Тогда 
		УстановитьЗначениеРеквизита("ПредставлениеФильтраОрг", Представление);
		ОбновитьЗаголовкиГрупп();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписиПрогресса(ТекущаяОрганизация = Неопределено, Знач Этап = 0) Экспорт
	
	Если Этап = 0 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Выполняется архивация", ЭтотОбъект);
		
		НадписьПрогресса = "По %1 %2";
		НадписьПрогресса = СтрЗаменить(НадписьПрогресса, "%1", ?(ТекущаяОрганизация.ЯвляетсяИП, "ИП:", "организации:"));
		НадписьПрогресса = СтрЗаменить(НадписьПрогресса, "%2", ТекущаяОрганизация.Название);
		
		Оповестить("#ФормаПрогрессаНадпись", НадписьПрогресса, ЭтотОбъект);
	ИначеЕсли Этап = 10 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Выполняется восстановление", ЭтотОбъект);
		
		НадписьПрогресса = "По %1 %2";
		НадписьПрогресса = СтрЗаменить(НадписьПрогресса, "%1", ?(ТекущаяОрганизация.ЯвляетсяИП, "ИП:", "организации:"));
		НадписьПрогресса = СтрЗаменить(НадписьПрогресса, "%2", ТекущаяОрганизация.Название);
		
		Оповестить("#ФормаПрогрессаНадпись", НадписьПрогресса, ЭтотОбъект);
	ИначеЕсли Этап = 1 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Установка признака архивации", ЭтотОбъект);
	ИначеЕсли Этап = 11 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Сброс признака архивации", ЭтотОбъект);
	ИначеЕсли Этап = 2 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Завершение архивации", ЭтотОбъект);
	ИначеЕсли Этап = 12 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Завершение восстановления", ЭтотОбъект);
	ИначеЕсли Этап = 9 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Архивация завершена", ЭтотОбъект);
		Оповестить("#ФормаПрогрессаНадпись", "", ЭтотОбъект);
	ИначеЕсли Этап = 19 Тогда 
		Оповестить("#ФормаПрогрессаЗаголовок", "Восстановление завершено", ЭтотОбъект);
		Оповестить("#ФормаПрогрессаНадпись", "", ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПрогресс(Знач Прогресс = Неопределено, Знач Всего = Неопределено, Знач Архивация = Истина)
	
	Если Прогресс = Неопределено Тогда 		
		Оповестить("#ФормаПрогрессаПозиция", -1, ЭтотОбъект);		
		ОбновитьНадписиПрогресса(, ?(Архивация, 9, 19));		
	Иначе		
		Если Всего = Неопределено Тогда 
			ПрогрессПроценты = Прогресс;
		Иначе
			ПрогрессПроценты = (Прогресс / ?(Всего = 0, 1, Всего)) * 100;
		КонецЕсли;
		
		Оповестить("#ФормаПрогрессаПозиция", ПрогрессПроценты, ЭтотОбъект);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрОргПослеОтметкиЭлементов(Список, Параметры) Экспорт
	
	Если Список <> Неопределено Тогда
		ОбновитьПредставлениеФильтраОрганизаций();		
		АнализироватьСодержимое(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеФильтраОргНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ФильтрОргПослеОтметкиЭлементов", ЭтотОбъект, Неопределено);
	ФильтрОрг.ПоказатьОтметкуЭлементов(Оповещение, "Выберите нужные организации");
	
КонецПроцедуры

