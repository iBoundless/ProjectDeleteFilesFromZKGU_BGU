&НаСервере
Функция ПолучитьИзПрисоединенныхФайлов(ВладелецСсылка, Знач ИмяФайла, Знач Вид)
	
	ИмяПрисоединенного = ВидыОбъектов_ПрисоединенныеФайлы(Вид);
	
	Если ИмяПрисоединенного = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МассивФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
		ВладелецСсылка,
		ИмяПрисоединенного,, "ИсходноеИмяФайла", Истина);
		
	Если МассивФайлов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		Если ПрисоединенныйФайл.ИсходноеИмяФайла = ИмяФайла Тогда
			Возврат РаботаСФайлами.ДвоичныеДанныеФайла(ПрисоединенныйФайл.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция УстановитьЗначениеПрисоединенногоФайла(ВладелецСсылка, Знач ИмяФайла, Знач Вид, ЗначениеДляУстановки)
	
	ИмяПрисоединенного = ВидыОбъектов_ПрисоединенныеФайлы(Вид);
	
	Если ИмяПрисоединенного = Неопределено Тогда
		Возврат Ложь; //Данный вид объектов не имеет присоединенных файлов
	КонецЕсли;
	
	МассивФайлов = ОбщегоНазначенияЭДКО.ПрикрепленныеФайлыКОбъектуИзСправочника(
		ВладелецСсылка,
		ИмяПрисоединенного,,
		"ИсходноеИмяФайла");
		
	Если МассивФайлов.Количество() = 0 Тогда
		Возврат Ложь; //Данный объект не имеет присоединенных файлов
	КонецЕсли;
		
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		Если ПрисоединенныйФайл.ИсходноеИмяФайла = ИмяФайла Тогда
			Значение = ЗначениеДляУстановки.Получить();
			Адрес = ПоместитьВоВременноеХранилище(Значение, УникальныйИдентификатор);
			
			ИнформацияОФайле = Новый Структура();
			ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище", Адрес);
			ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", Неопределено);
						
			РаботаСФайлами.ОбновитьФайл(ПрисоединенныйФайл.Ссылка, ИнформацияОФайле);
			УдалитьИзВременногоХранилища(Адрес);
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь; //Присоединенный объекта не был найден по имени
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СократитьСлово(Знач Слово, Знач ЗавершитьСимволом = "")
	
	//Исключения
	Если Найти(НРег(Слово), "сч")>0 И Найти(НРег(Слово), "факт")>0 Тогда 
		Возврат Слово;
	КонецЕсли;
	
	Если СтрДлина(Слово) < 4 Тогда 
		Возврат Слово;
	КонецЕсли;
	
	Гласные = "аеёиоуыэюяaeiou";
	СимволыПунктуации = """№~`|:;()-=_+!@#$%^&*?\/,.<>";
	СпецСогласные = "ъь";
		
	Сокр = "";
	Заглавных = 0;
	Согласных = 0;
	СимволовПунктуации = 0;
	Гласных = 0;
	УдвоеннаяГласная = 0;
	ТолькоПунктуация = Ложь;
	Гласная = Неопределено;
	Для Сч = 1 по СтрДлина(Слово) Цикл 
		
		Буква = Сред(Слово, Сч, 1);
		
		Пунктуация = Ложь;		
		ПредыдущаяГласная = Гласная;
		
		Если Найти(СимволыПунктуации, Буква) > 0 Тогда 
			Гласная = Неопределено;
			Пунктуация = Истина;
			СимволовПунктуации = СимволовПунктуации + 1;
		ИначеЕсли Найти(Гласные + ВРег(Гласные), Буква) > 0 Тогда 
			Гласная = Истина;
			Гласных = Гласных + 1;
		Иначе
			Гласная = Ложь;
			Согласных = Согласных + 1;
		КонецЕсли;
		
		Если (Не Пунктуация) И (Буква = ВРег(Буква)) Тогда 
			Заглавных = Заглавных + 1;
		КонецЕсли;
		Если Заглавных > 1 Тогда //Возможно аббревиатура
			Возврат Слово;
		КонецЕсли;
						
		Если ТолькоПунктуация Тогда 
			Если Пунктуация Тогда 
				Если ПредыдущаяГласная <> Неопределено Тогда 
					Сокр = Сокр + ЗавершитьСимволом;
				КонецЕсли;
				Сокр = Сокр + Буква;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ПредыдущаяГласная = Истина И Гласная = Истина Тогда //Удвоенная гласная
			УдвоеннаяГласная = 1;
		КонецЕсли;
		
		Если Гласных > 1 + УдвоеннаяГласная Тогда
			ТолькоПунктуация = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Найти(СпецСогласные + ВРег(СпецСогласные), Буква) > 0 Тогда
			Прервать;
		КонецЕсли;
				
		Сокр = Сокр + Буква;
		
		Если СтрДлина(Слово) - СтрДлина(Сокр) < 3 Тогда //Нелепое сокращение
			Возврат Слово;
		КонецЕсли;
						
	КонецЦикла;
	
	Если СтрДлина(Слово) - СтрДлина(Сокр) < 3 Тогда //Нелепое сокращение
		Возврат Слово;
	КонецЕсли;
		
	Если СимволовПунктуации > 0 Тогда 
		Если Гласная <> Неопределено Тогда 
			Сокр = Сокр + ЗавершитьСимволом;
		КонецЕсли;
		Возврат Сокр;
	КонецЕсли;
	
	Возврат Сокр + ЗавершитьСимволом;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СократитьПредложение(Знач Предложение)
	
	//Спецсокращения
	Предложение = СтрЗаменить(Предложение, "(не используется) ", "");
	Предложение = СтрЗаменить(Предложение, "Статистика: ", "");
	Предложение = СтрЗаменить(Предложение, "Форма ", "Ф. ");
	Предложение = СтрЗаменить(Предложение, "форма ", "ф. ");
	
	Если Найти(Предложение, "(") > 0 И Найти(Предложение, " (") = 0 Тогда 
		Предложение = СтрЗаменить(Предложение, "(", " (");
	КонецЕсли;
	Если Найти(Предложение, ")") > 0 И Найти(Предложение, ") ") = 0 Тогда 
		Предложение = СтрЗаменить(Предложение, ")", ") ");
	КонецЕсли;
	Предложение = СокрЛП(Предложение);
	
	Слова = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Предложение, " ");
	
	СокрПредложение = "";
	Для Каждого Слово Из Слова Цикл 
		СокрСлово = СократитьСлово(Слово, ".");
		Если СтрДлина(СокрПредложение + ?(СокрПредложение = "", "", " ") + СокрСлово) >= 48 Тогда 
			Прервать;
		КонецЕсли;
		СокрПредложение = СокрПредложение + ?(СокрПредложение = "", "", " ") + СокрСлово;
	КонецЦикла;
	СокрПредложение = СтрЗаменить(СокрПредложение, " -", "-");
	
	Возврат СокрПредложение;
	
КонецФункции

