&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеФильтраОрганизаций(ФильтрОрг) Экспорт
	
	ВместилосьВСтроке = 9999;
	МаксимумСимволов = 50; //Ограничение по количеству символов представления
	МассивОтмеченных = Новый Массив;
	Представление = "";
	Для Каждого Элемент Из ФильтрОрг Цикл 
		Если Элемент.Пометка Тогда 
			МассивОтмеченных.Добавить(Элемент.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивОтмеченных.Количество() = 0 Тогда 
		Возврат "Нет выбранных";
	КонецЕсли;
	
	Для ш = 1 по МассивОтмеченных.Количество() Цикл 
		НовоеПредставление = Представление + ?(Представление = "", "", ", ") + МассивОтмеченных[ш - 1];
		Если СтрДлина(НовоеПредставление) > МаксимумСимволов Тогда 
			ВместилосьВСтроке = ш - 1;
			Прервать;
		Иначе
			Представление = НовоеПредставление;
		КонецЕсли;		
	КонецЦикла;
	
	Если МассивОтмеченных.Количество() > ВместилосьВСтроке Тогда 
		Префикс = "еще ";
		Разница = МассивОтмеченных.Количество() - ВместилосьВСтроке;
		Если Представление = "" Тогда 
			Префикс = ПростоеСклонение(Разница, "выбрана ", "выбраны ", "выбраны ");
		КонецЕсли;
		Представление = Представление + ?(Представление = "", "", " и ") + Префикс + Формат(Разница, "ЧДЦ=; ЧГ=");
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РежимРаботы()
	
	СС = СтрокаСоединенияИнформационнойБазы();
	Если Найти(НРег(СС), "srvr=""") > 0 И Найти(НРег(СС), "ref=""") > 0 Тогда 
		Возврат 0; //"Серверный";
	ИначеЕсли Найти(НРег(СС), "file=""") > 0 Тогда 
		Возврат 1; //"Файловый";
	ИначеЕсли Найти(НРег(СС), "ws=""") > 0 Тогда 
		Возврат 2; //"Веб-сервер";
	Иначе
		Возврат 9; //"Не удалось определить";
	КонецЕсли;
	
КонецФункции

