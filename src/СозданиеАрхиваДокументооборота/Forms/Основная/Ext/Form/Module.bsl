&НаСервере
Функция ПредставлениеОрганизации(Знач ОбрабатываемыйОбъект)
	Перем ИНН, КПП, КрНаименование;
			
	Если ТипЗнч(ОбрабатываемыйОбъект) = Тип("СправочникСсылка.Организации") Или ТипЗнч(ОбрабатываемыйОбъект) = Тип("СправочникОбъект.Организации") Тогда 
		Организация = ОбрабатываемыйОбъект;
	ИначеЕсли ОбрабатываемыйОбъект = Неопределено Тогда 
		Возврат "";
	Иначе
		Организация = ОбрабатываемыйОбъект.Организация;		
	КонецЕсли;
	
	СтруктураДанныхОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(Организация,, "ИННЮЛ,КППЮЛ,НаимЮЛСокр");
	
	СтруктураДанныхОрганизации.Свойство("НаимЮЛСокр", КрНаименование);	
	СтруктураДанныхОрганизации.Свойство("ИННЮЛ", ИНН);
	СтруктураДанныхОрганизации.Свойство("КППЮЛ", КПП);
	
	Если ИНН = Неопределено Или ИНН = "" Тогда 
		ИНН = Прав(Строка(Организация.УникальныйИдентификатор()), 10);
		ИНН = СтрЗаменить(ИНН, "-", "");
	КонецЕсли;
	Если КПП = Неопределено Тогда 
		КПП = "";
	КонецЕсли;
	
	Если КрНаименование <> Неопределено Тогда 
		КрНаименование = СокрЛП(КрНаименование);
	КонецЕсли;
	
	Если КрНаименование = Неопределено Или КрНаименование = "" Тогда //Сокращенное официальное
		КрНаименование = СокрЛП(Организация.Наименование);
	КонецЕсли;
		
	Если КрНаименование = Неопределено Или КрНаименование = "" Тогда //Краткое представление в программе
		КатОрганизация = СокрЛП(ИНН) + ?(СокрЛП(КПП)="", "", "-") + СокрЛП(КПП);
	Иначе
		КатОрганизация = КрНаименование;
	КонецЕсли;
	
	КатОрганизация = ОчиститьЗапрещенныеСимволы(КатОрганизация, Истина);
	
	Возврат СокрЛП(КатОрганизация);
	
КонецФункции

//БазовыйКаталог \ Организация \ Контролирующий орган \ Группа объекта \ Объект \ [ Цикл обмена \] Файлы объекта
&НаСервере
Функция ПолучитьПолныйПуть(ОбрабатываемыйОбъект, КаталогСокращенийПредметов, ОтборПредметы = Неопределено)
	
	
	НазванияГрупп = ПолучитьПользовательскиеНазванияГрупп();
	БазовыйКаталог = ДобавитьРазделительПути(КаталогАрхива);
	ОргКрНаименование = ПредставлениеОрганизации(ОбрабатываемыйОбъект);
	КатОрганизация = ДобавитьРазделительПути(ОргКрНаименование);
	
	ИндексКО = Перечисления.ТипыКонтролирующихОрганов.Индекс(ОбрабатываемыйОбъект.КонтролирующийОрган);
	ИмяКО = ОбрабатываемыйОбъект.КонтролирующийОрган.Метаданные().ЗначенияПеречисления[ИндексКО].Имя;
	КатКонтролирующийОрган = ДобавитьРазделительПути(Строка(ИмяКО));
	
	КатГруппа = ДобавитьРазделительПути(НазванияГрупп.Получить(ОбрабатываемыйОбъект.ИдентификаторГруппы));
	КатОбъект = ПолучитьКраткоеПредставление(ОбрабатываемыйОбъект, НазванияГрупп, КатГруппа,, КаталогСокращенийПредметов, ОтборПредметы);
	
	Если (КатОбъект = "") И (КатГруппа = "") Тогда 
		Возврат "";
	КонецЕсли;
	
	Возврат ОчиститьЗапрещенныеСимволы(БазовыйКаталог + КатОрганизация + КатКонтролирующийОрган + КатГруппа + КатОбъект);
	
КонецФункции

