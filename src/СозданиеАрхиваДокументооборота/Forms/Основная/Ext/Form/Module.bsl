&НаСервере
Функция ПредставлениеРазмера(Знач Ч)
		
	Суффикс = "Мб";
	
	Если Ч = 0 Тогда 
		Возврат "0 " + Суффикс;
	КонецЕсли;
	
	Ч = ((Ч / 1024) / 1024); //Мб
	
	Если Ч > 1024 Тогда 
		Суффикс = "Гб";
		Ч = Ч / 1024; //Гб
	КонецЕсли;
	
	Если Ч < 1 Тогда		
		Возврат "меньше 1 " + Суффикс;
	КонецЕсли;
	
	Возврат Формат(Ч, "ЧДЦ=; ЧГ=") + " " + Суффикс;
	
КонецФункции

//	Выполняется выборка по всем прикладным объектам с ограничением периода
//	Попадание в отфильтрованную группу или контролирующий орган обнуляет размер объекта
&НаСервере
Функция АнализироватьСодержимоеОъектов(ВидыОбъектов, Организации)
			
	ВидыОбъектов = Новый Массив;
	КонтролирующиеОрганы = Новый Массив;
	ОтборОрганизации  = Новый Массив;
	Организации = Новый Массив;

	ВыбранныеВидыОбъектов = Новый Массив;
	Для Каждого ЭлСписка Из ФильтрВО Цикл
		Если ЭлСписка.Пометка Тогда 
			ВыбранныеВидыОбъектов.Добавить(ЭлСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВыбранныеКонтролирующиеОрганы = Новый Массив;
	Для Каждого ЭлСписка Из ФильтрКО Цикл
		Если ЭлСписка.Пометка Тогда 
			ВыбранныеКонтролирующиеОрганы.Добавить(ЭлСписка.Значение);
		КонецЕсли;		
	КонецЦикла;
	
	КонтекстМодуля = РеквизитФормыВЗначение("Объект");
	ТекстЗапроса = КонтекстМодуля.ТекстЗапросаОценки();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Если ОграничитьПериод Тогда 
		Запрос.УстановитьПараметр("НачПериода", НачалоПериода);
		Если ОкончаниеПериода <> '00010101' Тогда 
			КонПериода = КонецДня(ОкончаниеПериода);
		Иначе
			КонПериода = ОкончаниеПериода;
		КонецЕсли;
		Запрос.УстановитьПараметр("КонПериода", КонПериода);
	Иначе
		Запрос.УстановитьПараметр("НачПериода", '00010101');
		Запрос.УстановитьПараметр("КонПериода", '00010101');
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ОтобратьОрганизации", ОтборОрганизации);
	Запрос.УстановитьПараметр("НеИспользоватьОтборОрганизации", Истина);
	
	Запрос.УстановитьПараметр("ОтобратьКонтролирующиеОрганы", ВыбранныеКонтролирующиеОрганы);
	Запрос.УстановитьПараметр("НеИспользоватьОтборПоКонтролирующемуОргану", Ложь);
	
	Запрос.УстановитьПараметр("ОтобратьВидыОбъектов", ВыбранныеВидыОбъектов);
	Запрос.УстановитьПараметр("НеИспользоватьОтборПоВидамОбъектов", Ложь);
	
	//Запрос.УстановитьПараметр("ОтобратьОрганизации", ОтборОрганизации);
	//Запрос.УстановитьПараметр("НеИспользоватьОтборОрганизации", НЕ ОграничитьОрганизации);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТабРезультат = РезультатЗапроса.Выгрузить();
	
	ТЧКО = ТабРезультат.Скопировать(, "КонтролирующийОрган, КоличествоИтого, РазмерИтого");
	ТЧВО = ТабРезультат.Скопировать(, "ИдентификаторГруппы, КоличествоИтого, РазмерИтого");
	ТЧОО = ТабРезультат.Скопировать(, "Организация, КоличествоИтого, РазмерИтого");		
		
	ТЧКО.Свернуть("КонтролирующийОрган", "КоличествоИтого, РазмерИтого");
	ТЧКО.Сортировать("КонтролирующийОрган");
	КонтролирующиеОрганы = Новый Массив;
	Для Каждого Стр Из ТЧКО Цикл 
		Описание = Новый Структура("Ссылка", Стр.КонтролирующийОрган);
		Описание.Вставить("КоличествоИтого", Стр.КоличествоИтого);
		Описание.Вставить("РазмерИтого", Стр.РазмерИтого);
		КонтролирующиеОрганы.Добавить(Описание);
	КонецЦикла;
	//= ТЧКО.ВыгрузитьКолонку("КонтролирующийОрган");
	ТЧКО.Очистить();
	
	ТЧВО.Свернуть("ИдентификаторГруппы", "КоличествоИтого, РазмерИтого");
	
	НазванияГрупп = ПолучитьПользовательскиеНазванияГрупп();
	Для Каждого Группа Из НазванияГрупп Цикл 
		НоваяСтрока = ТЧВО.Добавить();
		НоваяСтрока.ИдентификаторГруппы = Группа.Ключ;
		НоваяСтрока.КоличествоИтого = 0;
		НоваяСтрока.РазмерИтого = 0; 
	КонецЦикла;
	
	ТЧВО.Свернуть("ИдентификаторГруппы", "КоличествоИтого, РазмерИтого");
	
	ТЧВО.Сортировать("ИдентификаторГруппы");
	Для Каждого Стр Из ТЧВО Цикл 
		ВидыОбъектов.Добавить(ДобавитьФильтр(Стр.ИдентификаторГруппы, Стр.КоличествоИтого, Стр.РазмерИтого));
	КонецЦикла;
	ТЧВО.Очистить();
	
	ТЧОО.Свернуть("Организация", "КоличествоИтого, РазмерИтого");
	ТЧОО.Сортировать("Организация");
	
	Для Каждого Стр Из ТЧОО Цикл 
		Если Стр.Организация.Пустая() Тогда 
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура("Ссылка", Стр.Организация);
		Описание.Вставить("Название", ПредставлениеОрганизации(Стр.Организация));
		Описание.Вставить("УникальныйИдентификатор", Строка(Стр.Организация.УникальныйИдентификатор()));
		Описание.Вставить("ЯвляетсяИП", ОрганизацияЯвляетсяИП(Стр.Организация));
		Описание.Вставить("РазмерИтого", Стр.РазмерИтого);
		Описание.Вставить("КоличествоИтого", Стр.КоличествоИтого);
		Организации.Добавить(Описание);
	КонецЦикла;
	
	ОбновитьДинамическиеЭлементыФормы(КонтролирующиеОрганы, ВидыОбъектов, Организации);
	
	Возврат КонтролирующиеОрганы;
	
КонецФункции

