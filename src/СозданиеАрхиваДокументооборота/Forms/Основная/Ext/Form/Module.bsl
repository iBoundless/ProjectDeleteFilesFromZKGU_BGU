&НаКлиентеНаСервереБезКонтекста
Функция ЗагрузитьИсториюКаталога(Знач Каталог, ИсторияПредметов)
	
	ЗаписиИстории = Новый Массив;
	ИсторияПредметов = Новый Массив;
	
	ПолныйПутьКаталога = ДобавитьРазделительПути(Каталог) + "catalog.xml";
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ПолныйПутьКаталога);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Построитель = Новый ПостроительDOM;	
	ИсторияXML = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();
	
	#Если Не ВебКлиент Тогда 
					
		Разыменовыватель = Новый РазыменовательПространствИменDOM("","");
		Выражение = ИсторияXML.СоздатьВыражениеXPath("//subj_short/f", Разыменовыватель);
		Итератор = Выражение.Вычислить(ИсторияXML, ТипРезультатаDOMXPath.УпорядоченныйИтераторУзлов);
		Узел = Итератор.ПолучитьСледующий();
		Пока ТипЗнч(Узел) = Тип("ЭлементDOM") Цикл 
			
			Код = Узел.ПолучитьАтрибут("c");
			Название  = Узел.ПолучитьАтрибут("d");
			Родитель  = Узел.ПолучитьАтрибут("p");
			
			Предмет = Новый Структура("Код, Название, Родитель", Код, Название, Родитель);
			ИсторияПредметов.Добавить(Предмет);
						
			Узел = Итератор.ПолучитьСледующий();
		КонецЦикла;
		
	#КонецЕсли
	
	Для Каждого ЗаписьИсторииXML Из ИсторияXML.ДочерниеУзлы[0].ДочерниеУзлы Цикл 		// catalog > session
		ЗаписьИстории = Новый Структура;
		ЗаписьИстории.Вставить("ДатаСоздания", XMLЗначение2(Тип("Дата"), ЗаписьИсторииXML.ПолучитьАтрибут("date")));
		
		Для Каждого Вложенные Из ЗаписьИсторииXML.ДочерниеУзлы Цикл
			Если Вложенные.ИмяЭлемента <> "options" Тогда 
				Продолжить;
			КонецЕсли;
			Для Каждого ПараметрыЗаписи Из Вложенные.ДочерниеУзлы Цикл					// catalog > session > options
				Если ПараметрыЗаписи.ИмяЭлемента = "orgs" Тогда 
					ЗаписьИстории.Вставить("Организации", Новый Массив);
					Для Каждого ПараметрОрг Из ПараметрыЗаписи.ДочерниеУзлы Цикл		// catalog > session > options > orgs
						ОргИнфо = Новый Структура("Организация, УникальныйИдентификатор, Название, КоличествоОбъектов", Неопределено);
						
						ЗнАтрибута = ПараметрОрг.ПолучитьАтрибут("uid");
						ОргИнфо.УникальныйИдентификатор = XMLЗначение2(Тип("Строка"), ЗнАтрибута);
						
						ЗнАтрибута = ПараметрОрг.ПолучитьАтрибут("cat");
						ОргИнфо.Название = XMLЗначение2(Тип("Строка"), ЗнАтрибута);
						
						ЗнАтрибута = ПараметрОрг.ПолучитьАтрибут("objcount");
						ОргИнфо.КоличествоОбъектов = XMLЗначение2(Тип("Число"), ЗнАтрибута);
						
		                ЗаписьИстории.Организации.Добавить(ОргИнфо);
					КонецЦикла
				ИначеЕсли ПараметрыЗаписи.ИмяЭлемента = "types" Тогда 
					ЗаписьИстории.Вставить("ВидыОбъектов", Новый Массив);
					Для Каждого ПараметрВид Из ПараметрыЗаписи.ДочерниеУзлы Цикл		// catalog > session > options > types
						
						ВидОбъекта = Новый Структура("Идентификатор, Каталог, КоличествоОбъектов", 99);
						
						ЗнАтрибута = ПараметрВид.ПолучитьАтрибут("id");
						ВидОбъекта.Идентификатор = XMLЗначение2(Тип("Число"), ЗнАтрибута);
						
						ЗнАтрибута = ПараметрВид.ПолучитьАтрибут("cat");
						ВидОбъекта.Каталог = XMLЗначение2(Тип("Строка"), ЗнАтрибута);					
						
						ЗнАтрибута = ПараметрВид.ПолучитьАтрибут("objcount");
						ВидОбъекта.КоличествоОбъектов = XMLЗначение2(Тип("Число"), ЗнАтрибута);
						
						ЗаписьИстории.ВидыОбъектов.Добавить(ВидОбъекта);
						
					КонецЦикла
				ИначеЕсли ПараметрыЗаписи.ИмяЭлемента = "authorities" Тогда 
					ЗаписьИстории.Вставить("КонтролирующиеОрганы", Новый Массив);
					Для Каждого ПараметрКОрган Из ПараметрыЗаписи.ДочерниеУзлы Цикл		// catalog > session > options > authorities
						
						КонтролирующийОрган = Новый Структура("Орган, Идентификатор, Каталог, КоличествоОбъектов", Неопределено);
						
						ЗнАтрибута = ПараметрКОрган.ПолучитьАтрибут("id");
						КонтролирующийОрган.Идентификатор = XMLЗначение2(Тип("Строка"), ЗнАтрибута);
						
						ЗнАтрибута = ПараметрКОрган.ПолучитьАтрибут("cat");
						КонтролирующийОрган.Каталог = XMLЗначение2(Тип("Строка"), ЗнАтрибута);
						
						ЗнАтрибута = ПараметрКОрган.ПолучитьАтрибут("objcount");
						КонтролирующийОрган.КоличествоОбъектов = XMLЗначение2(Тип("Число"), ЗнАтрибута);
						
						ЗаписьИстории.КонтролирующиеОрганы.Добавить(КонтролирующийОрган);						
					КонецЦикла
				КонецЕсли;				
				Если ПараметрыЗаписи.ИмяЭлемента = "dir" Тогда
					ЗаписьИстории.Вставить("Каталог", XMLЗначение2(Тип("Строка"), ПараметрыЗаписи.ТекстовоеСодержимое));
				ИначеЕсли ПараметрыЗаписи.ИмяЭлемента = "user" Тогда
					ЗаписьИстории.Вставить("Пользователь", XMLЗначение2(Тип("Строка"), ПараметрыЗаписи.ТекстовоеСодержимое));
				ИначеЕсли ПараметрыЗаписи.ИмяЭлемента = "host" Тогда
					ЗаписьИстории.Вставить("Компьютер", XMLЗначение2(Тип("Строка"), ПараметрыЗаписи.ТекстовоеСодержимое));
				ИначеЕсли ПараметрыЗаписи.ИмяЭлемента = "dateb" Тогда
					ЗаписьИстории.Вставить("Начало", XMLЗначение2(Тип("Дата"), ПараметрыЗаписи.ТекстовоеСодержимое));
				ИначеЕсли ПараметрыЗаписи.ИмяЭлемента = "datee" Тогда
					ЗаписьИстории.Вставить("Окончание", XMLЗначение2(Тип("Дата"), ПараметрыЗаписи.ТекстовоеСодержимое));
				КонецЕсли;
			КонецЦикла;		
		КонецЦикла;	
	
		ЗаписиИстории.Добавить(ЗаписьИстории);
	КонецЦикла;	
			
	ЗаполнитьСсылки(ЗаписиИстории);
	
	Возврат ЗаписиИстории;
КонецФункции

&НаКлиенте
Процедура ЗафиксироватьИсториюАрхивации(Информация)
	
	НазванияГрупп = ПолучитьПользовательскиеНазванияГрупп();
	ПолныйПутьКаталога = ДобавитьРазделительПути(КаталогАрхива) + "catalog.xml";
	
	КаталогПуст = Ложь;
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ПолныйПутьКаталога);
	Исключение
		КаталогПуст = Истина;
	КонецПопытки;
	
	Если КаталогПуст Тогда 
		ЗаписиИстории = Новый ДокументDOM("", "catalog");
	Иначе
		Построитель = Новый ПостроительDOM;	
		ЗаписиИстории = Построитель.Прочитать(Чтение);
		Чтение.Закрыть();
	КонецЕсли;
	
	ЗаписьИстории = ЗаписиИстории.СоздатьЭлемент("session");			// catalog > session
	ЗаписиИстории.ДочерниеУзлы[0].ДобавитьДочерний(ЗаписьИстории);
	
	ЗаписьИстории.УстановитьАтрибут("date", XMLСтрока2(Информация.ДатаСоздания));
	
	УзелПараметры = ЗаписиИстории.СоздатьЭлемент("options");				// catalog > session > options
	
	Параметр_Каталог = ЗаписиИстории.СоздатьЭлемент("dir");				// catalog > session > options > dir
	Параметр_ТолькоВыгрузка = ЗаписиИстории.СоздатьЭлемент("copyonly");	// catalog > session > options > copyonly
	Параметр_СтрокаСоединения = ЗаписиИстории.СоздатьЭлемент("constr");	// catalog > session > options > constr
	Параметр_Пользователь = ЗаписиИстории.СоздатьЭлемент("user");		// catalog > session > options > user
	Параметр_ИмяКомпьютера = ЗаписиИстории.СоздатьЭлемент("host");		// catalog > session > options > host
	Параметр_Начало = ЗаписиИстории.СоздатьЭлемент("dateb");			// catalog > session > options > dateb
	Параметр_Окончание = ЗаписиИстории.СоздатьЭлемент("datee");			// catalog > session > options > datee
			
	СС = СтрокаСоединенияИнформационнойБазы();
	
	Параметр_ТолькоВыгрузка.ТекстовоеСодержимое = XMLСтрока2(Информация.ТолькоВыгрузка);
	Параметр_Каталог.ТекстовоеСодержимое = XMLСтрока2(Информация.Каталог);
	Параметр_СтрокаСоединения.ТекстовоеСодержимое = XMLСтрока2(СС);
	Параметр_Пользователь.ТекстовоеСодержимое = XMLСтрока2(Информация.Пользователь);
	Параметр_ИмяКомпьютера.ТекстовоеСодержимое = XMLСтрока2(Информация.ИмяКомпьютера);
	Параметр_Начало.ТекстовоеСодержимое = XMLСтрока2(Информация.Начало);
	Параметр_Окончание.ТекстовоеСодержимое = XMLСтрока2(Информация.Окончание);
	
	УзелПараметры.ДобавитьДочерний(Параметр_ТолькоВыгрузка);
	УзелПараметры.ДобавитьДочерний(Параметр_Каталог);
	УзелПараметры.ДобавитьДочерний(Параметр_СтрокаСоединения);
	УзелПараметры.ДобавитьДочерний(Параметр_Пользователь);
	УзелПараметры.ДобавитьДочерний(Параметр_ИмяКомпьютера);
	УзелПараметры.ДобавитьДочерний(Параметр_Начало);
	УзелПараметры.ДобавитьДочерний(Параметр_Окончание);
	
	Незавершенная = Ложь;
	Если Информация.Свойство("Незавершенная", Незавершенная) Тогда 
		Параметр_НеполноеЗавершение = ЗаписиИстории.СоздатьЭлемент("completed");			// catalog > session > options > completed
		Параметр_НеполноеЗавершение.ТекстовоеСодержимое = XMLСтрока2(Ложь);
		УзелПараметры.ДобавитьДочерний(Параметр_НеполноеЗавершение);
	КонецЕсли;
	
	Параметр_Организации = ЗаписиИстории.СоздатьЭлемент("orgs");		// catalog > session > options > orgs
	Для Каждого ДанныеОрганизации Из Информация.Организации Цикл 
		
		Параметр_Организация = ЗаписиИстории.СоздатьЭлемент("org");		// catalog > session > options > orgs > org
		Параметр_Организация.ТекстовоеСодержимое = XMLСтрока2(Строка(ДанныеОрганизации.Организация));
		Параметр_Организация.УстановитьАтрибут("uid", XMLСтрока2(ДанныеОрганизации.УникальныйИдентификатор));
		Параметр_Организация.УстановитьАтрибут("cat", XMLСтрока2(ДанныеОрганизации.Название));
		Параметр_Организация.УстановитьАтрибут("objcount", XMLСтрока2(ДанныеОрганизации.ОбъектовОтобрано));
		Параметр_Организации.ДобавитьДочерний(Параметр_Организация);
		
	КонецЦикла;
	УзелПараметры.ДобавитьДочерний(Параметр_Организации);
	
	Параметр_ВидыОбъектов = ЗаписиИстории.СоздатьЭлемент("types");	// catalog > session > options > types
	Для Каждого Вид Из Информация.ВидыОбъектов Цикл 
		Параметр_ВидОбъекта = ЗаписиИстории.СоздатьЭлемент("type");	// catalog > session > options > types > type
		Параметр_ВидОбъекта.УстановитьАтрибут("id", XMLСтрока2(Вид.Идентификатор));
		Параметр_ВидОбъекта.УстановитьАтрибут("cat", XMLСтрока2(НазванияГрупп.Получить(Вид.Идентификатор)));
		Параметр_ВидОбъекта.УстановитьАтрибут("objcount", XMLСтрока2(Вид.КоличествоОбъектов));
		Параметр_ВидыОбъектов.ДобавитьДочерний(Параметр_ВидОбъекта);
	КонецЦикла;
	УзелПараметры.ДобавитьДочерний(Параметр_ВидыОбъектов);
	
	Параметр_Органы = ЗаписиИстории.СоздатьЭлемент("authorities");	// catalog > session > options > authorities
	Для Каждого КО Из Информация.КонтролирующиеОрганы Цикл 
		Параметр_КОрган = ЗаписиИстории.СоздатьЭлемент("auth");	// catalog > session > options > authorities > auth
		Параметр_КОрган.УстановитьАтрибут("id", XMLСтрока2(КО.Название));
		Параметр_КОрган.УстановитьАтрибут("cat", XMLСтрока2(КО.Название));
		Параметр_КОрган.УстановитьАтрибут("objcount", XMLСтрока2(КО.КоличествоОбъектов));
		Параметр_Органы.ДобавитьДочерний(Параметр_КОрган);
	КонецЦикла;
	УзелПараметры.ДобавитьДочерний(Параметр_Органы);
	ЗаписьИстории.ДобавитьДочерний(УзелПараметры);
	
	ДлинныеИмена = ЗаписиИстории.СоздатьЭлемент("longnames");			// catalog > session > longnames
	Для Каждого Соотв Из КаталогДлинныхИмен.ТолькоНовые Цикл 
		ДлинноеИмя = ЗаписиИстории.СоздатьЭлемент("f");				// catalog > session > longnames > f		
		ДлинноеИмя.УстановитьАтрибут("s", XMLСтрока2(Соотв.Ключ));			// short
		ДлинноеИмя.УстановитьАтрибут("l", XMLСтрока2(Соотв.Значение));		// long
		ДлинныеИмена.ДобавитьДочерний(ДлинноеИмя);
	КонецЦикла;
	ЗаписьИстории.ДобавитьДочерний(ДлинныеИмена);
	
	ДлинныеИмена = ЗаписиИстории.СоздатьЭлемент("subj_short");			// catalog > session > subj_short	
	Для Каждого Соотв Из КаталогСокращений.Каталог Цикл 
		Если КаталогСокращений.Новые.Найти(Соотв.Ключ) = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		ДлинноеИмя = ЗаписиИстории.СоздатьЭлемент("f");				// catalog > session > subj_short > f		
		ДлинноеИмя.УстановитьАтрибут("c", XMLСтрока2(Соотв.Ключ));			// code
		ДлинноеИмя.УстановитьАтрибут("d", XMLСтрока2(Соотв.Значение));		// description
		
		КатРодитель = КаталогСокращений.КаталогРодителей.Получить(Соотв.Ключ);
		Если КатРодитель <> Неопределено Тогда 
			ДлинноеИмя.УстановитьАтрибут("p", XMLСтрока2(КатРодитель));		// parent code
		КонецЕсли;
					
		ДлинныеИмена.ДобавитьДочерний(ДлинноеИмя);
	КонецЦикла;
	ЗаписьИстории.ДобавитьДочерний(ДлинныеИмена);
	
	//Спр.ЗавершенаУспешно = Спр.Организации.Итог("ОбъектовОтобрано") = Спр.Организации.Итог("ОбъектовОбработано");
	
	Файл = Новый ЗаписьXML;
	Файл.ОткрытьФайл(ПолныйПутьКаталога, "UTF-8", Ложь);

	Запись = Новый ЗаписьDOM;
	Запись.Записать(ЗаписиИстории, Файл);
	
	Файл.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьКаталогИменИСокращений()
	
	#Если ВебКлиент Тогда 
	Возврат;
	#КонецЕсли

	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ДобавитьРазделительПути(КаталогАрхива) + "catalog.xml");
	Исключение
		Возврат;
	КонецПопытки;
	
	Построитель = Новый ПостроительDOM;	
	Каталог = Построитель.Прочитать(Чтение);	
	Чтение.Закрыть();
	
	#Если Не ВебКлиент Тогда 
		
	Разыменовыватель = Новый РазыменовательПространствИменDOM("","");
	Выражение = Каталог.СоздатьВыражениеXPath("//longnames/f", Разыменовыватель);
	Итератор = Выражение.Вычислить(Каталог, ТипРезультатаDOMXPath.УпорядоченныйИтераторУзлов);
	Узел = Итератор.ПолучитьСледующий();
	Пока ТипЗнч(Узел) = Тип("ЭлементDOM") Цикл 
		
		КороткоеИмя = Узел.ПолучитьАтрибут("s");
		ДлинноеИмя  = Узел.ПолучитьАтрибут("l");
		
		Если ЗначениеЗаполнено(КороткоеИмя) И ЗначениеЗаполнено(ДлинноеИмя) Тогда 
			КаталогДлинныхИмен.Каталог.Вставить(КороткоеИмя, ДлинноеИмя);
			КаталогДлинныхИмен.СтарыйКаталог.Вставить(ДлинноеИмя, КороткоеИмя);
			КаталогДлинныхИмен.Использованные.Добавить(КороткоеИмя);
		КонецЕсли;
	
		Узел = Итератор.ПолучитьСледующий();
	КонецЦикла;
	
	Выражение = Каталог.СоздатьВыражениеXPath("//subj_short/f", Разыменовыватель);
	Итератор = Выражение.Вычислить(Каталог, ТипРезультатаDOMXPath.УпорядоченныйИтераторУзлов);
	Узел = Итератор.ПолучитьСледующий();
	Пока ТипЗнч(Узел) = Тип("ЭлементDOM") Цикл 
		
		КороткоеИмя = Узел.ПолучитьАтрибут("c");
		ДлинноеИмя  = Узел.ПолучитьАтрибут("d");
		КодРодителя  = Узел.ПолучитьАтрибут("p");
		
		Если ЗначениеЗаполнено(КороткоеИмя) И ЗначениеЗаполнено(ДлинноеИмя) Тогда 
			КаталогСокращений.Каталог.Вставить(КороткоеИмя, ДлинноеИмя);
			КаталогСокращений.ОбратныйКаталог.Вставить(ДлинноеИмя, КороткоеИмя);
			КаталогСокращений.КаталогРодителей.Вставить(КороткоеИмя, КодРодителя);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодРодителя) Тогда 
			КаталогСокращений.КаталогРодителей.Вставить(КороткоеИмя, КодРодителя);
		КонецЕсли;
	
		Узел = Итератор.ПолучитьСледующий();
	КонецЦикла;
	
	
	#КонецЕсли

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДобавитьРазделительПути(Знач Каталог)
	
	Если ТипЗнч(Каталог) <> Тип("Строка") Тогда 
		Возврат "";
	КонецЕсли;
		
	Если Прав(Каталог, 1) <> "\" Тогда 
		Возврат Каталог + "\";
	КонецЕсли;
	
	Возврат Каталог;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОчиститьЗапрещенныеСимволы(ПолныйПуть, Расширенная = Ложь, ЧемЗаменить = "")
	
	ПолныйПуть = СтрЗаменить(ПолныйПуть, "*", ЧемЗаменить);
	ПолныйПуть = СтрЗаменить(ПолныйПуть, "?", ЧемЗаменить);
	ПолныйПуть = СтрЗаменить(ПолныйПуть, """", " ");
	ПолныйПуть = СтрЗаменить(ПолныйПуть, ">", ЧемЗаменить);
	ПолныйПуть = СтрЗаменить(ПолныйПуть, "<", ЧемЗаменить);
	
	Пока СтрЧислоВхождений(ПолныйПуть, "  ") > 0 Цикл //двойные пробелы
		ПолныйПуть = СтрЗаменить(ПолныйПуть, "  ", " ");
	КонецЦикла;
	
	Пока СтрЧислоВхождений(ПолныйПуть, "\\") > 0 Цикл //двойные слеши
		ПолныйПуть = СтрЗаменить(ПолныйПуть, "\\", "\");
	КонецЦикла;
	
	Пока СтрЧислоВхождений(ПолныйПуть, "//") > 0 Цикл //двойные слеши
		ПолныйПуть = СтрЗаменить(ПолныйПуть, "//", "/");
	КонецЦикла;	
	
	Если Расширенная Тогда 
		ПолныйПуть = СтрЗаменить(ПолныйПуть, ":", ЧемЗаменить);
	КонецЕсли;
	
	//Возврат "\\?\" + ПолныйПуть;
	Возврат ПолныйПуть;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьЗапрещенныеСимволы(ПолныйПуть)
	
	Возврат ОчиститьЗапрещенныеСимволы(ПолныйПуть, Истина, "_")
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МаксимальнаяДлинаКаталоговАрхивации()
	
	//БазовыйКаталог \ Организация \ Контролирующий орган \ Группа объекта \ Объект \ [ Цикл обмена \] Файлы объекта
	ДлинаКО = 6;
	ДлинаГр = 34;
	ДлинаОб = 37;
	ДлинаЦо = 16;
	ДлинаФп = 14; //Длина уникального идентификатора с расширением (для длинных файлов)
	
	Возврат ДлинаКО + 1 + ДлинаГр + 1 + ДлинаОб + 1 + ДлинаЦо + 1 + ДлинаФп;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста 
Функция ПолучитьРасширениеФайла(Знач ПолноеИмя)
	
	ФДлина = СтрДлина(ПолноеИмя);
	Для ш = 1 по ФДлина Цикл 
		Символ = Сред(ПолноеИмя, ФДлина - ш, 1);
		Если Символ = "." Тогда 
			Возврат Сред(ПолноеИмя, ФДлина - ш);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКороткийКод(Соотв, Знач Префикс = "", Знач ДлинаКода = 6)
	
	Попыток = 10;
	
	Пока Попыток > 0 Цикл
		Уид = НРег(Строка(Новый УникальныйИдентификатор));
		Уид = СтрЗаменить(Уид, "-", "");
		Для Ш = 1 по СтрДлина(Уид) - ДлинаКода + 1 Цикл 
			НовыйКод = Сред(Уид, ш, ДлинаКода);
			Если Соотв.Получить(Префикс + НовыйКод) = Неопределено Тогда 
				Возврат Префикс + НовыйКод;
			КонецЕсли;
		КонецЦикла;
		Попыток = Попыток - 1;
	КонецЦикла;
	
	Возврат Префикс + "@@FAIL";
	
КонецФункции
	
&НаСервереБезКонтекста
Функция ОпределитьВидРегОтчета(Знач НаименованиеОтчета, КаталогСокр)
	
	ВидДок = Справочники.ВидыОтправляемыхДокументов.НайтиПоНаименованию(НаименованиеОтчета, Истина);
	Если ВидДок <> Неопределено Тогда 
		Возврат ВидДок.Ссылка;
	КонецЕсли;
	
	ВидДок = Справочники.ВидыОтправляемыхДокументов.НайтиПоНаименованию(НаименованиеОтчета, Ложь);
	Если ВидДок <> Неопределено Тогда 
		Возврат ВидДок.Ссылка;
	КонецЕсли;
	
	Код = ПолучитьКороткийКод(КаталогСокр.Каталог, "P00");
	
	Возврат Новый Структура("Код, Наименование", Код, НаименованиеОтчета);
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКороткоеИмяФайла(ИспользованныеИмена, ПолноеИмя)
	
	Расширение = НРег(ПолучитьРасширениеФайла(ПолноеИмя));
	
	ДлинаКороткогоИмени = 10;
	Попыток = 10; //300 уникальных имен
	
	Пока Попыток > 0 Цикл
		Уид = НРег(Строка(Новый УникальныйИдентификатор));
		Уид = СтрЗаменить(Уид, "-", "");
		Для Ш = 1 по СтрДлина(Уид) - ДлинаКороткогоИмени + 1 Цикл 
			НовоеИмя = Сред(Уид, ш, ДлинаКороткогоИмени);
			Если ИспользованныеИмена.Найти(НовоеИмя + Расширение) = Неопределено Тогда 
				Возврат НовоеИмя + Расширение;
			КонецЕсли;
		КонецЦикла;
		Попыток = Попыток - 1;
	КонецЦикла;
	
	Для Ш = 1 по 9999999999 Цикл //10 млрд имён
		НовоеИмя = Формат(Ш, "ЧЦ=10; ЧВН=; ЧГ=");
		Если ИспользованныеИмена.Найти(НовоеИмя + Расширение) = Неопределено Тогда 
			Возврат НовоеИмя + Расширение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция СократитьПредставление(Знач ПредставлениеПериода)
	
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, " г.", "");
	
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "месяцев", "мес");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "месяца", "мес");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "месяц", "мес");
	
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "кварталов", "кв");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "квартала", "кв");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "квартал", "кв");
	
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "полугодий", "пг");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "полугодия", "пг");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "полугодие", "пг");
	
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "Январь", "Янв");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "Февраль", "Фев");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "Апрель", "Апр");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "Август", "Авг");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "Сентябрь", "Сен");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "Октябрь", "Окт");
	ПредставлениеПериода = СтрЗаменить(ПредставлениеПериода, "Декабрь", "Дек");
	
	Возврат ПредставлениеПериода;
	
КонецФункции

&НаСервере
Функция ПодобратьСокращение(Предмет = Неопределено, Знач СокрПредмет = Неопределено, КаталогСокр, Знач КодРодительскойГруппы = Неопределено)
	
	Если ТипЗнч(Предмет) = Тип("Строка") Тогда 
		Код = СокрЛП(Предмет);
	Иначе
		Код = СокрЛП(Предмет.Код);
	КонецЕсли;
	
	Если Код = "" Тогда //Для предметов произвольного формата выполняем обратный поиск
		Код = КаталогСокр.ОбратныйКаталог.Получить(СокрПредмет);
		Если Код = Неопределено Тогда
			Код = ПолучитьКороткийКод(КаталогСокр.Каталог, "GEN");
		КонецЕсли;		
	КонецЕсли;	
	
	Сокращение = КаталогСокр.Каталог.Получить(Код);
	
	Если Сокращение = Неопределено Тогда 
		Если СокрПредмет = Неопределено Тогда 
			Сокращение = СократитьПредложение(Предмет);
		Иначе
			Сокращение = СокрЛП(СокрПредмет);
		КонецЕсли;
		КаталогСокр.Каталог.Вставить(Код, Сокращение);
		КаталогСокр.ОбратныйКаталог.Вставить(Сокращение, Код);
		КаталогСокр.Новые.Добавить(Код);
		Если КодРодительскойГруппы <> Неопределено Тогда 
			КодРодительскойГруппыСохр = КаталогСокр.КаталогРодителей.Получить(Код);
			Если КодРодительскойГруппыСохр = Неопределено Тогда 
				КаталогСокр.КаталогРодителей.Вставить(Код, КодРодительскойГруппы);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗаменитьЗапрещенныеСимволы(Сокращение);
	
КонецФункции
	
&НаСервере
Функция ПолучитьКраткоеПредставление(ОбрабатываемыйОбъект, НазванияГрупп, КатГруппа, Знач ВхДатаСоздания = Неопределено, КаталогСокращенийПредметов, ОтборПредметы)
	
