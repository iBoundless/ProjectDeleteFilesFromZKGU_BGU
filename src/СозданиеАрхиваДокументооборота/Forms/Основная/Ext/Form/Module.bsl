&НаСервере
Функция ДобавитьПереключательФормы(Знач Название, Группа, ОбъектДанных, Обработчик = "ОтметитьФильтрПриИзменении")
	
	Ид = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧДЦ=; ЧН=; ЧГ=") + "_" + Формат(ЭтаФорма.Элементы.Количество(), "ЧДЦ=; ЧН=; ЧГ=");	
	Переключатель = ЭтаФорма.Элементы.Добавить("ДЧекбокс" + Ид, Тип("ПолеФормы"), Группа);
	Переключатель.Заголовок = Название;
	Переключатель.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Переключатель.Вид = ВидПоляФормы.ПолеФлажка;
	Переключатель.ВидФлажка = ВидФлажка.Флажок;
	Переключатель.Видимость = Истина;
	Переключатель.УстановитьДействие("ПриИзменении", Обработчик);
	
	ПутьКДанным = "%1[%2].Пометка";
	ПутьКДанным = СтрЗаменить(ПутьКДанным, "%1", ОбъектДанных);
	ПутьКДанным = СтрЗаменить(ПутьКДанным, "%2", Формат(ЭтотОбъект[ОбъектДанных].Количество(), "ЧДЦ=; ЧН=; ЧГ="));
	Переключатель.ПутьКДанным = ПутьКДанным;
	
	Возврат Переключатель.Имя;
	
