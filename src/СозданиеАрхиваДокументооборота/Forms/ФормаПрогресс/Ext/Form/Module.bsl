&НаКлиенте
Перем УспешноЗавершено;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "#ФормаПрогрессаПозиция" Тогда 
		Если Параметр = -1 Тогда //Завершено успешно
			Прогресс = 100;
			Завершено = Истина;
			УспешноЗавершено = Истина;
		ИначеЕсли Параметр = -2 Тогда //Завершено с ошибкой
			Завершено = Истина;
		Иначе
			Прогресс = Параметр;
		КонецЕсли;
		Если Завершено = Истина Тогда 
			Элементы.ОтменаЗакрыть.Заголовок = "Закрыть";
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "#ФормаПрогрессаЗаголовок" Тогда 
		ЭтотОбъект.Заголовок = Параметр;
	ИначеЕсли ИмяСобытия = "#ФормаПрогрессаНадпись" Тогда 
		Элементы.ТекстНадпись.Заголовок = Параметр;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовУправленияФормы

&НаКлиенте
Процедура ОтменаЗакрыть(Команда)
	
	ЭтотОбъект.Закрыть(УспешноЗавершено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УспешноЗавершено = Ложь;
	
КонецПроцедуры

#КонецОбласти