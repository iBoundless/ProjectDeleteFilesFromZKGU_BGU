#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТолькоТекущиеВерсии = Ложь;
	ЗаписатьЛог("Укажите каталог архива на этом компьютере и нажмите «Анализ».");
	ЗаписатьЛог("Очистка выполняется только для сеанса с завершённым и проверенным манифестом.");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КаталогАрхиваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог архива";
	Оповещение = Новый ОписаниеОповещения("КаталогАрхиваВыбран", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

// Обработчик завершения выбора каталога архива.
//
&НаКлиенте
Процедура КаталогАрхиваВыбран(ВыбранныйКаталог, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйКаталог <> Неопределено И ВыбранныйКаталог.Количество() > 0 Тогда
		КаталогАрхива = ВыбранныйКаталог[0];
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Анализ(Команда)
	
	ПодготовитьРезультат();
	ВыполнитьАнализКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура Архивировать(Команда)
	
	ПодготовитьРезультат();
	ВыполнитьАрхивированиеКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАрхив(Команда)
	
	Если ПустаяСтрока(Сеанс) Тогда
		ПоказатьПредупреждение(, "Не выбран сеанс архива.");
		Возврат;
	КонецЕсли;
	
	ПодготовитьРезультат();
	ВыполнитьПроверкуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	Если ПустаяСтрока(Сеанс) Тогда
		ПоказатьПредупреждение(, "Не выбран сеанс архива.");
		Возврат;
	КонецЕсли;
	
	Текст = "Будет очищено содержимое файлов, перечисленных в манифесте сеанса «" + Сеанс + "»."
		+ Символы.ПС + "Карточки файлов, версии и связи сохраняются."
		+ Символы.ПС + "Продолжить?";
	Оповещение = Новый ОписаниеОповещения("ОчиститьПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Обработчик подтверждения очистки содержимого файлов.
//
&НаКлиенте
Процедура ОчиститьПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПодготовитьРезультат();
		ВыполнитьОчисткуКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Восстановить(Команда)
	
	Если ПустаяСтрока(Сеанс) Тогда
		ПоказатьПредупреждение(, "Не выбран сеанс архива.");
		Возврат;
	КонецЕсли;
	
	Текст = "Будет восстановлено содержимое файлов из сеанса «" + Сеанс + "»."
		+ Символы.ПС + "Изменённое после архивирования содержимое перезаписываться не будет."
		+ Символы.ПС + "Продолжить?";
	Оповещение = Новый ОписаниеОповещения("ВосстановитьПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Обработчик подтверждения восстановления содержимого файлов.
//
&НаКлиенте
Процедура ВосстановитьПослеПодтверждения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПодготовитьРезультат();
		ВыполнитьВосстановлениеКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоследнийСеанс(Команда)
	
	Если ПустаяСтрока(КаталогАрхива) Тогда
		ЗаписатьЛогКлиент("Не указан каталог архива.");
		Возврат;
	КонецЕсли;
	
	Попытка
		Файлы = НайтиФайлы(КаталогАрхива, "Сеанс_*");
	Исключение
		ЗаписатьЛогКлиент("Не удалось прочитать каталог: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Последний = "";
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ЭтоКаталог() И Файл.Имя > Последний Тогда
			Последний = Файл.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(Последний) Тогда
		ЗаписатьЛогКлиент("Сеансы архива не найдены.");
	Иначе
		Сеанс = Последний;
		ЗаписатьЛогКлиент("Выбран последний сеанс: " + Последний);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКаталог(Команда)
	
	ПодготовитьРезультат();
	
	Если ПустаяСтрока(КаталогАрхива) Тогда
		ЗаписатьЛогКлиент("Не указан каталог архива.");
		Возврат;
	КонецЕсли;
	
	Попытка
		СоздатьКаталог(КаталогАрхива);
		ПроверитьЗаписьВКаталогКлиент();
		ЗаписатьЛогКлиент("Каталог существует. Доступность записи будет проверена при создании архива: " + КаталогАрхива);
	Исключение
		ЗаписатьЛогКлиент("Каталог недоступен: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область КлиентскийДвижокОпераций

&НаКлиенте
Процедура ВыполнитьАрхивированиеКлиент()
	
	Если ПустаяСтрока(КаталогАрхива) Тогда
		ЗаписатьЛогКлиент("Не указан каталог архива.");
		Возврат;
	КонецЕсли;
	
	Попытка
		СоздатьКаталог(КаталогАрхива);
		ПроверитьЗаписьВКаталогКлиент();
	Исключение
		ЗаписатьЛогКлиент("Каталог недоступен для записи: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// Прогресс открывается до построения очереди: очередь строится одним
	// серверным вызовом и может строиться долго — об этом нужно сообщить.
	НачатьПрогресс("Формирование очереди архива");
	Попытка
		ИмяСеанса = Архив_НачатьНаСервере();
	Исключение
		ЗаписатьЛогКлиент("Ошибка формирования очереди: " + ОписаниеОшибки());
		ЗавершитьПрогресс();
		Возврат;
	КонецПопытки;
	
	// Пустая очередь — не ошибка записи манифеста: сообщение отдельное.
	Если КоличествоОжидаемых() = 0 Тогда
		ЗаписатьЛогКлиент("Нет файлов для архивирования: в очереди нет записей с хранением"
			+ " в информационной базе подходящего типа.");
		ЗавершитьПрогресс();
		Возврат;
	КонецЕсли;
	
	КаталогСеанса = ПутьСеансаКлиент(ИмяСеанса);
	Попытка
		СоздатьКаталог(ДобавитьРазделительПутиКлиент(КаталогСеанса) + "files");
	Исключение
		ЗаписатьЛогКлиент("Не удалось создать каталог сеанса: " + ОписаниеОшибки());
		ЗавершитьПрогресс();
		Возврат;
	КонецПопытки;
	
	НачатьПрогресс("Выполняется архивирование");
	Попытка
		Всего = ОчередьФайлов.Количество();
		ЗаписатьЛогКлиент("Единиц к обработке: " + Формат(Всего, "ЧН=0; ЧГ=0"));
		
		Для Индекс = 0 По Всего - 1 Цикл
			Пакет = Архив_ПодготовитьФайлНаСервере(Индекс);
			Если Не Пакет.Пропустить Тогда
				Попытка
					Данные = ПолучитьИзВременногоХранилища(Пакет.Адрес);
					Путь = ПутьФайлаАрхиваКлиент(ИмяСеанса, ОчередьФайлов[Индекс].ОтнПуть);
					Данные.Записать(Путь);
					Архив_ПодтвердитьНаСервере(Индекс);
				Исключение
					ЗаписатьЛогКлиент("Ошибка записи файла архива: " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
			ОбновитьПрогресс(Индекс + 1, Всего, "Обработано " + Формат(Индекс + 1, "ЧН=0; ЧГ=0")
				+ " из " + Формат(Всего, "ЧН=0; ЧГ=0"));
		КонецЦикла;
		
		Попытка
			ТекстМанифеста = Архив_ЗавершитьНаСервере(ИмяСеанса);
			ЗаписатьТекстФайлаКлиент(ДобавитьРазделительПутиКлиент(КаталогСеанса) + "manifest.json", ТекстМанифеста);
			Сеанс = ИмяСеанса;
			ЗаписатьЛогКлиент("Манифест записан. Перед очисткой выполните «Проверить архив».");
		Исключение
			ЗаписатьЛогКлиент("Не удалось записать манифест: " + ОписаниеОшибки()
				+ ". Сеанс нельзя использовать для очистки.");
		КонецПопытки;
	Исключение
		ЗаписатьЛогКлиент("Ошибка архивирования: " + ОписаниеОшибки());
	КонецПопытки;
	
	ЗавершитьПрогресс();
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПрогресс(Заголовок)
	
	Прогресс = 0;
	ПрогрессНадпись = Заголовок;
	ПрогрессВидимость = Истина;
	Элементы.ГруппаПрогресса.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПрогресс(Обработано, Всего, Текст)
	
	Если Всего > 0 Тогда
		Прогресс = Цел(Обработано * 100 / Всего);
	КонецЕсли;
	ПрогрессНадпись = Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПрогресс()
	
	ПрогрессВидимость = Ложь;
	Элементы.ГруппаПрогресса.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАнализКлиент()
	
	Источники = Анализ_ИсточникиНаСервере();
	Всего = Источники.Количество();
	Если Всего = 0 Тогда
		ЗаписатьЛогКлиент("Не найдено ни одного справочника с присоединёнными файлами.");
		Возврат;
	КонецЕсли;
	
	ВсегоБайт = 0;
	ПоддерживаемыхБайт = 0;
	ПоддерживаемыхЗаписей = 0;
	Исключено = 0;
	
	НачатьПрогресс("Анализ состава файлов");
	Попытка
		Для Индекс = 0 По Всего - 1 Цикл
			Шаг = Анализ_ШагНаСервере(Источники[Индекс].Вид, Источники[Индекс].Имя);
			ВсегоБайт = ВсегоБайт + Шаг.ВсегоБайт;
			ПоддерживаемыхБайт = ПоддерживаемыхБайт + Шаг.ПоддерживаемыхБайт;
			ПоддерживаемыхЗаписей = ПоддерживаемыхЗаписей + Шаг.ПоддерживаемыхЗаписей;
			Исключено = Исключено + Шаг.Исключено;
			ОбновитьПрогресс(Индекс + 1, Всего,
				"Проанализировано " + Формат(Индекс + 1, "ЧН=0; ЧГ=0") + " из "
				+ Формат(Всего, "ЧН=0; ЧГ=0") + ": " + Источники[Индекс].Представление);
		КонецЦикла;
		Анализ_ИтогиНаСервере(ВсегоБайт, ПоддерживаемыхБайт, ПоддерживаемыхЗаписей, Исключено);
	Исключение
		ЗаписатьЛогКлиент("Ошибка анализа: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьПрогресс();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуКлиент()
	
	Если Не ЗагрузитьМанифестКлиент(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьПрогресс("Проверка архива");
	Попытка
		Если Не ПроверитьФайлыАрхиваКлиент() Тогда
			ЗаписатьЛогКлиент("Архив содержит ошибки. Очистка запрещена.");
			ЗавершитьПрогресс();
			Возврат;
		КонецЕсли;
		
		Попытка
			ТекстМанифеста = Манифест_ОтметитьПровереннымНаСервере();
			ЗаписатьТекстФайлаКлиент(ПутьМанифестаКлиент(), ТекстМанифеста);
			ЗаписатьЛогКлиент("Архив целостен, манифест помечен проверенным.");
		Исключение
			ЗаписатьЛогКлиент("Архив целостен, но не удалось обновить манифест: " + ОписаниеОшибки());
		КонецПопытки;
	Исключение
		ЗаписатьЛогКлиент("Ошибка проверки архива: " + ОписаниеОшибки());
	КонецПопытки;
	
	ЗавершитьПрогресс();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОчисткуКлиент()
	
	Если Не ЗагрузитьМанифестКлиент(Истина) Тогда
		Возврат;
	КонецЕсли;
	
	// Перед очисткой архив проверяется заново: файлы должны существовать
	// и совпадать по хешу с манифестом.
	НачатьПрогресс("Проверка архива");
	Попытка
		Если Не ПроверитьФайлыАрхиваКлиент() Тогда
			ЗаписатьЛогКлиент("Очистка отменена: архив не прошёл проверку.");
			ЗавершитьПрогресс();
			Возврат;
		КонецЕсли;
	Исключение
		ЗаписатьЛогКлиент("Очистка отменена: ошибка проверки архива: " + ОписаниеОшибки());
		ЗавершитьПрогресс();
		Возврат;
	КонецПопытки;
	ЗавершитьПрогресс();
	
	// Строки проверки уже заняли место в таблице результатов (её лимит —
	// 500 строк), поэтому её нужно очистить: иначе результаты очистки
	// не покажутся вовсе.
	ТаблицаРезультата.Очистить();
	
	Всего = ОчередьФайлов.Количество();
	Очищено = 0;
	Пропущено = 0;
	Ошибок = 0;
	
	НачатьПрогресс("Очистка содержимого");
	Попытка
		Для Индекс = 0 По Всего - 1 Цикл
			Если Не ОчередьФайлов[Индекс].Заархивирован Тогда
				ОбновитьПрогресс(Индекс + 1, Всего, "Обработано " + Формат(Индекс + 1, "ЧН=0; ЧГ=0")
					+ " из " + Формат(Всего, "ЧН=0; ЧГ=0"));
				Продолжить;
			КонецЕсли;
			
			РезультатОчистки = Очистка_ОчиститьЗаписьНаСервере(Индекс);
			Если РезультатОчистки.Результат = "Очищено" Тогда
				Очищено = Очищено + 1;
			ИначеЕсли РезультатОчистки.Результат = "Пропущено" Тогда
				Пропущено = Пропущено + 1;
			Иначе
				Ошибок = Ошибок + 1;
			КонецЕсли;
			
			ОбновитьПрогресс(Индекс + 1, Всего, "Обработано " + Формат(Индекс + 1, "ЧН=0; ЧГ=0")
				+ " из " + Формат(Всего, "ЧН=0; ЧГ=0"));
		КонецЦикла;
	Исключение
		ЗаписатьЛогКлиент("Ошибка очистки: " + ОписаниеОшибки()
			+ ". Уже обработанные записи очищены, повторный запуск продолжит с пропусков.");
	КонецПопытки;
	ЗавершитьПрогресс();
	
	ЗаписатьЛогКлиент("Очищено: " + Формат(Очищено, "ЧН=0; ЧГ=0")
		+ ", пропущено: " + Формат(Пропущено, "ЧН=0; ЧГ=0")
		+ ", ошибок: " + Формат(Ошибок, "ЧН=0; ЧГ=0") + ".");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВосстановлениеКлиент()
	
	Если Не ЗагрузитьМанифестКлиент(Истина) Тогда
		Возврат;
	КонецЕсли;
	
	Всего = ОчередьФайлов.Количество();
	НачатьПрогресс("Восстановление");
	Попытка
		Для Индекс = 0 По Всего - 1 Цикл
			СтрокаФайла = ОчередьФайлов[Индекс];
			Попытка
				// Путь вычисляется внутри Попытки: проверка имени сеанса может
				// отказать, и тогда операция должна завершиться с сообщением.
				Путь = ПутьФайлаАрхиваКлиент(Сеанс, СтрокаФайла.ОтнПуть);
				Если Не ФайлСуществуетКлиент(Путь) Тогда
					ЗаписатьЛогКлиент("Файл архива отсутствует: " + СтрокаФайла.ОтнПуть);
					Продолжить;
				КонецЕсли;
				Данные = Новый ДвоичныеДанные(Путь);
				Адрес = ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор());
				Восстановление_ВосстановитьНаСервере(Индекс, Адрес);
			Исключение
				ЗаписатьЛогКлиент("Ошибка восстановления " + СтрокаФайла.ОтнПуть + ": " + ОписаниеОшибки());
			КонецПопытки;
			
			ОбновитьПрогресс(Индекс + 1, Всего, "Обработано " + Формат(Индекс + 1, "ЧН=0; ЧГ=0")
				+ " из " + Формат(Всего, "ЧН=0; ЧГ=0"));
		КонецЦикла;
	Исключение
		ЗаписатьЛогКлиент("Ошибка восстановления: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьПрогресс();
	
КонецПроцедуры

#КонецОбласти

#Область КлиентскаяРаботаСАрхивом

&НаКлиенте
Функция ЗагрузитьМанифестКлиент(ТребоватьПроверенный)
	
	Путь = ПутьМанифестаКлиент();
	Если Не ФайлСуществуетКлиент(Путь) Тогда
		ЗаписатьЛогКлиент("Файл манифеста не найден: " + Путь);
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ТекстJSON = ПрочитатьТекстФайлаКлиент(Путь);
	Исключение
		ЗаписатьЛогКлиент("Не удалось прочитать манифест: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Манифест_ЗагрузитьНаСервере(ТекстJSON, ТребоватьПроверенный);
	
КонецФункции

// Проверяет все файлы архива текущего сеанса по размеру и SHA-256.
// Хеш считается на сервере: тип ХешированиеДанных на клиенте недоступен.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибок нет.
//
&НаКлиенте
Функция ПроверитьФайлыАрхиваКлиент()
	
	Ошибок = 0;
	Проверено = 0;
	Всего = ОчередьФайлов.Количество();
	
	Для Индекс = 0 По Всего - 1 Цикл
		СтрокаФайла = ОчередьФайлов[Индекс];
		Попытка
			Путь = ПутьФайлаАрхиваКлиент(Сеанс, СтрокаФайла.ОтнПуть);
			Если Не ФайлСуществуетКлиент(Путь) Тогда
				ВызватьИсключение "файл отсутствует";
			КонецЕсли;
			Данные = Новый ДвоичныеДанные(Путь);
			Адрес = ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор());
			Если Не Проверка_ПроверитьФайлНаСервере(Индекс, Адрес) Тогда
				ВызватьИсключение "размер или хеш не совпадает";
			КонецЕсли;
			Проверено = Проверено + 1;
		Исключение
			Ошибок = Ошибок + 1;
			ДобавитьСтрокуРезультатаКлиент(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии, СтрокаФайла.Наименование,
				СтрокаФайла.Размер, "Ошибка", ОписаниеОшибки());
			ЗаписатьЛогКлиент("Ошибка проверки " + СтрокаФайла.ОтнПуть + ": " + ОписаниеОшибки());
		КонецПопытки;
		ОбновитьПрогресс(Индекс + 1, Всего, "Проверено " + Формат(Индекс + 1, "ЧН=0; ЧГ=0")
			+ " из " + Формат(Всего, "ЧН=0; ЧГ=0"));
	КонецЦикла;
	
	ЗаписатьЛогКлиент("Проверено записей: " + Формат(Проверено, "ЧН=0; ЧГ=0")
		+ ", ошибок: " + Формат(Ошибок, "ЧН=0; ЧГ=0") + ".");
	Возврат Ошибок = 0;
	
КонецФункции

&НаКлиенте
Функция ПутьСеансаКлиент(ИмяСеанса)
	
	Возврат ДобавитьРазделительПутиКлиент(КаталогАрхива) + ИмяСеанса;
	
КонецФункции

&НаКлиенте
Функция ПутьМанифестаКлиент()
	
	ПроверитьИмяСеансаКлиент(Сеанс);
	Возврат ДобавитьРазделительПутиКлиент(ПутьСеансаКлиент(Сеанс)) + "manifest.json";
	
КонецФункции

&НаКлиенте
Функция ПутьФайлаАрхиваКлиент(ИмяСеанса, ОтнПуть)
	
	Отн = СтрЗаменить(Строка(ОтнПуть), "\", "/");
	Если Найти(Отн, "..") <> 0 Или Лев(Отн, 6) <> "files/" Тогда
		ВызватьИсключение "Недопустимый путь в манифесте.";
	КонецЕсли;
	Возврат ДобавитьРазделительПутиКлиент(ПутьСеансаКлиент(ИмяСеанса))
		+ СтрЗаменить(Отн, "/", ПолучитьРазделительПути());
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИмяСеансаКлиент(Имя)
	
	Если ПустаяСтрока(Имя) Тогда
		ВызватьИсключение "Не выбран сеанс архива.";
	КонецЕсли;
	Если Найти(Имя, "..") <> 0 Или Найти(Имя, "/") <> 0 Или Найти(Имя, "\") <> 0 Тогда
		ВызватьИсключение "Недопустимое имя сеанса.";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ФайлСуществуетКлиент(Путь)
	
	ФайлНаДиске = Новый Файл(Путь);
	Возврат ФайлНаДиске.Существует();
	
КонецФункции

&НаКлиенте
Функция ПрочитатьТекстФайлаКлиент(Путь)
	
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьТекстФайлаКлиент(Путь, Текст)
	
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Текст);
	Документ.Записать(Путь, КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаписьВКаталогКлиент()
	
	Каталог = Новый Файл(КаталогАрхива);
	Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда
		ВызватьИсключение "каталог не существует или не является каталогом";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДобавитьРазделительПутиКлиент(Путь)
	
	Результат = Строка(Путь);
	Если ПустаяСтрока(Результат) Тогда
		Возврат "";
	КонецЕсли;
	Последний = Прав(Результат, 1);
	Если Последний <> "\" И Последний <> "/" Тогда
		Результат = Результат + ПолучитьРазделительПути();
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьСтрокуРезультатаКлиент(ОбъектСтроки, Версия, Имя, Размер, Состояние, Сообщение)
	
	Если ТаблицаРезультата.Количество() >= 500 Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ТаблицаРезультата.Добавить();
	СтрокаТаблицы.Объект = ОбъектСтроки;
	СтрокаТаблицы.Версия = Версия;
	СтрокаТаблицы.Имя = Имя;
	СтрокаТаблицы.Размер = Размер;
	СтрокаТаблицы.Состояние = Состояние;
	СтрокаТаблицы.Сообщение = Сообщение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьРезультат()
	
	ТаблицаРезультата.Очистить();
	ТекстЛога = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЛогКлиент(Знач Текст)
	
	Если Не ПустаяСтрока(ТекстЛога) Тогда
		ТекстЛога = ТекстЛога + Символы.ПС;
	КонецЕсли;
	ТекстЛога = ТекстЛога + Текст;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныйАнализ

// Период задан, если заполнена хотя бы одна его граница.
&НаСервере
Функция ПериодЗадан()
	
	Возврат ЗначениеЗаполнено(Период.ДатаНачала) Или ЗначениеЗаполнено(Период.ДатаОкончания);
	
КонецФункции

// Принадлежность записи периоду. При незаданном периоде дата не вычисляется
// вовсе: в очередь попадают все записи, включая записи без даты. Логика
// вынесена отдельно от ЭффективнаяДата, чтобы незаданный период не приводил
// к чтению реквизитов владельца.
&НаСервере
Функция ЗаписьВПериоде(ВладелецФайла, ДатаСоздания, Кеш)
	
	Если Не ПериодЗадан() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ВПериоде(ЭффективнаяДата(ВладелецФайла, ДатаСоздания, Кеш));
	
КонецФункции

// Принадлежность даты периоду. Записи без даты в заданный период не входят.
&НаСервере
Функция ВПериоде(ДатаСобытия)
	
	Если Не ПериодЗадан() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСобытия) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачалоГраницы = Период.ДатаНачала;
	КонецГраницы = Период.ДатаОкончания;
	
	Если ЗначениеЗаполнено(НачалоГраницы) И ДатаСобытия < НачалоДня(НачалоГраницы) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонецГраницы) И ДатаСобытия > КонецДня(КонецГраницы) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Дата владельца файла. У справочников реквизита «Дата» обычно нет:
// обращение к отсутствующему реквизиту перехватывается и кешируется.
&НаСервере
Функция ДатаВладельцаЗаписи(ВладелецФайла)
	
	Попытка
		ДатаВладельца = ВладелецФайла.Дата;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ДатаВладельца) Тогда
		Возврат ДатаВладельца;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Дата, по которой отбираются записи: дата документа-владельца, если она
// есть и заполнена, иначе дата создания файла.
&НаСервере
Функция ЭффективнаяДата(ВладелецФайла, ДатаСоздания, Кеш)
	
	Если ВладелецФайла = Неопределено Тогда
		Возврат ДатаСоздания;
	КонецЕсли;
	
	// У Соответствия нет метода Найти: поиск — Получить. Он возвращает
	// Неопределено и для отсутствующего ключа, и для сохранённого Неопределено,
	// поэтому отсутствие даты кешируется пустой датой (Неопределено в кеш не
	// попадает никогда).
	Найденное = Кеш.Получить(ВладелецФайла);
	Если Найденное <> Неопределено Тогда
		Если Найденное = Дата(1, 1, 1) Тогда
			Возврат ДатаСоздания;
		КонецЕсли;
		Возврат Найденное;
	КонецЕсли;
	
	ДатаВладельца = ДатаВладельцаЗаписи(ВладелецФайла);
	Если ДатаВладельца = Неопределено Тогда
		Кеш.Вставить(ВладелецФайла, Дата(1, 1, 1));
		Возврат ДатаСоздания;
	КонецЕсли;
	Кеш.Вставить(ВладелецФайла, ДатаВладельца);
	Возврат ДатаВладельца;
	
КонецФункции

&НаСервере
Функция ОписаниеПериода()
	
	Если ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		НачалоГраницы = Формат(НачалоДня(Период.ДатаНачала), "ДФ=dd.MM.yyyy");
	Иначе
		НачалоГраницы = "начало не ограничено";
	КонецЕсли;
	Если ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		КонецГраницы = Формат(КонецДня(Период.ДатаОкончания), "ДФ=dd.MM.yyyy");
	Иначе
		КонецГраницы = "окончание не ограничено";
	КонецЕсли;
	Возврат "с " + НачалоГраницы + " по " + КонецГраницы;
	
КонецФункции


&НаСервере
Функция Анализ_ИсточникиНаСервере()
	
	Источники = Новый Массив;
	Источники.Добавить(Новый Структура("Вид, Имя, Представление",
		"Версии", "", "Справочник.ВерсииФайлов"));
	Источники.Добавить(Новый Структура("Вид, Имя, Представление",
		"ФайлыБезВерсий", "", "Справочник.Файлы (без версий)"));
	Для Каждого ИмяСправочника Из ИменаСправочниковПрисоединенныхФайлов() Цикл
		Источники.Добавить(Новый Структура("Вид, Имя, Представление",
			"Присоединенный", ИмяСправочника, "Справочник." + ИмяСправочника));
	КонецЦикла;
	Возврат Источники;
	
КонецФункции

// Один шаг анализа — один справочник. Шаг вынесен в отдельный серверный
// вызов, чтобы клиент успевал обновлять прогресс: справочников сотни.
//
// Возвращаемое значение:
//   Структура - ВсегоБайт, ПоддерживаемыхБайт, ПоддерживаемыхЗаписей, Исключено.
//
&НаСервере
Функция Анализ_ШагНаСервере(Вид, ИмяСправочника)
	
	КешДат = Новый Соответствие;
	Статистика = Новый Соответствие;
	Исключено = 0;
	
	Если Вид = "Версии" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаАнализаВерсий();
		Исключено = Анализ_Пройти(Статистика, "Справочник.ВерсииФайлов", Запрос, КешДат);
	ИначеЕсли Вид = "ФайлыБезВерсий" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаАнализаФайловБезВерсий();
		Исключено = Анализ_Пройти(Статистика, "Справочник.Файлы (без версий)", Запрос, КешДат);
	ИначеЕсли Вид = "Присоединенный" Тогда
		Мета = Метаданные.Справочники.Найти(ИмяСправочника);
		Если Мета <> Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапросаПрисоединенныхФайлов(Мета, Ложь);
			Исключено = Анализ_Пройти(Статистика, "Справочник." + Мета.Имя, Запрос, КешДат);
		КонецЕсли;
	Иначе
		ВызватьИсключение "Неизвестный вид источника анализа: " + Вид;
	КонецЕсли;
	
	Итог = Новый Структура("ВсегоБайт, ПоддерживаемыхБайт, ПоддерживаемыхЗаписей, Исключено",
		0, 0, 0, Исключено);
	Для Каждого Элемент Из Статистика Цикл
		Запись = Элемент.Значение;
		ДобавитьГруппуСтатистики(Запись.Группа, Запись.ТипХранения, Запись.Количество, Запись.Размер);
		Итог.ВсегоБайт = Итог.ВсегоБайт + Запись.Размер;
		Если ЭтоХранениеВИнформационнойБазе(Запись.ТипХранения) Тогда
			Итог.ПоддерживаемыхБайт = Итог.ПоддерживаемыхБайт + Запись.Размер;
			Итог.ПоддерживаемыхЗаписей = Итог.ПоддерживаемыхЗаписей + Запись.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
	
КонецФункции

// Проходит выборку и накапливает статистику по типу хранения. Если период
// задан, записи вне периода отбрасываются; незаданный период даты не
// вычисляет вовсе, поэтому в статистику попадают и записи без даты.
&НаСервере
Функция Анализ_Пройти(Статистика, Группа, Запрос, КешДат)
	
	Исключено = 0;
	ПоПериоду = ПериодЗадан();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПоПериоду И Не ЗаписьВПериоде(Выборка.ВладелецФайла, Выборка.ДатаСоздания, КешДат) Тогда
			Исключено = Исключено + 1;
			Продолжить;
		КонецЕсли;
		ДобавитьСтатистику(Статистика, Группа, Выборка.ТипХранения, 1, Выборка.Размер);
	КонецЦикла;
	Возврат Исключено;
	
КонецФункции

&НаСервере
Процедура Анализ_ИтогиНаСервере(ВсегоБайт, ПоддерживаемыхБайт, ПоддерживаемыхЗаписей, Исключено)
	
	Если ПериодЗадан() Тогда
		ЗаписатьЛог("Период отбора: " + ОписаниеПериода() + ".");
		ЗаписатьЛог("Исключено по периоду записей: " + Формат(Исключено, "ЧН=0; ЧГ=0")
			+ " (записи без подходящей даты в заданный период не попадают).");
	Иначе
		ЗаписатьЛог("Период не задан: в анализ вошли все записи, включая записи без даты.");
	КонецЕсли;
	ЗаписатьЛог("Всего: " + Формат(ВсегоБайт, "ЧН=0; ЧГ=0") + " байт.");
	ЗаписатьЛог("В архив войдут только файлы с типом хранения «В информационной базе»: "
		+ Формат(ПоддерживаемыхЗаписей, "ЧН=0; ЧГ=0") + " записей, "
		+ Формат(ПоддерживаемыхБайт, "ЧН=0; ЧГ=0") + " байт.");
	ЗаписатьЛог("Тома, внешние хранилища и прочие типы хранения в очередь не включаются.");
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаАнализаВерсий()
	
	Текст = "ВЫБРАТЬ
		|	Версии.Владелец.ВладелецФайла КАК ВладелецФайла,
		|	Версии.ДатаСоздания КАК ДатаСоздания,
		|	Версии.Размер КАК Размер,
		|	Версии.ТипХраненияФайла КАК ТипХранения
		|ИЗ
		|	Справочник.ВерсииФайлов КАК Версии
		|ГДЕ
		|	НЕ Версии.ПометкаУдаления
		|	И НЕ Версии.Владелец.ПометкаУдаления";
	Если ТолькоТекущиеВерсии Тогда
		Текст = Текст + "
			|	И Версии.Ссылка В (
			|		ВЫБРАТЬ
			|			Файлы.ТекущаяВерсия
			|		ИЗ
			|			Справочник.Файлы КАК Файлы
			|		ГДЕ
			|			НЕ Файлы.ПометкаУдаления
			|			И Файлы.ТекущаяВерсия ЕСТЬ НЕ NULL)";
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаАнализаФайловБезВерсий()
	
	Возврат "ВЫБРАТЬ
		|	Файлы.ВладелецФайла КАК ВладелецФайла,
		|	Файлы.ДатаСоздания КАК ДатаСоздания,
		|	Файлы.Размер КАК Размер,
		|	Файлы.ТипХраненияФайла КАК ТипХранения
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	НЕ Файлы.ПометкаУдаления
		|	И (Файлы.ТекущаяВерсия ЕСТЬ NULL ИЛИ Файлы.ТекущаяВерсия = ЗНАЧЕНИЕ(Справочник.ВерсииФайлов.ПустаяСсылка))
		|	И Файлы.Размер > 0";
	
КонецФункции

&НаСервере
Процедура ДобавитьСтатистику(Статистика, Группа, ТипХранения, Количество, Размер)
	
	Ключ = Группа + "|" + Строка(ТипХранения);
	Запись = Статистика.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Статистика.Вставить(Ключ, Новый Структура("Группа, ТипХранения, Количество, Размер",
			Группа, ТипХранения, Количество, Размер));
	Иначе
		Запись.Количество = Запись.Количество + Количество;
		Запись.Размер = Запись.Размер + Размер;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверноеАрхивирование

&НаСервере
Функция Архив_НачатьНаСервере()
	
	ОчередьФайлов.Очистить();
	
	ИмяСеанса = СформироватьИмяСеанса();
	
	Шапка = Новый Соответствие;
	Шапка.Вставить("formatVersion", 2);
	Шапка.Вставить("sessionId", ИмяСеанса);
	Шапка.Вставить("createdAt", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
	Шапка.Вставить("periodStart", ?(ЗначениеЗаполнено(Период.ДатаНачала),
		Формат(НачалоДня(Период.ДатаНачала), "ДФ=yyyy-MM-dd HH:mm:ss"), ""));
	Шапка.Вставить("periodEnd", ?(ЗначениеЗаполнено(Период.ДатаОкончания),
		Формат(КонецДня(Период.ДатаОкончания), "ДФ=yyyy-MM-dd HH:mm:ss"), ""));
	Шапка.Вставить("user", ИмяПользователя());
	Шапка.Вставить("configName", Метаданные.Имя);
	Шапка.Вставить("configVersion", Метаданные.Версия);
	Шапка.Вставить("onlyCurrentVersions", ТолькоТекущиеВерсии);
	Шапка.Вставить("infobaseId", ИдентификаторБазыДляАрхива());
	Шапка.Вставить("dataArea", ОбластьДанныхДляАрхива());
	МанифестШапка = СформироватьJSONСтроку(Шапка);
	
	Если ПустаяСтрока(Шапка.Получить("infobaseId")) Или Шапка.Получить("dataArea") < 0 Тогда
		ЗаписатьЛог("Не удалось определить идентификатор базы или области данных:"
			+ " очистка и восстановление для этого сеанса будут недоступны.");
	КонецЕсли;
	
	// Один кеш дат на все три построителя очереди: владелец читается один раз.
	КешДат = Новый Соответствие;
	Счётчики = Новый Структура("Исключено, БезДаты", 0, 0);
	Архив_ДобавитьВерсии(КешДат, Счётчики);
	Архив_ДобавитьФайлыБезВерсий(КешДат, Счётчики);
	Архив_ДобавитьПрисоединенные(КешДат, Счётчики);
	
	Если ПериодЗадан() Тогда
		ЗаписатьЛог("Исключено по периоду записей: " + Формат(Счётчики.Исключено, "ЧН=0; ЧГ=0")
			+ ", из них без подходящей даты: " + Формат(Счётчики.БезДаты, "ЧН=0; ЧГ=0") + ".");
	КонецЕсли;
	
	ЗаписатьЛог("В очередь включено записей с хранением в информационной базе: "
		+ Формат(ОчередьФайлов.Количество(), "ЧН=0; ЧГ=0") + ".");
	ЗаписатьЛог("Сеанс: " + ИмяСеанса);
	Возврат ИмяСеанса;
	
КонецФункции

&НаСервере
Функция Архив_ПодготовитьФайлНаСервере(Индекс)
	
	Результат = Новый Структура("Пропустить, Адрес", Истина, "");
	СтрокаФайла = ОчередьФайлов[Индекс];
	ИмяФайла = СформироватьИмяФайла(СтрокаФайла.Наименование, СтрокаФайла.Расширение);
	
	Если Не СтрокаФайла.Поддерживается Тогда
		ЗаписатьЛог("Пропуск " + ИмяФайла + ": тип хранения «" + СтрокаФайла.ТипХранения + "».");
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Ссылка = СсылкаПоСтроке(СтрокаФайла);
		ОбъектДанных = Ссылка.ПолучитьОбъект();
		Если ОбъектДанных = Неопределено Тогда
			ВызватьИсключение "объект не найден";
		КонецЕсли;
		
		// Тип хранения мог измениться после анализа. В архив принимаются
		// только файлы, физически хранящиеся в информационной базе.
		Если Не ЭтоХранениеВИнформационнойБазе(ОбъектДанных.ТипХраненияФайла) Тогда
			СтрокаФайла.Поддерживается = Ложь;
			СтрокаФайла.ТипХранения = Строка(ОбъектДанных.ТипХраненияФайла);
			ЗаписатьЛог("Пропуск " + ИмяФайла + ": тип хранения изменился на «" + СтрокаФайла.ТипХранения + "».");
			Возврат Результат;
		КонецЕсли;
		
		Данные = СодержимоеФайлаИзИБ(Ссылка);
		Если Данные = Неопределено Или Данные.Размер() = 0 Тогда
			// Пустое содержимое нечего архивировать и очищать: запись
			// исключается из ожидаемого количества, иначе сеанс нельзя завершить.
			СтрокаФайла.Поддерживается = Ложь;
			ЗаписатьЛог("Пропуск " + ИмяФайла + ": пустое содержимое в информационной базе.");
			Возврат Результат;
		КонецЕсли;
		
		СтрокаФайла.Хеш = ХешДанных(Данные);
		СтрокаФайла.Размер = Данные.Размер();
		Результат.Адрес = ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор());
		Результат.Пропустить = Ложь;
	Исключение
		ЗаписатьОшибку("Ошибка чтения " + ИмяФайла + ": " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура Архив_ПодтвердитьНаСервере(Индекс)
	
	СтрокаФайла = ОчередьФайлов[Индекс];
	СтрокаФайла.Заархивирован = Истина;
	ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
		СформироватьИмяФайла(СтрокаФайла.Наименование, СтрокаФайла.Расширение), СтрокаФайла.Размер, "Заархивировано", "");
	
КонецПроцедуры

&НаСервере
Функция Архив_ЗавершитьНаСервере(ИмяСеанса)
	
	Ожидается = КоличествоОжидаемых();
	Количество = КоличествоЗаархивированных();
	
	Если Ожидается = 0 Тогда
		ВызватьИсключение "Нет файлов для архивирования: в очереди нет записей с хранением в информационной базе.";
	КонецЕсли;
	
	Если Количество <> Ожидается Тогда
		ВызватьИсключение "Архив неполон: заархивировано " + Формат(Количество, "ЧН=0; ЧГ=0")
			+ " из " + Формат(Ожидается, "ЧН=0; ЧГ=0")
			+ ?(ОчередьФайлов.Количество() > Ожидается,
				", исключено при повторной проверке: "
					+ Формат(ОчередьФайлов.Количество() - Ожидается, "ЧН=0; ЧГ=0"),
				"")
			+ ". Очистка запрещена.";
	КонецЕсли;
	ЗаписатьЛог("Заархивировано записей: " + Формат(Количество, "ЧН=0; ЧГ=0") + ".");
	Возврат СформироватьТекстМанифеста(Истина, Ложь);
	
КонецФункции

&НаСервере
Функция КоличествоОжидаемых()
	
	Количество = 0;
	Для Каждого СтрокаФайла Из ОчередьФайлов Цикл
		Если СтрокаФайла.Поддерживается Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

&НаСервере
Функция КоличествоЗаархивированных()
	
	Количество = 0;
	Для Каждого СтрокаФайла Из ОчередьФайлов Цикл
		Если СтрокаФайла.Заархивирован Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

&НаСервере
Процедура Архив_ДобавитьВерсии(КешДат, Счётчики)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Версии.Ссылка КАК Ссылка,
		|	Версии.Владелец КАК Файл,
		|	Версии.Владелец.ВладелецФайла КАК ВладелецФайла,
		|	Версии.ДатаСоздания КАК ДатаСоздания,
		|	Версии.Наименование КАК Наименование,
		|	Версии.НомерВерсии КАК НомерВерсии,
		|	Версии.Размер КАК Размер,
		|	Версии.Расширение КАК Расширение,
		|	Версии.ТипХраненияФайла КАК ТипХранения
		|ИЗ
		|	Справочник.ВерсииФайлов КАК Версии
		|ГДЕ
		|	НЕ Версии.ПометкаУдаления
		|	И НЕ Версии.Владелец.ПометкаУдаления
		|	И Версии.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе)";
	Если ТолькоТекущиеВерсии Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И Версии.Ссылка В (
			|		ВЫБРАТЬ
			|			Файлы.ТекущаяВерсия
			|		ИЗ
			|			Справочник.Файлы КАК Файлы
			|		ГДЕ
			|			НЕ Файлы.ПометкаУдаления
			|			И Файлы.ТекущаяВерсия ЕСТЬ НЕ NULL)";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗаписьВПериоде(Выборка.ВладелецФайла, Выборка.ДатаСоздания, КешДат) Тогда
			Счётчики.Исключено = Счётчики.Исключено + 1;
			Если Не ЗначениеЗаполнено(ЭффективнаяДата(Выборка.ВладелецФайла, Выборка.ДатаСоздания, КешДат)) Тогда
				Счётчики.БезДаты = Счётчики.БезДаты + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ДобавитьВОчередь("version", "ВерсииФайлов", Выборка.Ссылка, Выборка.Файл, Выборка.ВладелецФайла,
			Выборка.Наименование, Выборка.Расширение, Строка(Выборка.НомерВерсии), Выборка.Размер, Выборка.ТипХранения);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура Архив_ДобавитьФайлыБезВерсий(КешДат, Счётчики)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Файлы.Ссылка КАК Ссылка,
		|	Файлы.ВладелецФайла КАК ВладелецФайла,
		|	Файлы.ДатаСоздания КАК ДатаСоздания,
		|	Файлы.Наименование КАК Наименование,
		|	Файлы.Размер КАК Размер,
		|	Файлы.Расширение КАК Расширение,
		|	Файлы.ТипХраненияФайла КАК ТипХранения
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	НЕ Файлы.ПометкаУдаления
		|	И (Файлы.ТекущаяВерсия ЕСТЬ NULL ИЛИ Файлы.ТекущаяВерсия = ЗНАЧЕНИЕ(Справочник.ВерсииФайлов.ПустаяСсылка))
		|	И Файлы.Размер > 0
		|	И Файлы.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗаписьВПериоде(Выборка.ВладелецФайла, Выборка.ДатаСоздания, КешДат) Тогда
			Счётчики.Исключено = Счётчики.Исключено + 1;
			Если Не ЗначениеЗаполнено(ЭффективнаяДата(Выборка.ВладелецФайла, Выборка.ДатаСоздания, КешДат)) Тогда
				Счётчики.БезДаты = Счётчики.БезДаты + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ДобавитьВОчередь("file", "Файлы", Выборка.Ссылка, Неопределено, Выборка.ВладелецФайла,
			Выборка.Наименование, Выборка.Расширение, "", Выборка.Размер, Выборка.ТипХранения);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура Архив_ДобавитьПрисоединенные(КешДат, Счётчики)
	
	Для Каждого ИмяСправочника Из ИменаСправочниковПрисоединенныхФайлов() Цикл
		Мета = Метаданные.Справочники.Найти(ИмяСправочника);
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаПрисоединенныхФайлов(Мета);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗаписьВПериоде(Выборка.ВладелецФайла, Выборка.ДатаСоздания, КешДат) Тогда
				Счётчики.Исключено = Счётчики.Исключено + 1;
				Если Не ЗначениеЗаполнено(ЭффективнаяДата(Выборка.ВладелецФайла, Выборка.ДатаСоздания, КешДат)) Тогда
					Счётчики.БезДаты = Счётчики.БезДаты + 1;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			ДобавитьВОчередь("file", ИмяСправочника, Выборка.Ссылка, Неопределено, Выборка.ВладелецФайла,
				Выборка.Наименование, Выборка.Расширение, "", Выборка.Размер, Выборка.ТипХранения);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВОчередь(Вид, ИмяСправочника, Ссылка, ФайлСсылка, Владелец,
	Наименование, Расширение, НомерВерсии, Размер, ТипХранения)
	
	СтрокаФайла = ОчередьФайлов.Добавить();
	СтрокаФайла.Вид = Вид;
	СтрокаФайла.Каталог = ИмяСправочника;
	СтрокаФайла.СсылкаУУИД = Строка(Ссылка.УникальныйИдентификатор());
	СтрокаФайла.ФайлУУИД = ?(ФайлСсылка = Неопределено, "", Строка(ФайлСсылка.УникальныйИдентификатор()));
	СтрокаФайла.ВладелецТип = ПредставлениеТипа(Владелец);
	СтрокаФайла.ВладелецУУИД = ?(Владелец = Неопределено, "", Строка(Владелец.УникальныйИдентификатор()));
	СтрокаФайла.Наименование = Наименование;
	СтрокаФайла.Расширение = Расширение;
	СтрокаФайла.НомерВерсии = НомерВерсии;
	СтрокаФайла.Размер = Размер;
	СтрокаФайла.ТипХранения = Строка(ТипХранения);
	СтрокаФайла.ОтнПуть = "files/" + СтрокаФайла.СсылкаУУИД + ".bin";
	СтрокаФайла.Хеш = "";
	// В очередь попадают только записи с хранением в информационной базе:
	// фильтр задан в запросах, а тип перепроверяется перед чтением содержимого.
	СтрокаФайла.Поддерживается = Истина;
	СтрокаФайла.Заархивирован = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныйМанифест

&НаСервере
Функция Манифест_ЗагрузитьПоАдресуНаСервере(Адрес, ТребоватьПроверенный)
	
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ЗаписатьЛог("Не удалось получить содержимое манифеста.");
		Возврат Ложь;
	КонецЕсли;
	ТекстJSON = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Возврат Манифест_ЗагрузитьНаСервере(ТекстJSON, ТребоватьПроверенный);
	
КонецФункции

&НаСервере
Функция Манифест_ЗагрузитьНаСервере(ТекстJSON, ТребоватьПроверенный)
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		Манифест = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ЗаписатьОшибку("Манифест повреждён: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Если Манифест.Получить("formatVersion") <> 2 Тогда
		ЗаписатьЛог("Неподдерживаемая версия формата манифеста. Требуется манифест, созданный этой версией обработки.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Манифест.Получить("configName") <> Метаданные.Имя Тогда
		ЗаписатьЛог("Манифест создан в другой конфигурации: " + Строка(Манифест.Получить("configName")));
		Возврат Ложь;
	КонецЕсли;
	
	ОжидаемаяИБ = Манифест.Получить("infobaseId");
	ОжидаемаяОбласть = Манифест.Получить("dataArea");
	Если ТипЗнч(ОжидаемаяИБ) <> Тип("Строка")
		Или ПустаяСтрока(ОжидаемаяИБ)
		Или ТипЗнч(ОжидаемаяОбласть) <> Тип("Число")
		Или ОжидаемаяОбласть < 0 Тогда
		ЗаписатьЛог("Манифест не содержит идентификатор информационной базы и области данных. Очистка и восстановление запрещены.");
		Возврат Ложь;
	КонецЕсли;
	
	Если ОжидаемаяИБ <> ИдентификаторБазыДляАрхива()
		Или ОжидаемаяОбласть <> ОбластьДанныхДляАрхива() Тогда
		ЗаписатьЛог("Манифест создан в другой информационной базе или области данных. Очистка и восстановление запрещены.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Манифест.Получить("completed") <> Истина Тогда
		ЗаписатьЛог("Сеанс архива не завершён.");
		Возврат Ложь;
	КонецЕсли;
	
	Если ТребоватьПроверенный И Манифест.Получить("verified") <> Истина Тогда
		ЗаписатьЛог("Сеанс архива не проверен. Сначала выполните «Проверить архив».");
		Возврат Ложь;
	КонецЕсли;
	
	Записи = Манифест.Получить("records");
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		ЗаписатьЛог("Манифест не содержит список записей.");
		Возврат Ложь;
	КонецЕсли;
	
	ОчередьФайлов.Очистить();
	Для Каждого Запись Из Записи Цикл
		СтрокаФайла = ОчередьФайлов.Добавить();
		СтрокаФайла.Вид = Запись.Получить("kind");
		СтрокаФайла.Каталог = Запись.Получить("catalog");
		СтрокаФайла.СсылкаУУИД = Запись.Получить("refUuid");
		СтрокаФайла.ФайлУУИД = Запись.Получить("fileUuid");
		СтрокаФайла.ВладелецТип = Запись.Получить("ownerType");
		СтрокаФайла.ВладелецУУИД = Запись.Получить("ownerUuid");
		СтрокаФайла.Наименование = Запись.Получить("name");
		СтрокаФайла.Расширение = Запись.Получить("extension");
		СтрокаФайла.НомерВерсии = Запись.Получить("number");
		СтрокаФайла.Размер = Запись.Получить("size");
		СтрокаФайла.ТипХранения = Запись.Получить("storageType");
		СтрокаФайла.ОтнПуть = Запись.Получить("relPath");
		СтрокаФайла.Хеш = Запись.Получить("hash");
		СтрокаФайла.Поддерживается = Истина;
		СтрокаФайла.Заархивирован = Истина;
	КонецЦикла;
	
	Манифест.Удалить("records");
	МанифестШапка = СформироватьJSONСтроку(Манифест);
	
	ЗаписатьЛог("Загружен манифест сеанса " + Строка(Манифест.Получить("sessionId"))
		+ ", записей: " + Формат(ОчередьФайлов.Количество(), "ЧН=0; ЧГ=0") + ".");
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция Манифест_ОтметитьПровереннымНаСервере()
	
	Возврат СформироватьТекстМанифеста(Истина, Истина);
	
КонецФункции

&НаСервере
Функция СформироватьТекстМанифеста(Завершен, Проверен)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(МанифестШапка);
	Шапка = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	
	Шапка.Вставить("completed", Завершен);
	Шапка.Вставить("verified", Проверен);
	Если Проверен Тогда
		Шапка.Вставить("verifiedAt", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
	КонецЕсли;
	
	Записи = Новый Массив;
	Для Каждого СтрокаФайла Из ОчередьФайлов Цикл
		Если Не СтрокаФайла.Заархивирован Тогда
			Продолжить;
		КонецЕсли;
		Запись = Новый Соответствие;
		Запись.Вставить("kind", СтрокаФайла.Вид);
		Запись.Вставить("catalog", СтрокаФайла.Каталог);
		Запись.Вставить("refUuid", СтрокаФайла.СсылкаУУИД);
		Запись.Вставить("fileUuid", СтрокаФайла.ФайлУУИД);
		Запись.Вставить("ownerType", СтрокаФайла.ВладелецТип);
		Запись.Вставить("ownerUuid", СтрокаФайла.ВладелецУУИД);
		Запись.Вставить("name", СтрокаФайла.Наименование);
		Запись.Вставить("extension", СтрокаФайла.Расширение);
		Запись.Вставить("number", СтрокаФайла.НомерВерсии);
		Запись.Вставить("size", СтрокаФайла.Размер);
		Запись.Вставить("hash", СтрокаФайла.Хеш);
		Запись.Вставить("relPath", СтрокаФайла.ОтнПуть);
		Запись.Вставить("storageType", СтрокаФайла.ТипХранения);
		Записи.Добавить(Запись);
	КонецЦикла;
	Шапка.Вставить("records", Записи);
	
	Возврат СформироватьJSONСтроку(Шапка);
	
КонецФункции

&НаСервере
Функция СформироватьJSONСтроку(Значение)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецОбласти

#Область СервернаяОчисткаИВосстановление

// Проверяет, что манифест относится к этой же информационной базе и области
// данных и что архив завершён и проверен. Любая изменяющая операция должна
// вызывать эту процедуру до первой записи.
&НаСервере
Процедура ПроверитьБезопасностьИзмененияДанных()
	
	Если ПустаяСтрока(МанифестШапка) Тогда
		ВызватьИсключение "Операция запрещена: манифест сеанса архива не загружен.";
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(МанифестШапка);
		Шапка = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ВызватьИсключение "Операция запрещена: не удалось прочитать манифест сеанса.";
	КонецПопытки;
	
	ОжидаемаяИБ = Шапка.Получить("infobaseId");
	ОжидаемаяОбласть = Шапка.Получить("dataArea");
	Если ТипЗнч(ОжидаемаяИБ) <> Тип("Строка")
		Или ПустаяСтрока(ОжидаемаяИБ)
		Или ТипЗнч(ОжидаемаяОбласть) <> Тип("Число")
		Или ОжидаемаяОбласть < 0 Тогда
		ВызватьИсключение "Операция запрещена: манифест не содержит идентификатор базы и области данных.";
	КонецЕсли;
	
	Если ОжидаемаяИБ <> ИдентификаторБазыДляАрхива()
		Или ОжидаемаяОбласть <> ОбластьДанныхДляАрхива() Тогда
		ВызватьИсключение "Операция запрещена: манифест создан в другой информационной базе или области данных.";
	КонецЕсли;
	
	Если Шапка.Получить("completed") <> Истина
		Или Шапка.Получить("verified") <> Истина Тогда
		ВызватьИсключение "Операция запрещена: манифест не завершён или не проверен.";
	КонецЕсли;
	
КонецПроцедуры

// Идентификатор информационной базы по штатному механизму БСП. Значение
// записывается в константу при первом обращении; при ошибке возвращается
// пустая строка, и изменяющие операции для сеанса будут запрещены.
&НаСервере
Функция ИдентификаторБазыДляАрхива()
	
	Попытка
		Возврат СтандартныеПодсистемыСервер.ИдентификаторИнформационнойБазы();
	Исключение
		ЗаписатьОшибку("Не удалось получить идентификатор информационной базы: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Номер области данных текущего сеанса. 0 - разделение не включено,
// -1 - разделение включено, но разделитель не установлен.
&НаСервере
Функция ОбластьДанныхДляАрхива()
	
	Попытка
		Возврат РаботаВМоделиСервиса.ЗначениеРазделителяСеанса();
	Исключение
		ЗаписатьОшибку("Не удалось определить область данных: " + ОписаниеОшибки());
		Возврат -1;
	КонецПопытки;
	
КонецФункции

// Устанавливает управляемые блокировки на изменяемую запись и её карточку.
// Порядок: версия и карточка файла, НаличиеФайлов по объекту-владельцу,
// СведенияОФайлах, запись регистра хранилища. Блокировка записи регистра не
// даёт параллельному сеансу заменить содержимое между повторной проверкой
// хеша и удалением/записью.
//
// Порядок НаличиеФайлов → СведенияОФайлах обязателен: так же блокирует
// подписка БСП «ПриЗаписиПрисоединенногоФайлаСервер». Обратный порядок даёт
// взаимоблокировку (ABBA) при параллельной записи присоединённого файла.
&НаСервере
Процедура ЗаблокироватьЗаписьХранилищаФайлов(СтрокаФайла, Ссылка)
	
	Блокировка = Новый БлокировкаДанных;
	ВладелецФайла = Неопределено;
	
	Если СтрокаФайла.Вид = "version" Тогда
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ВерсииФайлов");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		
		ФайлСсылка = ФайлСсылкаПоСтроке(СтрокаФайла);
		Если ФайлСсылка <> Неопределено Тогда
			ЭлементБлокировки = Блокировка.Добавить("Справочник.Файлы");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлСсылка);
			Попытка
				ВладелецФайла = ФайлСсылка.ВладелецФайла;
			Исключение
				ВладелецФайла = Неопределено;
			КонецПопытки;
		КонецЕсли;
	Иначе
		ЭлементБлокировки = Блокировка.Добавить("Справочник." + СтрокаФайла.Каталог);
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		Попытка
			ВладелецФайла = Ссылка.ВладелецФайла;
		Исключение
			ВладелецФайла = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ВладелецФайла <> Неопределено Тогда
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НаличиеФайлов");
		ЭлементБлокировки.УстановитьЗначение("ОбъектСФайлами", ВладелецФайла);
	КонецЕсли;
	
	// Запись регистра сведений с отметкой архива изменяется вместе с файлом.
	Если СтрокаФайла.Вид = "file" И СтрокаФайла.Каталог <> "Файлы" Тогда
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СведенияОФайлах");
		ЭлементБлокировки.УстановитьЗначение("Файл", Ссылка);
	КонецЕсли;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ХранилищеФайлов");
	ЭлементБлокировки.УстановитьЗначение("Файл", Ссылка);
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Штатная отметка БСП «файл перенесён в архив». Записывается в регистр
// сведений СведенияОФайлах: он независим от карточки файла, поэтому запись
// читается и изменяется целиком.
&НаСервере
Процедура ЗаписатьОтметкуВАрхиве(Ссылка, ДатаПереноса)
	
	Запись = РегистрыСведений.СведенияОФайлах.СоздатьМенеджерЗаписи();
	Запись.Файл = Ссылка;
	Запись.Прочитать();
	Запись.ДатаПереносаВАрхив = ДатаПереноса;
	// Истина в БСП означает «кандидат на очистку», поэтому всегда Ложь.
	Запись.УсловноПеренесенВАрхив = Ложь;
	Запись.Записать();
	
КонецПроцедуры

// Ставит отметку архива. Возвращает Истина, если отметка поставлена.
// Файлы без версий (карточка Справочник.Файлы) штатной отметки не имеют:
// у них нет ни реквизита версии, ни записи в регистре сведений.
&НаСервере
Функция ОтметитьАрхивным(ОбъектДанных, СтрокаФайла)
	
	Если СтрокаФайла.Вид = "version" Тогда
		ОбъектДанных.ДатаПереносаВАрхив = ТекущаяДатаСеанса();
		ОбъектДанных.УсловноПеренесенВАрхив = Ложь;
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаФайла.Каталог = "Файлы" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаписатьОтметкуВАрхиве(ОбъектДанных.Ссылка, ТекущаяДатаСеанса());
	Возврат Истина;
	
КонецФункции

// Снимает отметку архива. Отметка снимается до записи содержимого: иначе
// штатный код БСП попытается распаковать файл как zip-архив.
&НаСервере
Процедура СнятьОтметкуАрхива(ОбъектДанных, СтрокаФайла)
	
	Если СтрокаФайла.Вид = "version" Тогда
		ОбъектДанных.ДатаПереносаВАрхив = Дата(1, 1, 1);
		ОбъектДанных.УсловноПеренесенВАрхив = Ложь;
		Возврат;
	КонецЕсли;
	
	Если СтрокаФайла.Каталог = "Файлы" Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьОтметкуВАрхиве(ОбъектДанных.Ссылка, Дата(1, 1, 1));
	
КонецПроцедуры

&НаСервере
Функция Проверка_ПроверитьФайлНаСервере(Индекс, Адрес)
	
	СтрокаФайла = ОчередьФайлов[Индекс];
	
	Попытка
		Данные = ПолучитьИзВременногоХранилища(Адрес);
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение "не удалось получить содержимое файла";
		КонецЕсли;
		Если Данные.Размер() <> СтрокаФайла.Размер Тогда
			ВызватьИсключение "размер не совпадает";
		КонецЕсли;
		Если ХешДанных(Данные) <> СтрокаФайла.Хеш Тогда
			ВызватьИсключение "хеш не совпадает";
		КонецЕсли;
		ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
			СтрокаФайла.Наименование, СтрокаФайла.Размер, "OK", "");
		Возврат Истина;
	Исключение
		ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
			СтрокаФайла.Наименование, СтрокаФайла.Размер, "Ошибка", ОписаниеОшибки());
		ЗаписатьОшибку("Ошибка проверки " + СтрокаФайла.ОтнПуть + ": " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция Очистка_ОчиститьЗаписьНаСервере(Индекс)
	
	СтрокаФайла = ОчередьФайлов[Индекс];
	
	// Очищаются только записи, которые действительно попали в архив.
	Если Не СтрокаФайла.Заархивирован Тогда
		Возврат Новый Структура("Результат, Сообщение", "Пропущено", "Запись не входит в архив");
	КонецЕсли;
	
	Попытка
		// Отказ проверки становится строкой «Ошибка», а не обрывом цикла.
		ПроверитьБезопасностьИзмененияДанных();
		НачатьТранзакцию();
		Попытка
			Ссылка = СсылкаПоСтроке(СтрокаФайла);
			ЗаблокироватьЗаписьХранилищаФайлов(СтрокаФайла, Ссылка);
			
			ОбъектДанных = Ссылка.ПолучитьОбъект();
			Если ОбъектДанных = Неопределено Тогда
				ВызватьИсключение "объект не найден";
			КонецЕсли;
			
			ПроверитьВладельцаВерсии(ОбъектДанных, СтрокаФайла);
			
			// Тип хранения мог измениться после архивирования. Чужое
			// хранилище не трогаем.
			Если Не ЭтоХранениеВИнформационнойБазе(ОбъектДанных.ТипХраненияФайла) Тогда
				ЗафиксироватьТранзакцию();
				ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
					СтрокаФайла.Наименование, 0, "Пропущено", "Тип хранения изменился");
				Возврат Новый Структура("Результат, Сообщение", "Пропущено", "Тип хранения изменился");
			КонецЕсли;
			
			// Хеш перепроверяется под блокировкой: очищается только то
			// содержимое, которое было заархивировано.
			Текущие = СодержимоеФайлаИзИБ(Ссылка);
			Если Текущие = Неопределено Или Текущие.Размер() = 0 Тогда
				ЗафиксироватьТранзакцию();
				ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
					СтрокаФайла.Наименование, 0, "Пропущено", "Уже очищено");
				Возврат Новый Структура("Результат, Сообщение", "Пропущено", "Уже очищено");
			КонецЕсли;
			
			Если ХешДанных(Текущие) <> СтрокаФайла.Хеш Тогда
				ЗафиксироватьТранзакцию();
				ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
					СтрокаФайла.Наименование, Текущие.Размер(), "Пропущено", "Содержимое изменилось после архивирования");
				Возврат Новый Структура("Результат, Сообщение", "Пропущено", "Содержимое изменилось после архивирования");
			КонецЕсли;
			
			// Отметка ставится до удаления содержимого и в той же транзакции.
			ОтметкаПоставлена = ОтметитьАрхивным(ОбъектДанных, СтрокаФайла);
			
			РегистрыСведений.ХранилищеФайлов.УдалитьДвоичныеДанные(Ссылка);
			ЗаписатьПустоеСодержимое(ОбъектДанных, СтрокаФайла);
			
			Проверка = СодержимоеФайлаИзИБ(Ссылка);
			Если Проверка <> Неопределено И Проверка.Размер() > 0 Тогда
				ВызватьИсключение "после записи содержимое не пусто";
			КонецЕсли;
			ОбновитьРазмерФайла(ОбъектДанных, СтрокаФайла, 0);
			
			ЗафиксироватьТранзакцию();
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;
		
		Сообщение = ?(ОтметкаПоставлена, "", "Отметка архива недоступна: у файла нет версий");
		Если Не ОтметкаПоставлена Тогда
			ЗаписатьЛог("Файл " + СтрокаФайла.ОтнПуть
				+ " очищен без отметки архива: у файла нет версий.");
		КонецЕсли;
		ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
			СтрокаФайла.Наименование, 0, "Очищено", Сообщение);
		Возврат Новый Структура("Результат, Сообщение", "Очищено", Сообщение);
	Исключение
		ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
			СтрокаФайла.Наименование, 0, "Ошибка", ОписаниеОшибки());
		ЗаписатьОшибку("Ошибка очистки " + СтрокаФайла.ОтнПуть + ": " + ОписаниеОшибки());
		Возврат Новый Структура("Результат, Сообщение", "Ошибка", ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура Восстановление_ВосстановитьНаСервере(Индекс, Адрес)
	
	СтрокаФайла = ОчередьФайлов[Индекс];
	
	Попытка
		// Отказ проверки становится строкой «Ошибка», а не обрывом цикла.
		ПроверитьБезопасностьИзмененияДанных();
		ДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
		Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение "не удалось получить содержимое файла архива";
		КонецЕсли;
		Если ДанныеФайла.Размер() <> СтрокаФайла.Размер Тогда
			ВызватьИсключение "размер файла архива не совпадает";
		КонецЕсли;
		Если ХешДанных(ДанныеФайла) <> СтрокаФайла.Хеш Тогда
			ВызватьИсключение "файл архива повреждён";
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			Ссылка = СсылкаПоСтроке(СтрокаФайла);
			ЗаблокироватьЗаписьХранилищаФайлов(СтрокаФайла, Ссылка);
			
			ОбъектДанных = Ссылка.ПолучитьОбъект();
			Если ОбъектДанных = Неопределено Тогда
				ВызватьИсключение "объект не найден";
			КонецЕсли;
			
			ПроверитьВладельцаВерсии(ОбъектДанных, СтрокаФайла);
			
			Если Не ЭтоХранениеВИнформационнойБазе(ОбъектДанных.ТипХраненияФайла) Тогда
				ВызватьИсключение "тип хранения изменился: " + Строка(ОбъектДанных.ТипХраненияФайла);
			КонецЕсли;
			
			// Содержимое, изменённое после архивирования, не перезаписывается.
			Текущие = СодержимоеФайлаИзИБ(Ссылка);
			Если Текущие <> Неопределено И Текущие.Размер() > 0 Тогда
				Если ХешДанных(Текущие) = СтрокаФайла.Хеш Тогда
					// Содержимое уже совпадает с архивным, но отметка могла
					// остаться от очистки: её нужно снять, иначе файл не
					// откроется.
					СнятьОтметкуАрхива(ОбъектДанных, СтрокаФайла);
					ЗафиксироватьТранзакцию();
					ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
						СтрокаФайла.Наименование, Текущие.Размер(), "Пропущено", "Уже восстановлено");
				Иначе
					ЗафиксироватьТранзакцию();
					ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
						СтрокаФайла.Наименование, Текущие.Размер(), "Конфликт", "Содержимое отличается от архивного");
				КонецЕсли;
				Возврат;
			КонецЕсли;
			
			// Отметка снимается до записи содержимого, в той же транзакции.
			СнятьОтметкуАрхива(ОбъектДанных, СтрокаФайла);
			
			РегистрыСведений.ХранилищеФайлов.ЗаписатьДвоичныеДанные(Ссылка, ДанныеФайла);
			ЗаписатьСодержимое(ОбъектДанных, ДанныеФайла, СтрокаФайла);
			
			Проверка = СодержимоеФайлаИзИБ(Ссылка);
			Если Проверка = Неопределено Или ХешДанных(Проверка) <> СтрокаФайла.Хеш Тогда
				ВызватьИсключение "после записи содержимое не совпало с архивом";
			КонецЕсли;
			ОбновитьРазмерФайла(ОбъектДанных, СтрокаФайла, ДанныеФайла.Размер());
			
			ЗафиксироватьТранзакцию();
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;
		
		ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
			СтрокаФайла.Наименование, ДанныеФайла.Размер(), "Восстановлено", "");
	Исключение
		ДобавитьСтрокуРезультата(СтрокаФайла.Каталог, СтрокаФайла.НомерВерсии,
			СтрокаФайла.Наименование, 0, "Ошибка", ОписаниеОшибки());
		ЗаписатьОшибку("Ошибка восстановления " + СтрокаФайла.ОтнПуть + ": " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВладельцаВерсии(ОбъектДанных, СтрокаФайла)
	
	Если СтрокаФайла.Вид <> "version" Тогда
		Возврат;
	КонецЕсли;
	
	Владелец = ОбъектДанных.Владелец;
	Если Владелец = Неопределено
		Или Строка(Владелец.УникальныйИдентификатор()) <> СтрокаФайла.ФайлУУИД Тогда
		ВызватьИсключение "владелец версии не совпадает";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СервернаяРаботаСОбъектами

&НаСервере
Функция СсылкаПоСтроке(СтрокаФайла)
	
	ИмяСправочника = СтрокаФайла.Каталог;
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		ВызватьИсключение "Справочник «" + ИмяСправочника + "» отсутствует в конфигурации";
	КонецЕсли;
	УУИД = Новый УникальныйИдентификатор(СтрокаФайла.СсылкаУУИД);
	Менеджер = Справочники[ИмяСправочника];
	Возврат Менеджер.ПолучитьСсылку(УУИД);
	
КонецФункции

&НаСервере
Функция СодержимоеФайлаИзИБ(Ссылка)
	
	// Штатный механизм БСП: читает двоичные данные из регистра
	// ХранилищеФайлов (включая дедуплицированное хранилище).
	Хранилище = РаботаСФайлами.ХранилищеФайлаИзИнформационнойБазы(Ссылка);
	Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		Значение = Хранилище.Получить();
		Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	
	// Совместимость с прежним способом хранения в реквизите ФайлХранилище.
	ОбъектДанных = Ссылка.ПолучитьОбъект();
	Если ОбъектДанных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хранилище = ОбъектДанных.ФайлХранилище;
	Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		Значение = Хранилище.Получить();
		Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ФайлСсылкаПоСтроке(СтрокаФайла)
	
	Если ПустаяСтрока(СтрокаФайла.ФайлУУИД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Файлы.ПолучитьСсылку(
		Новый УникальныйИдентификатор(СтрокаФайла.ФайлУУИД));
	
КонецФункции

&НаСервере
Процедура ЗаписатьПустоеСодержимое(ОбъектДанных, СтрокаФайла)
	ПроверитьБезопасностьИзмененияДанных();
	
	ОбъектДанных.ФайлХранилище = Новый ХранилищеЗначения(Неопределено);
	ОбъектДанных.Размер = 0;
	ЗаписатьОбъектСодержимогоФайла(ОбъектДанных, СтрокаФайла);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСодержимое(ОбъектДанных, Данные, СтрокаФайла)
	ПроверитьБезопасностьИзмененияДанных();
	
	// Содержимое хранится в регистре ХранилищеФайлов, а не в реквизите.
	ОбъектДанных.ФайлХранилище = Новый ХранилищеЗначения(Неопределено);
	ОбъектДанных.Размер = Данные.Размер();
	ЗаписатьОбъектСодержимогоФайла(ОбъектДанных, СтрокаФайла);
	
КонецПроцедуры

// Записывает карточку файла или версию. Для исторической версии запись
// выполняется со служебным признаком "КонвертацияФайлов": иначе подписка БСП
// ВерсииФайловПриЗаписи перепишет размер и реквизиты карточки текущего файла
// данными исторической версии.
&НаСервере
Процедура ЗаписатьОбъектСодержимогоФайла(ОбъектДанных, СтрокаФайла)
	
	Если СтрокаФайла.Вид <> "version" Тогда
		ОбъектДанных.Записать();
		Возврат;
	КонецЕсли;
	
	ФайлСсылка = ФайлСсылкаПоСтроке(СтрокаФайла);
	ФайлОбъект = ?(ФайлСсылка = Неопределено, Неопределено, ФайлСсылка.ПолучитьОбъект());
	Если ФайлОбъект <> Неопределено И ФайлОбъект.ТекущаяВерсия = ОбъектДанных.Ссылка Тогда
		ОбъектДанных.Записать();
	Иначе
		ОбъектДанных.ДополнительныеСвойства.Вставить("КонвертацияФайлов", Истина);
		ОбъектДанных.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРазмерФайла(ОбъектДанных, СтрокаФайла, НовыйРазмер)
	ПроверитьБезопасностьИзмененияДанных();
	
	Если СтрокаФайла.Вид <> "version" Тогда
		Возврат;
	КонецЕсли;
	
	ФайлСсылка = ФайлСсылкаПоСтроке(СтрокаФайла);
	Если ФайлСсылка = Неопределено Тогда
		ВызватьИсключение "не удалось определить карточку файла для версии";
	КонецЕсли;
	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	Если ФайлОбъект = Неопределено Тогда
		ВызватьИсключение "карточка файла не найдена";
	КонецЕсли;
	
	Если ФайлОбъект.ТекущаяВерсия = ОбъектДанных.Ссылка Тогда
		ФайлОбъект.Размер = НовыйРазмер;
		ФайлОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеСлужебныеПроцедуры

// Имена справочников присоединённых файлов.
//
// Возвращаемое значение:
//   Массив из Строка — справочники, содержащие двоичное содержимое файлов.
//
// Состав определяется по метаданным, а не по жёсткому списку: в целевых
// конфигурациях таких справочников несколько сотен. Данные каждого справочника
// читаются отдельным запросом, потому что это разные таблицы; объединить их
// в один запрос без потери сопровождаемости нельзя.
//
&НаСервере
Функция ИменаСправочниковПрисоединенныхФайлов()
	
	Имена = Новый Массив;
	Для Каждого Справочник Из Метаданные.Справочники Цикл
		Если Найти(ВРег(Справочник.Имя), "ПРИСОЕДИНЕННЫЕФАЙЛЫ") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Справочник.Реквизиты.Найти("ФайлХранилище") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Справочник.Реквизиты.Найти("ТипХраненияФайла") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Справочник.Реквизиты.Найти("ВладелецФайла") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Справочник.Реквизиты.Найти("Размер") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имена.Добавить(Справочник.Имя);
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаПрисоединенныхФайлов(Мета, ТолькоВИнформационнойБазе = Истина)
	
	Если Мета.Реквизиты.Найти("ИсходноеИмяФайла") <> Неопределено Тогда
		ПолеИмени = "Спр.ИсходноеИмяФайла";
	Иначе
		ПолеИмени = "Спр.Наименование";
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("Расширение") <> Неопределено Тогда
		ПолеРасширения = "Спр.Расширение";
	Иначе
		ПолеРасширения = """""";
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("ДатаСоздания") <> Неопределено Тогда
		ПолеДатыСоздания = "Спр.ДатаСоздания";
	Иначе
		// Пустая дата: запись без даты, в периоде не участвует.
		ПолеДатыСоздания = "ДАТАВРЕМЯ(1, 1, 1)";
	КонецЕсли;
	
	Текст = "ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка,
		|	Спр.ВладелецФайла КАК ВладелецФайла,
		|	" + ПолеДатыСоздания + " КАК ДатаСоздания,
		|	" + ПолеИмени + " КАК Наименование,
		|	Спр.Размер КАК Размер,
		|	" + ПолеРасширения + " КАК Расширение,
		|	Спр.ТипХраненияФайла КАК ТипХранения
		|ИЗ
		|	Справочник." + Мета.Имя + " КАК Спр
		|ГДЕ
		|	НЕ Спр.ПометкаУдаления
		|	И Спр.Размер > 0";
	
	// Анализу нужны все типы хранения, очереди архива — только хранение в ИБ.
	Если ТолькоВИнформационнойБазе Тогда
		Текст = Текст + "
			|	И Спр.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВИнформационнойБазе)";
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ЭтоХранениеВИнформационнойБазе(ТипХранения)
	
	Возврат ТипЗнч(ТипХранения) = Тип("ПеречислениеСсылка.ТипыХраненияФайлов")
		И ТипХранения = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	
КонецФункции

&НаСервере
Функция СформироватьИмяФайла(Наименование, Расширение)
	
	Имя = СокрЛП(Строка(Наименование));
	Если ПустаяСтрока(Имя) Тогда
		Имя = "без имени";
	КонецЕсли;
	Если Не ПустаяСтрока(Строка(Расширение)) Тогда
		Если Прав(НРег(Имя), СтрДлина("." + Строка(Расширение))) <> НРег("." + Строка(Расширение)) Тогда
			Имя = Имя + "." + Строка(Расширение);
		КонецЕсли;
	КонецЕсли;
	Возврат Имя;
	
КонецФункции

&НаСервере
Функция ПредставлениеТипа(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Мета = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если Мета = Неопределено Тогда
		Возврат Строка(ТипЗнч(Значение));
	КонецЕсли;
	Возврат Мета.ПолноеИмя();
	
КонецФункции

&НаСервере
Процедура ДобавитьГруппуСтатистики(Группа, ТипХранения, Количество, Размер)
	
	СтрокаТаблицы = ТаблицаРезультата.Добавить();
	СтрокаТаблицы.Объект = Группа;
	СтрокаТаблицы.Версия = "записей: " + Формат(Количество, "ЧН=0; ЧГ=0");
	СтрокаТаблицы.Имя = "";
	СтрокаТаблицы.Размер = Размер;
	СтрокаТаблицы.Состояние = ?(ЭтоХранениеВИнформационнойБазе(ТипХранения), "Поддерживается", "Не поддерживается");
	СтрокаТаблицы.Сообщение = Строка(ТипХранения);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРезультата(ОбъектСтроки, Версия, Имя, Размер, Состояние, Сообщение)
	
	Если ТаблицаРезультата.Количество() >= 500 Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = ТаблицаРезультата.Добавить();
	СтрокаТаблицы.Объект = ОбъектСтроки;
	СтрокаТаблицы.Версия = Версия;
	СтрокаТаблицы.Имя = Имя;
	СтрокаТаблицы.Размер = Размер;
	СтрокаТаблицы.Состояние = Состояние;
	СтрокаТаблицы.Сообщение = Сообщение;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛог(Знач Текст)
	
	Если Не ПустаяСтрока(ТекстЛога) Тогда
		ТекстЛога = ТекстЛога + Символы.ПС;
	КонецЕсли;
	ТекстЛога = ТекстЛога + Текст;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОшибку(Знач Текст)
	
	ЗаписатьЛог(Текст);
	ЗаписьЖурналаРегистрации(
		"УправлениеАрхивомПрисоединенныхФайловОчисткаИВосстановление.СписокФайлов",
		УровеньЖурналаРегистрации.Ошибка,
		Неопределено,
		Неопределено,
		Текст);
	
КонецПроцедуры

&НаСервере
Функция ХешДанных(Данные)
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат Base64Строка(Хеширование.ХешСумма);
	
КонецФункции

&НаСервере
Функция СформироватьИмяСеанса()
	
	Суффикс = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", ""), 8);
	Возврат "Сеанс_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + "_" + Суффикс;
	
КонецФункции

#КонецОбласти
