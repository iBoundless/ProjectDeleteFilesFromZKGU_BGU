&НаСервере
Функция Автотест_ПодготовитьДанныеНаСервере()
	
	// Удалить данные предыдущих запусков автотеста.
	Для Каждого ИмяТаблицы Из СтрРазделить("ВерсииФайлов,Файлы,ФизическиеЛицаПрисоединенныеФайлы,ФизическиеЛица,ПапкиФайлов", ",") Цикл
		ЗапросОчистки = Новый Запрос;
		ЗапросОчистки.Текст = "ВЫБРАТЬ Спр.Ссылка КАК Ссылка ИЗ Справочник." + ИмяТаблицы + " КАК Спр";
		ВыборкаОчистки = ЗапросОчистки.Выполнить().Выбрать();
		Пока ВыборкаОчистки.Следующий() Цикл
			ОбъектУдаления = ВыборкаОчистки.Ссылка.ПолучитьОбъект();
			Если ОбъектУдаления <> Неопределено И Не ОбъектУдаления.Предопределенный Тогда
				ОбъектУдаления.Удалить();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Папка = Справочники.ПапкиФайлов.СоздатьЭлемент();
	Папка.Наименование = "Автотест архива";
	Папка.Записать();
	
	ФайлСВерсиями = Справочники.Файлы.СоздатьЭлемент();
	ФайлСВерсиями.ВладелецФайла = Папка.Ссылка;
	ФайлСВерсиями.Наименование = "Тестовый файл с версиями";
	ФайлСВерсиями.Расширение = "txt";
	ФайлСВерсиями.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	ФайлСВерсиями.ХранитьВерсии = Истина;
	ФайлСВерсиями.Размер = 0;
	ФайлСВерсиями.Записать();
	
	Данные1 = ПолучитьДвоичныеДанныеИзСтроки("Версия один: Привет, мир!");
	Версия1 = Справочники.ВерсииФайлов.СоздатьЭлемент();
	Версия1.Владелец = ФайлСВерсиями.Ссылка;
	Версия1.Наименование = "Тестовый файл с версиями";
	Версия1.НомерВерсии = 1;
	Версия1.Расширение = "txt";
	Версия1.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	Версия1.ФайлХранилище = Новый ХранилищеЗначения(Данные1);
	Версия1.Размер = Данные1.Размер();
	Версия1.Записать();
	
	Данные2 = ПолучитьДвоичныеДанныеИзСтроки("Версия два: другое содержимое");
	Версия2 = Справочники.ВерсииФайлов.СоздатьЭлемент();
	Версия2.Владелец = ФайлСВерсиями.Ссылка;
	Версия2.Наименование = "Тестовый файл с версиями";
	Версия2.НомерВерсии = 2;
	Версия2.Расширение = "txt";
	Версия2.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	Версия2.ФайлХранилище = Новый ХранилищеЗначения(Данные2);
	Версия2.Размер = Данные2.Размер();
	Версия2.Записать();
	
	ФайлСВерсиями = ФайлСВерсиями.Ссылка.ПолучитьОбъект();
	ФайлСВерсиями.ТекущаяВерсия = Версия2.Ссылка;
	ФайлСВерсиями.Размер = Данные2.Размер();
	ФайлСВерсиями.Записать();
	
	Данные3 = ПолучитьДвоичныеДанныеИзСтроки("Файл без версий");
	ФайлБезВерсий = Справочники.Файлы.СоздатьЭлемент();
	ФайлБезВерсий.ВладелецФайла = Папка.Ссылка;
	ФайлБезВерсий.Наименование = "Файл без версий";
	ФайлБезВерсий.Расширение = "txt";
	ФайлБезВерсий.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	ФайлБезВерсий.ХранитьВерсии = Ложь;
	ФайлБезВерсий.ФайлХранилище = Новый ХранилищеЗначения(Данные3);
	ФайлБезВерсий.Размер = Данные3.Размер();
	ФайлБезВерсий.Записать();
	
	Физлицо = Справочники.ФизическиеЛица.СоздатьЭлемент();
	Физлицо.Наименование = "Автотест Физлицо";
	Физлицо.Записать();
	
	Данные4 = ПолучитьДвоичныеДанныеИзСтроки("Вложение физического лица");
	Вложение = Справочники.ФизическиеЛицаПрисоединенныеФайлы.СоздатьЭлемент();
	Вложение.ВладелецФайла = Физлицо.Ссылка;
	Вложение.Наименование = "Вложение автотест";
	Вложение.Расширение = "txt";
	Вложение.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	Вложение.ФайлХранилище = Новый ХранилищеЗначения(Данные4);
	Вложение.Размер = Данные4.Размер();
	Вложение.Записать();
	
	Результат = Новый Массив;
	Результат.Добавить(Автотест_Описание("ВерсииФайлов", Версия1.Ссылка, Данные1));
	Результат.Добавить(Автотест_Описание("ВерсииФайлов", Версия2.Ссылка, Данные2));
	Результат.Добавить(Автотест_Описание("Файлы", ФайлБезВерсий.Ссылка, Данные3));
	Результат.Добавить(Автотест_Описание("ФизическиеЛицаПрисоединенныеФайлы", Вложение.Ссылка, Данные4));
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция Автотест_Описание(Каталог, Ссылка, Данные)
	
	Описание = Новый Структура;
	Описание.Вставить("Каталог", Каталог);
	Описание.Вставить("УУИД", Строка(Ссылка.УникальныйИдентификатор()));
	Описание.Вставить("Хеш", ХешДанных(Данные));
	Возврат Описание;
	
КонецФункции

&НаСервере
Функция Автотест_ХешСодержимогоНаСервере(Каталог, УУИДСтрокой)
	
	Менеджер = Справочники[Каталог];
	Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УУИДСтрокой));
	ОбъектДанных = Ссылка.ПолучитьОбъект();
	Если ОбъектДанных = Неопределено Тогда
		Возврат "ОБЪЕКТ НЕ НАЙДЕН";
	КонецЕсли;
	Данные = СодержимоеОбъекта(ОбъектДанных);
	Если Данные = Неопределено Или Данные.Размер() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ХешДанных(Данные);
	
КонецФункции

&НаСервере
Процедура Автотест_УстановитьСодержимоеНаСервере(Каталог, УУИДСтрокой, ТекстСодержимого)
	
	Менеджер = Справочники[Каталог];
	Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УУИДСтрокой));
	ОбъектДанных = Ссылка.ПолучитьОбъект();
	ЗаписатьСодержимое(ОбъектДанных, ПолучитьДвоичныеДанныеИзСтроки(ТекстСодержимого));
	
КонецПроцедуры

&НаСервере
Процедура Автотест_ДобавитьФайлВТомеНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Папки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПапкиФайлов КАК Папки
		|ГДЕ
		|	Папки.Наименование = ""Автотест архива""";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Папка = Выборка.Ссылка;
	Иначе
		ПапкаОбъект = Справочники.ПапкиФайлов.СоздатьЭлемент();
		ПапкаОбъект.Наименование = "Автотест архива";
		ПапкаОбъект.Записать();
		Папка = ПапкаОбъект.Ссылка;
	КонецЕсли;
	
	ФайлВТоме = Справочники.Файлы.СоздатьЭлемент();
	ФайлВТоме.ВладелецФайла = Папка;
	ФайлВТоме.Наименование = "Файл в томе";
	ФайлВТоме.Расширение = "txt";
	ФайлВТоме.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВТомахНаДиске;
	ФайлВТоме.ХранитьВерсии = Ложь;
	ФайлВТоме.Размер = 100;
	ФайлВТоме.Записать();
	
КонецПроцедуры

#КонецОбласти
