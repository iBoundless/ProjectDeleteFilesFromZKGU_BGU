#Область Автотест

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВыполнитьАвтотест();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтотест()
	
	Текст = "";
	
	Попытка
		
		ДанныеТеста = Автотест_ПодготовитьДанныеНаСервере();
		Текст = Текст + "Создано единиц: " + ДанныеТеста.Количество() + Символы.ПС;
		
		Анализ(Неопределено);
		Текст = Текст + "=== АНАЛИЗ ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		КаталогАрхива = "/tmp/opencode/epf/build/smoke_archive";
		Архивировать(Неопределено);
		Текст = Текст + "=== АРХИВ ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		ПервыйСеанс = Сеанс;
		
		ПроверитьАрхив(Неопределено);
		Текст = Текст + "=== ПРОВЕРКА ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		ПодготовитьРезультат();
		ВыполнитьОчисткуКлиент();
		Текст = Текст + "=== ОЧИСТКА ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		Пустых = 0;
		Для Каждого Элемент Из ДанныеТеста Цикл
			Если Автотест_ХешСодержимогоНаСервере(Элемент.Каталог, Элемент.УУИД) = "" Тогда
				Пустых = Пустых + 1;
			КонецЕсли;
		КонецЦикла;
		Текст = Текст + "пустых_после_очистки=" + Пустых + " из " + ДанныеТеста.Количество() + Символы.ПС;
		
		ПодготовитьРезультат();
		ВыполнитьОчисткуКлиент();
		Текст = Текст + "=== ПОВТОРНАЯ ОЧИСТКА ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		ПодготовитьРезультат();
		ВыполнитьВосстановлениеКлиент();
		Текст = Текст + "=== ВОССТАНОВЛЕНИЕ ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		Совпало = 0;
		Для Каждого Элемент Из ДанныеТеста Цикл
			Если Автотест_ХешСодержимогоНаСервере(Элемент.Каталог, Элемент.УУИД) = Элемент.Хеш Тогда
				Совпало = Совпало + 1;
			КонецЕсли;
		КонецЦикла;
		Текст = Текст + "совпало_после_восстановления=" + Совпало + " из " + ДанныеТеста.Количество() + Символы.ПС;
		
		ПодготовитьРезультат();
		ВыполнитьВосстановлениеКлиент();
		Текст = Текст + "=== ПОВТОРНОЕ ВОССТАНОВЛЕНИЕ ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		Элемент = ДанныеТеста[0];
		Автотест_УстановитьСодержимоеНаСервере(Элемент.Каталог, Элемент.УУИД, "Изменено после архивирования");
		ПодготовитьРезультат();
		ВыполнитьВосстановлениеКлиент();
		Текст = Текст + "=== КОНФЛИКТ ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		ХешИзмененного = Автотест_ХешСодержимогоНаСервере(Элемент.Каталог, Элемент.УУИД);
		Текст = Текст + "конфликт_не_перезаписан="
			+ ?(ХешИзмененного <> "" И ХешИзмененного <> Элемент.Хеш, "ДА", "НЕТ") + Символы.ПС;
		
		Автотест_ДобавитьФайлВТомеНаСервере();
		Анализ(Неопределено);
		Текст = Текст + "=== АНАЛИЗ С ФАЙЛОМ В ТОМЕ ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		Архивировать(Неопределено);
		Текст = Текст + "=== АРХИВ 2 ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		ПодготовитьРезультат();
		ВыполнитьОчисткуКлиент();
		Текст = Текст + "=== ОЧИСТКА БЕЗ ПРОВЕРКИ (ожидается отказ) ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		Сеанс = ПервыйСеанс;
		ПутьУдаляемого = ДобавитьРазделительПутиКлиент(КаталогАрхива) + ПервыйСеанс
			+ ПолучитьРазделительПути() + "files" + ПолучитьРазделительПути()
			+ ДанныеТеста[0].УУИД + ".bin";
		УдалитьФайлы(ПутьУдаляемого);
		ПодготовитьРезультат();
		ВыполнитьОчисткуКлиент();
		Текст = Текст + "=== ОЧИСТКА ПРИ УДАЛЕННОМ ФАЙЛЕ АРХИВА (ожидается отказ) ===" + Символы.ПС + ТекстЛога + Символы.ПС;
		
		Текст = Текст + "АВТОТЕСТ ЗАВЕРШЕН" + Символы.ПС;
		
	Исключение
		Текст = Текст + "ОШИБКА АВТОТЕСТА: " + ОписаниеОшибки() + Символы.ПС;
	КонецПопытки;
	
	ЗаписатьТекстФайлаКлиент("/tmp/opencode/epf/build/smoke-result.txt", Текст);
	
КонецПроцедуры

