// ТОЛЬКО для отдельной одноразовой ИБ в песочнице без сети.
// Этот модуль не подключён к продуктовой EPF и сам по себе не запускается.
// Созданные тестовые объекты остаются в ИБ. Не использовать на рабочих базах.

#Область ИзолированныйТест

&НаСервере
Функция ТестИсторическойВерсииИОтката()
	Папка = Справочники.ПапкиФайлов.СоздатьЭлемент();
	Папка.Наименование = "isolated-rollback-" + Строка(Новый УникальныйИдентификатор());
	Папка.Записать();
	Файл = Справочники.Файлы.СоздатьЭлемент();
	Файл.ВладелецФайла = Папка.Ссылка;
	Файл.Наименование = "isolated-rollback-file";
	Файл.Расширение = "txt";
	Файл.ХранитьВерсии = Истина;
	Файл.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	Файл.Записать();
	ДанныеСтарой = ПолучитьДвоичныеДанныеИзСтроки("old version bytes");
	ДанныеТекущей = ПолучитьДвоичныеДанныеИзСтроки("current version has different bytes and length");
	Старая = ТестСоздатьВерсию(Файл.Ссылка, 1, ДанныеСтарой);
	Текущая = ТестСоздатьВерсию(Файл.Ссылка, 2, ДанныеТекущей);
	Карточка = Файл.Ссылка.ПолучитьОбъект();
	Карточка.ТекущаяВерсия = Текущая;
	Карточка.Размер = ДанныеТекущей.Размер();
	Карточка.Записать();
	ИсходнаяКарточка = ТестСнимокКарточки(Файл.Ссылка);
	ИсходнаяСтарая = ТестСнимокВерсии(Старая);
	ИсходнаяТекущая = ТестСнимокВерсии(Текущая);
	ОчередьДо = ТестКоличествоЗаписейОчереди(Старая);
	Если ИсходнаяКарточка.ТекущаяВерсия <> Текущая Тогда
		ВызватьИсключение "FAIL: текущая версия не установлена";
	КонецЕсли;
	ОжидаемоеИсключение = "INJECTED_ROLLBACK_" + Строка(Новый УникальныйИдентификатор());
	ТекстОшибки = "";
	ИзменениеКарточкиНаблюдалось = Ложь;
	НачатьТранзакцию();
	Попытка
		ОбъектСтарой = Старая.ПолучитьОбъект();
		ОбъектСтарой.ФайлХранилище = Новый ХранилищеЗначения(Неопределено);
		ОбъектСтарой.Размер = 0;
		ОбъектСтарой.Записать();
		КарточкаПослеЗаписи = Файл.Ссылка.ПолучитьОбъект();
		ИзменениеКарточкиНаблюдалось = КарточкаПослеЗаписи.Размер <> ИсходнаяКарточка.Размер;
		Если Не ИзменениеКарточкиНаблюдалось Тогда
			ВызватьИсключение "FAIL: побочная запись размера карточки не наблюдалась";
		КонецЕсли;
		ВызватьИсключение ОжидаемоеИсключение;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
	КонецПопытки;
	Если Не ИзменениеКарточкиНаблюдалось Или СтрНайти(ТекстОшибки, ОжидаемоеИсключение) = 0 Тогда
		ВызватьИсключение "FAIL: не достигнута ожидаемая точка отката: " + ТекстОшибки;
	КонецЕсли;
	ТестСравнитьСнимки(ИсходнаяКарточка, ТестСнимокКарточки(Файл.Ссылка));
	ТестСравнитьСнимки(ИсходнаяСтарая, ТестСнимокВерсии(Старая));
	ТестСравнитьСнимки(ИсходнаяТекущая, ТестСнимокВерсии(Текущая));
	ОчередьПосле = ТестКоличествоЗаписейОчереди(Старая);
	Если ОчередьДо <> ОчередьПосле Тогда
		ВызватьИсключение "FAIL: количество видимых записей очереди после отката изменилось";
	КонецЕсли;
	Возврат "PASS: наблюдалась побочная запись; проверенные реквизиты и содержимое откатились";
КонецФункции

// Сравнение только количества видимых записей не доказывает полное совпадение
// содержимого регистра или выполнение обработчика в разделённом сеансе.
&НаСервере
Функция ТестКоличествоЗаписейОчереди(ИсточникТекста)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		| РегистрСведений.ОчередьИзвлеченияТекста КАК Очередь
		|ГДЕ
		| Очередь.ИсточникТекста = &ИсточникТекста";
	Запрос.УстановитьПараметр("ИсточникТекста", ИсточникТекста);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;
КонецФункции

&НаСервере
Функция ТестСоздатьВерсию(ФайлСсылка, Номер, Данные)
	Версия = Справочники.ВерсииФайлов.СоздатьЭлемент();
	Версия.Владелец = ФайлСсылка;
	Версия.Наименование = "isolated-rollback-version";
	Версия.НомерВерсии = Номер;
	Версия.Расширение = "txt";
	Версия.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	Версия.ФайлХранилище = Новый ХранилищеЗначения(Данные);
	Версия.Размер = Данные.Размер();
	Версия.Записать();
	Возврат Версия.Ссылка;
КонецФункции

&НаСервере
Функция ТестСнимокКарточки(Ссылка)
	ОбъектДанных = Ссылка.ПолучитьОбъект();
	Возврат Новый Структура("ТекущаяВерсия,Размер,Расширение,Том,ПутьКФайлу,ТипХраненияФайла,ИндексКартинки,ДатаМодификацииУниверсальная,Изменил,ДатаСоздания",
		ОбъектДанных.ТекущаяВерсия, ОбъектДанных.Размер, ОбъектДанных.Расширение, ОбъектДанных.Том, ОбъектДанных.ПутьКФайлу,
		ОбъектДанных.ТипХраненияФайла, ОбъектДанных.ИндексКартинки, ОбъектДанных.ДатаМодификацииУниверсальная, ОбъектДанных.Изменил, ОбъектДанных.ДатаСоздания);
КонецФункции

&НаСервере
Функция ТестСнимокВерсии(Ссылка)
	ОбъектДанных = Ссылка.ПолучитьОбъект();
	Данные = ОбъектДанных.ФайлХранилище.Получить();
	Хеш = "";
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеширование.Добавить(Данные);
		Хеш = Base64Строка(Хеширование.ХешСумма);
	ИначеЕсли Данные <> Неопределено Тогда
		ВызватьИсключение "FAIL: неожиданный тип содержимого версии";
	КонецЕсли;
	Возврат Новый Структура("Владелец,Размер,Хеш", ОбъектДанных.Владелец, ОбъектДанных.Размер, Хеш);
КонецФункции

&НаСервере
Процедура ТестСравнитьСнимки(До, После)
	Для Каждого Значение Из До Цикл
		Если Значение.Значение <> После[Значение.Ключ] Тогда
			ВызватьИсключение "FAIL: после отката отличается поле " + Значение.Ключ;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
