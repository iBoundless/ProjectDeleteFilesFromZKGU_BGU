// ТЕСТОВЫЙ ФРАГМЕНТ: не включать в рабочую обработку.
// Только одноразовая изолированная ИБ: создаются тестовые объекты.
// Добавить вместе с historical_rollback.bsl в тестовую КОПИЮ модуля формы.
// В тестовой копии отключить временный запрет и внедрить исключение
// "TEST_INJECTED_AFTER_RESTORE_WRITE" после записи содержимого при восстановлении.
// Запрет в исходниках продукта должен оставаться включённым.

#Область ТестПродуктовогоВосстановления

&НаСервере
Функция ТестОткатаПродуктовогоВосстановления()
	Папка = Справочники.ПапкиФайлов.СоздатьЭлемент();
	Папка.Наименование = "isolated-restore-test-" + Строка(Новый УникальныйИдентификатор());
	Папка.Записать();
	Файл = Справочники.Файлы.СоздатьЭлемент();
	Файл.ВладелецФайла = Папка.Ссылка;
	Файл.Наименование = "isolated-restore-file";
	Файл.Расширение = "txt";
	Файл.ХранитьВерсии = Истина;
	Файл.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
	Файл.Записать();
	ДанныеСтарой = ПолучитьДвоичныеДанныеИзСтроки("old version bytes");
	ДанныеТекущей = ПолучитьДвоичныеДанныеИзСтроки("current version has different bytes and length");
	Старая = ТестСоздатьВерсию(Файл.Ссылка, 1, ДанныеСтарой);
	Текущая = ТестСоздатьВерсию(Файл.Ссылка, 2, ДанныеТекущей);
	ПустаяВерсия = Старая.ПолучитьОбъект();
	ПустаяВерсия.ФайлХранилище = Новый ХранилищеЗначения(Неопределено);
	ПустаяВерсия.Размер = 0;
	ПустаяВерсия.Записать();
	Карточка = Файл.Ссылка.ПолучитьОбъект();
	Карточка.ТекущаяВерсия = Текущая;
	Карточка.Размер = ДанныеТекущей.Размер();
	Карточка.Записать();
	КарточкаДо = ТестСнимокКарточки(Файл.Ссылка);
	СтараяДо = ТестСнимокВерсии(Старая);
	ТекущаяДо = ТестСнимокВерсии(Текущая);
	ОчередьДо = ТестКоличествоЗаписейОчереди(Старая);
	Если КарточкаДо.ТекущаяВерсия <> Текущая Или СтараяДо.Размер <> 0 Или СтараяДо.Хеш <> "" Тогда
		ВызватьИсключение "FAIL: исходное состояние теста восстановления неверно";
	КонецЕсли;
	ОчередьФайлов.Очистить();
	СтрокаТеста = ОчередьФайлов.Добавить();
	СтрокаТеста.Вид = "version";
	СтрокаТеста.Каталог = "ВерсииФайлов";
	СтрокаТеста.СсылкаУУИД = Строка(Старая.УникальныйИдентификатор());
	СтрокаТеста.ФайлУУИД = Строка(Файл.Ссылка.УникальныйИдентификатор());
	СтрокаТеста.Наименование = "isolated-restore-file";
	СтрокаТеста.НомерВерсии = "1";
	СтрокаТеста.Размер = ДанныеСтарой.Размер();
	СтрокаТеста.Хеш = ХешДанных(ДанныеСтарой);
	СтрокаТеста.ОтнПуть = "isolated-restore-test";
	Адрес = ПоместитьВоВременноеХранилище(ДанныеСтарой, Новый УникальныйИдентификатор());
	ТекстЛога = "";
	Восстановление_ВосстановитьНаСервере(0, Адрес);
	Если СтрНайти(ТекстЛога, "TEST_INJECTED_AFTER_RESTORE_WRITE") = 0 Тогда
		ВызватьИсключение "FAIL: тестовое исключение после записи не было достигнуто";
	КонецЕсли;
	ТестСравнитьСнимки(КарточкаДо, ТестСнимокКарточки(Файл.Ссылка));
	ТестСравнитьСнимки(СтараяДо, ТестСнимокВерсии(Старая));
	ТестСравнитьСнимки(ТекущаяДо, ТестСнимокВерсии(Текущая));
	Если ОчередьДо <> ТестКоличествоЗаписейОчереди(Старая) Тогда
		ВызватьИсключение "FAIL: после отката изменилось количество видимых записей очереди";
	КонецЕсли;
	Возврат "PASS: проверенные состояния не изменились после принудительной ошибки восстановления";
КонецФункции

#КонецОбласти
